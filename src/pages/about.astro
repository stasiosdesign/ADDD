---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { pageDocument, reader } from "../sanity/content";
import { aboutPage as D } from "../sanity/defaults/about";

// Every section's words come from the About page document in Sanity
// (studio/schemaTypes/pages/about.ts), each element falling back to its own
// (src/sanity/defaults/about.ts): see src/sanity/content.ts. Where every
// button and card link leads stays here. Each element names the field it
// shows (data-page-field) so the Studio's Visual editor can outline it and
// write drafts into it.
const { t, list, bg } = reader(await pageDocument(Astro.locals.sanity, "aboutPage"), D);

// The perspective cards' destinations, by position
const tiles = list<{ _key: string; title?: string; text?: string; linkLabel?: string }>("perspective.tiles");
const tileHrefs = ["workshops-audits.html", "technology-blueprint.html", "advisory.html"];
---
<BaseLayout
  title="About — ADDD"
  description="I’m Allister Lewis, an architect and technology strategist. I founded ADDD to help architecture leaders understand what is really holding their practice back—across technology, workflows, information, costs and decision-making."
  pageName="About"
  doc={{ id: "aboutPage" }}
>
<main class="page--grid">

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <h1 class="h2" data-page-field="hero.heading">{t("hero.heading")}</h1>
        </div>
        <div class="pg-hero__col">
          <p class="text-md" data-page-field="hero.lede">{t("hero.lede")}</p>
          <div class="actions actions--pair">
            <ActionButton href="contact.html"><span data-page-field="hero.primaryButton">{t("hero.primaryButton")}</span></ActionButton>
            <ActionButton href="technology-blueprint.html" variant="secondary"><span data-page-field="hero.secondaryButton">{t("hero.secondaryButton")}</span></ActionButton>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="band band--wide"></div>

  <section class="section">
    <div class="container">
      <div class="stack">
        <p class="tagline" data-page-field="foundation.tagline">{t("foundation.tagline")}</p>
        <p class="statement" data-page-field="foundation.statement">{t("foundation.statement")}</p>
        <div class="actions actions--pair">
          <ActionButton href="workshops-audits.html" variant="secondary"><span data-page-field="foundation.primaryButton">{t("foundation.primaryButton")}</span></ActionButton>
          <ActionButton href="reports.html" variant="secondary"><span data-page-field="foundation.secondaryButton">{t("foundation.secondaryButton")}</span></ActionButton>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="perspective.lede">{t("perspective.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="perspective.tagline">{t("perspective.tagline")}</p>
          <h2 class="h2" data-page-field="perspective.heading">{t("perspective.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt" data-page-list="perspective.tiles">
        {tiles.map((tile, i) => (
        <article class="tile" style="background:var(--c-white)" data-page-item={tile._key}>
          <h3 class="h4" data-page-item-field="title">{tile.title}</h3>
          <p data-page-item-field="text">{tile.text}</p>
          <a class="btn btn--link" href={tileHrefs[i] ?? "contact.html"}><span data-page-item-field="linkLabel">{tile.linkLabel}</span> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
        </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <div class="section-title__body">
          <p class="tagline" data-page-field="validation.tagline">{t("validation.tagline")}</p>
          <h2 class="h2" style="max-width:18ch" data-page-field="validation.heading">{t("validation.heading")}</h2>
        </div>
      </div>

      <div class="creds__grid">
        <div class="creds__media">
          <div class="ph" data-page-bg="validation.image1" style={bg("validation.image1")}></div>
          <div class="ph" data-page-bg="validation.image2" style={bg("validation.image2")}></div>
        </div>
        <div class="creds__text">
          <p data-page-field="validation.text">{t("validation.text")}</p>
          <div class="actions">
            <ActionButton href="reports.html" variant="secondary"><span data-page-field="validation.button">{t("validation.button")}</span></ActionButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
