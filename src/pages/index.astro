---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import ApproachStack from "../components/ApproachStack.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Hero from "../components/Hero.astro";
import InsightSlider from "../components/InsightSlider.astro";

const related = [
  { href: "report-template.html", image: "assets/images/allister-podium-full.jpg", category: "Technology", title: "The state of AI in architecture", description: "How generative tools are reshaping design practice and what firms need to know", meta: ["Report", "12 min read"] },
  { href: "report-template.html", image: "assets/images/allister-headshot-bw.png", category: "BIM", title: "BIM maturity and implementation strategy", description: "A framework for assessing where your practice stands and what comes next", meta: ["Report", "9 min read"] },
  { href: "newsletter-template.html", image: "assets/images/allister-keynote-stage.jpg", category: "Strategy", title: "Implementing AI without losing your identity", description: "How firms can adopt emerging tools while keeping their own approach and values", meta: ["Newsletter", "8 min read"] },
  { href: "report-template.html", image: "assets/images/allister-podium-portrait.jpg", category: "Workflows", title: "Software selection for architecture teams", description: "Practical guidance on evaluating tools and building your technology stack", meta: ["Report", "8 min read"] },
  { href: "newsletter-template.html", image: "assets/images/allister-gesture-warm.jpg", category: "Workflow", title: "The cost of poor software integration", description: "Why disconnected tools drain resources and how to fix it before it becomes a problem", meta: ["Newsletter", "6 min read"] },
  { href: "report-template.html", image: "assets/images/conference-keynote.jpg", category: "AI", title: "Governance and risk in AI adoption", description: "What architecture practices need to consider before implementing AI tools", meta: ["Report", "7 min read"] },
];
---
<BaseLayout
  title="ADDD — Technology strategy for architecture practices"
  description="Independent research and technology strategy for architecture practices: how technology actually gets used to make architecture, and which decisions to make first."
  pageName="Home"
  home
>
<main class="page--grid">

  <!-- ========== 1. HERO ========== -->
  <!-- In a clipping wrap, so the logos section closes over it as it
       leaves (initHeroParallax in src/scripts/site.js) -->
  <div data-hero-parallax class="hero-wrap">
    <div data-hero-parallax-inner>
      <Hero arrowHref="#approach" arrowLabel="Scroll to the ADDD approach" />
    </div>
    <div data-hero-parallax-dark class="hero-wrap__dark"></div>
  </div>

  <!-- The logo strip and the approach are one ink band, on one ground
       (.ink-band, styles.css), so where the two sections meet the page's
       white can never show between them. -->
  <div class="ink-band">

  <!-- ========== 2. LOGO STRIP ========== -->
  <section class="logos">
    <h2 class="h4 logos__title">Trusted by leading practices across the UK</h2>
    <div class="dotted-rule logos__rule" aria-hidden="true"></div>
    <div data-wavy-marquee-init class="wavy-marquee">
      <div class="wavy-marquee__collection">
        <!-- Wide single-line wordmarks alternate with compact, stacked
             marks, five of each, so no two of a kind meet — across the
             loop's seam either. -->
        <div data-wavy-marquee-list class="wavy-marquee__list">
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/ADAM-Logo.png" alt="ADAM Architecture" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/epr-architects-logo.png" alt="EPR Architects" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/studio-seilern-logo.png" alt="Studio Seilern Architects" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/Architecture-PLB-Logo.png" alt="Architecture PLB" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/Haworth-Tompkins-Logo.png" alt="Haworth Tompkins" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/ackroyd-lowrie-logo.png" alt="Ackroyd Lowrie" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/Morris-Company-Logo.png" alt="Morris + Company" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/dmwr-architects-logo.png" alt="DMWR Architects" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/Ormsss-Logo.png" alt="ORMS" draggable="false"></div></div>
          <div data-wavy-marquee-item class="wavy-marquee__item"><div class="logo-tile"><img src="assets/logos/White/SHH-logo.png" alt="SHH" draggable="false"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 3. APPROACH ========== -->
  <ApproachStack />

  </div>

  <!-- ========== 4. THE COST OF STANDING STILL ========== -->
  <!-- After the approach: why technology decisions matter. -->
  <section class="section" id="cost">
    <div class="container">
      <div class="problem-head">
        <div class="problem-head__lede">
          <p class="text-md">Tools multiply. Workflows drift. Information fragments. AI gets added without clear direction or ownership.</p>
          <p class="tagline tagline--sm">The cost of standing still</p>
        </div>
        <h2 class="problem-head__h">What actually costs you time</h2>
      </div>

      <div data-problem-grid-init class="problem-grid">

        <article class="problem-card">
          <div class="problem-card__media">
            <img src="assets/images/conference-keynote.jpg" loading="lazy" alt="" class="problem-card__image">
            <span class="problem-card__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20.5 19.5H1.5V4H7L9.5 6.5H20.5V10" stroke="currentColor" stroke-miterlimit="10"></path><path d="M1.5 19.5L4 10H23L20.5 19.5H20" stroke="currentColor" stroke-miterlimit="10"></path></svg></span>
          </div>
          <div class="problem-card__body">
            <h3 class="problem-card__h">Tools accumulate without discipline</h3>
            <p class="problem-card__p">Each year brings new software, rarely any removal</p>
          </div>
        </article>

        <article class="problem-card">
          <div class="problem-card__media">
            <img src="assets/images/allister-keynote-stage.jpg" loading="lazy" alt="" class="problem-card__image">
            <span class="problem-card__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7.5 16.5L8 13.5L18.5 3H19.5L21 4.5V5.5L10.5 16L7.5 16.5Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M16.5 4.5L19.5 7.5" stroke="currentColor" stroke-miterlimit="10"></path><path d="M16.5 15.5V21.5H2.5V7.5H8.5" stroke="currentColor"></path></svg></span>
          </div>
          <div class="problem-card__body">
            <h3 class="problem-card__h">Processes vary between projects</h3>
            <p class="problem-card__p">Teams work differently depending on the job</p>
          </div>
        </article>

        <article class="problem-card">
          <div class="problem-card__media">
            <img src="assets/images/allister-presenting.jpg" loading="lazy" alt="" class="problem-card__image">
            <span class="problem-card__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.5 2.5H14L18.5 7V21.5H5.5V2.5Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M14 2.5V7H18.5" stroke="currentColor" stroke-miterlimit="10"></path><path d="M8.5 12.5H15.5" stroke="currentColor"></path><path d="M8.5 16.5H15.5" stroke="currentColor"></path></svg></span>
          </div>
          <div class="problem-card__body">
            <h3 class="problem-card__h">Information lives in multiple places</h3>
            <p class="problem-card__p">Data gets re-entered, duplicated or lost between tools</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ========== 5. ROUTES ========== -->
  <section class="section section--dark routes">
    <div class="container">
      <div class="routes__head">
        <div class="routes__lede">
          <p class="text-md" style="max-width:21.875rem">From a focused workflow problem or early-stage design to practice-wide strategy and ongoing guidance. Choose the route that fits the issue.</p>
          <p class="tagline tagline--sm">Ways to work with ADDD</p>
        </div>
        <h2 class="routes__h">Start with what needs solving</h2>
      </div>
    </div>

    <div class="routes__grid">

        <a class="route-card" href="workshops-audits.html">
          <div class="route-card__media">
            <span class="tagline tagline--sm route-card__label">A focused issue</span>
            <span class="route-card__arrow" aria-hidden="true"><ArrowIcon /></span>
            <span class="route-card__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 6V21" stroke="currentColor"></path><path d="M9 3H2V18H9L12 21L15 18H22V3H15L12 6L9 3Z" stroke="currentColor"></path></svg></span>
          </div>
          <div class="route-card__body">
            <h3 class="route-card__h">Workflow Workshop</h3>
            <p class="route-card__p">A half-day diagnostic using a live project, to show where to start.</p>
          </div>
        </a>

        <a class="route-card" href="before-revit.html">
          <div class="route-card__media">
            <span class="tagline tagline--sm route-card__label">Early-stage design workflow</span>
            <span class="route-card__arrow" aria-hidden="true"><ArrowIcon /></span>
            <span class="route-card__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.5 2.5H14L18.5 7V21.5H5.5V2.5Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M14 2.5V7H18.5" stroke="currentColor" stroke-miterlimit="10"></path><path d="M8.5 12.5H15.5" stroke="currentColor"></path><path d="M8.5 16.5H15.5" stroke="currentColor"></path></svg></span>
          </div>
          <div class="route-card__body">
            <h3 class="route-card__h">Before Revit</h3>
            <p class="route-card__p">A review of the early stages of design, before work moves into Revit or Archicad.</p>
          </div>
        </a>

        <a class="route-card" href="technology-blueprint.html">
          <div class="route-card__media">
            <span class="tagline tagline--sm route-card__label">A practice-wide issue</span>
            <span class="route-card__arrow" aria-hidden="true"><ArrowIcon /></span>
            <span class="route-card__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.5 16.5L8 13.5L18.5 3H19.5L21 4.5V5.5L10.5 16L7.5 16.5Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M16.5 4.5L19.5 7.5" stroke="currentColor" stroke-miterlimit="10"></path><path d="M16.5 15.5V21.5H2.5V7.5H8.5" stroke="currentColor"></path></svg></span>
          </div>
          <div class="route-card__body">
            <h3 class="route-card__h">Technology Blueprint</h3>
            <p class="route-card__p">Practice-wide technology strategy, from workflows to data, security and AI.</p>
          </div>
        </a>

        <a class="route-card" href="advisory.html">
          <div class="route-card__media">
            <span class="tagline tagline--sm route-card__label">Ongoing guidance</span>
            <span class="route-card__arrow" aria-hidden="true"><ArrowIcon /></span>
            <span class="route-card__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.5 19.5H1.5V4H7L9.5 6.5H20.5V10" stroke="currentColor" stroke-miterlimit="10"></path><path d="M1.5 19.5L4 10H23L20.5 19.5H20" stroke="currentColor" stroke-miterlimit="10"></path></svg></span>
          </div>
          <div class="route-card__body">
            <h3 class="route-card__h">ADDDvisory</h3>
            <p class="route-card__p">Ongoing strategic guidance, after or alongside the main strategic work.</p>
          </div>
        </a>

    </div>
  </section>

  <!-- ========== 6. TESTIMONIALS ========== -->
  <section class="testimonials">
    <h2 class="h4 testimonials__title">Trusted by leading firms</h2>
    <div data-testimonial-wrap="" data-autoplay="true" data-autoplay-duration="6000" class="testimonial-lines">
      <div role="list" data-testimonial-list="" class="testimonial-lines__list">

        <div aria-hidden="false" data-testimonial-item="" role="listitem" class="testimonial-lines__item is--active">
          <div class="testimonial-lines__aside">
            <span class="testimonial-lines__mark" aria-hidden="true">&ldquo;</span>
            <div class="testimonial-lines__firm">
              <div data-testimonial-img="" class="testimonial-lines__logo">
                <img src="assets/logos/White/ADAM-Logo.png" alt="ADAM Architecture">
              </div>
              <div class="testimonial-lines__meta">
                <p data-testimonial-split="" class="testimonial-lines__name">Sarah Mitchell</p>
                <p data-testimonial-split="" class="tagline tagline--sm testimonial-lines__role">Operations director, ADAM Architecture</p>
              </div>
            </div>
          </div>
          <div class="testimonial-lines__body">
            <blockquote data-testimonial-text="" class="testimonial-lines__quote">We thought our problem was choosing between software platforms. It turned out we had no shared understanding of what we actually needed.</blockquote>
          </div>
        </div>

        <div aria-hidden="true" data-testimonial-item="" role="listitem" class="testimonial-lines__item">
          <div class="testimonial-lines__aside">
            <span class="testimonial-lines__mark" aria-hidden="true">&ldquo;</span>
            <div class="testimonial-lines__firm">
              <div data-testimonial-img="" class="testimonial-lines__logo">
                <img src="assets/logos/White/ADAM-Logo.png" alt="ADAM Architecture">
              </div>
              <div class="testimonial-lines__meta">
                <p data-testimonial-split="" class="testimonial-lines__name">Marcus Reid</p>
                <p data-testimonial-split="" class="tagline tagline--sm testimonial-lines__role">Technology director, ADAM Architecture</p>
              </div>
            </div>
          </div>
          <div class="testimonial-lines__body">
            <blockquote data-testimonial-text="" class="testimonial-lines__quote">ADAM Architecture had three separate software systems doing the same job. The blueprint showed us how to consolidate without losing capability, and we recovered nearly half a day per project.</blockquote>
          </div>
        </div>

        <div aria-hidden="true" data-testimonial-item="" role="listitem" class="testimonial-lines__item">
          <div class="testimonial-lines__aside">
            <span class="testimonial-lines__mark" aria-hidden="true">&ldquo;</span>
            <div class="testimonial-lines__firm">
              <div data-testimonial-img="" class="testimonial-lines__logo">
                <img src="assets/logos/White/Haworth-Tompkins-Logo.png" alt="Haworth Tompkins">
              </div>
              <div class="testimonial-lines__meta">
                <p data-testimonial-split="" class="testimonial-lines__name">Elena Foster</p>
                <p data-testimonial-split="" class="tagline tagline--sm testimonial-lines__role">Design director, Haworth Tompkins</p>
              </div>
            </div>
          </div>
          <div class="testimonial-lines__body">
            <blockquote data-testimonial-text="" class="testimonial-lines__quote">We thought we needed better software. The workshop showed us we needed better workflows.</blockquote>
          </div>
        </div>

      </div>

      <div class="testimonial-lines__controls">
        <p class="tagline tagline--sm testimonial-lines__count"><span data-current="">1</span> / <span data-total="">3</span></p>
        <div class="testimonial-lines__buttons">
          <button data-prev="" aria-label="Previous testimonial" class="testimonial-lines__button">
            <ArrowIcon class="testimonial-lines__arrow is--prev" aria-hidden="true" />
          </button>
          <button data-next="" aria-label="Next testimonial" class="testimonial-lines__button">
            <ArrowIcon class="testimonial-lines__arrow" aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 7. CREDENTIALS ========== -->
  <section class="section">
    <div class="container">
      <div class="creds__title">
        <p class="tagline tagline--plain">Credentials</p>
        <h2 class="h2">Strategy built on real architecture practice</h2>
      </div>

      <div class="creds__grid">
        <div class="creds__media">
          <div class="ph"></div>
          <div class="ph"></div>
        </div>
        <div class="creds__text">
          <p>Allister combines 25 years of architecture experience with BIM, Head of Technology and AEC software product expertise. His advice is grounded in how projects are actually delivered, how teams use tools and how vendor products perform in practice.</p>
          <div class="actions">
            <ActionButton href="about.html" variant="secondary">About Allister</ActionButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 8. FIT / COMPARISON ========== -->
  <section class="section section--light compare">
    <div class="container">
      <div class="section-title">
        <p class="text-md">ADDD is most useful when the problem is no longer isolated to one tool, one project or one team.</p>
        <div class="section-title__body">
          <p class="tagline--plain">Fit</p>
          <h2 class="h2" style="max-width:45.625rem">For practices where technology is now a leadership issue.</h2>
        </div>
      </div>

      <!-- Two sides, set against each other: who ADDD is for and who it is
           not, each a large title over a run of rows. -->
      <div class="compare__grid">
        <div class="compare__side">
          <h3 class="compare__title">Best suited to</h3>
          <ul class="compare__list">
            <li class="compare__row"><span class="compare__mark" aria-hidden="true"></span><p>Established architecture practices, usually around 25–200 people.</p></li>
            <li class="compare__row"><span class="compare__mark" aria-hidden="true"></span><p>Practices facing connected questions around workflows, software, costs, data, AI or ownership.</p></li>
            <li class="compare__row"><span class="compare__mark" aria-hidden="true"></span><p>Firms ready to act, but unclear about what should happen first.</p></li>
          </ul>
        </div>
        <div class="compare__side is--not">
          <h3 class="compare__title">Not primarily for</h3>
          <ul class="compare__list">
            <li class="compare__row"><span class="compare__mark" aria-hidden="true"></span><p>Firms seeking implementation without taking part in the strategic decisions.</p></li>
            <li class="compare__row"><span class="compare__mark" aria-hidden="true"></span><p>One-off software training, tactical BIM production support or outsourced IT management.</p></li>
            <li class="compare__row"><span class="compare__mark" aria-hidden="true"></span><p>Quick recommendations for a particular product.</p></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 9. RESEARCH, INSIGHT & NEWSLETTER ========== -->
  <section class="section">
    <div class="container">
      <div class="research__head section-title">
        <p class="text-md">The Process of Architecture: the people, process and projects behind how technology actually gets used to make architecture.</p>
        <div class="section-title__body">
          <h2 class="h2">Research and insight</h2>
        </div>
      </div>

      <InsightSlider items={related} />

      <!-- The ADDDitive signup, closing the research it comes from: the
           shared signup (styles.css), with the audience question. -->
      <div class="research__signup">
        <div class="stack stack--16">
          <p class="tagline tagline--sm">ADDDitive newsletter</p>
          <h3 class="h4">Get ADDDitive in your inbox</h3>
        </div>
        <form class="newsletter-signup" onsubmit="return false">
          <div class="newsletter-form">
            <input type="email" name="email" placeholder="Your email" aria-label="Your email" required>
            <button class="newsletter-form__submit" type="submit">Subscribe</button>
          </div>
          <fieldset class="newsletter-audience">
            <legend class="newsletter-audience__legend">Which describes you?</legend>
            <label><input type="radio" name="audience" value="practice" required> I run or work in a practice</label>
            <label><input type="radio" name="audience" value="vendor"> I sell to practices</label>
          </fieldset>
        </form>
      </div>
    </div>
  </section>

  <!-- ========== 10. CTA ========== -->
  <ClosingCta />

</main>
</BaseLayout>
