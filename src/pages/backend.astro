---
/*
  TEMPORARY (2026-11-16): how the software behind the ADDD website fits
  together, as it is set up from now on: first for a client call, then
  (2026-11-17, at the user's word) a guide for Allister to read alone. Not
  linked from anywhere and never indexed. To remove it, delete this file
  and src/presentation/.

  One scrolling page (second pass, at the user's word, after a portfolio
  they pointed to): on the left, held on screen, a tab for every section,
  all of them shown, the one being read marked; on the right the sections.
  A page of its own: none of the site's layout, nav or scripts, and only
  the site's own typeface. The words and diagrams are data
  (src/presentation/sections.ts).
*/
import { Image } from "astro:assets";
import Diagram from "../presentation/Diagram.astro";
import { GROUPS, SECTIONS } from "../presentation/sections";import "../presentation/presentation.css";
import "../styles/lenis.css";

// each section's group and its number in it, for the tab list and the
// line over its title
// numbered in reading order: parts 1, 2, 3…, sections 1.1, 3.2…
const place = new Map(GROUPS.flatMap((g, gi) => g.sections.map((id, k) => [id, { group: g, part: gi + 1, n: `${gi + 1}.${k + 1}`, first: k === 0 }] as const)));
const pad = (n: number) => String(n).padStart(2, "0");
// how much of a timeline phase comes before the first weekend it crosses (1: none crossed),
// so Allister's words stay clear of the blocked-out weekend
const beforeWeekend = (p: { from: number; to: number }) => {
  const days = SECTIONS.find((sec) => sec.timeline)?.timeline?.days ?? [];
  const first = days.findIndex((d, i) => d.weekend && i >= p.from && i <= p.to);
  return first < 0 ? 1 : (first - p.from) / (p.to - p.from + 1);
};
const byId = new Map(SECTIONS.map((s) => [s.id, s]));
// the end of each part leads on to the next one; the last part back to the start
const nextPart = (id: string) => {
  const at = place.get(id);
  if (!at || at.group.sections[at.group.sections.length - 1] !== id) return null;
  const next = GROUPS[at.part];
  return next ? { href: `#${next.sections[0]}`, n: pad(at.part + 1), title: next.tab } : { href: "#overview", n: "", title: "Back to the start" };
};

---
<!doctype html>
<html lang="en-GB" class="arch-root">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Backend guide · ADDD</title>
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://use.typekit.net" crossorigin>
  <link rel="stylesheet" href="https://use.typekit.net/lzu8hkz.css">
  <script is:inline>document.documentElement.classList.add("has--js");</script>
  <!-- Lenis, the site's smooth scroll, at the version the site pins (BaseLayout.astro) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.min.js"></script>
</head>
<body class="arch">
  <aside class="arch__side">
    <!-- with a timeline expanded the menu folds to its numbers; this opens it again -->
    <button type="button" class="arch__rail-open" data-wide-off aria-label="Show the full menu" title="Show the full menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </button>
    <a class="arch__brand" href="#overview">
      <img src="/assets/logo.svg" alt="" width="28" height="28">
      <span>ADDD</span>
    </a>
    <!-- the groups, each opening onto its numbered sections: the one being
         read open, the others closed -->
    <nav class="arch__tabs" aria-label="Sections">
      <ol class="arch__groups">
        {GROUPS.map((g, gi) => (
          <li class:list={["arch__group", { "is--open": gi === 0 }]} data-group={g.id}>
            <a href={`#${g.sections[0]}`} class:list={["arch__tab", { "is--active": gi === 0 }]} data-group-tab={g.id} aria-expanded={gi === 0 ? "true" : "false"} aria-controls={`${g.id}-list`}><span class="arch__tab-n" aria-hidden="true">{gi + 1}</span><span class="arch__tab-label">{g.tab}</span></a>
            <div class="arch__subs" id={`${g.id}-list`}>
              <ol>
                {g.sections.map((id, k) => (
                  <li><a href={`#${id}`} class:list={["arch__sub", { "is--active": gi === 0 && k === 0 }]} data-tab={id} tabindex={gi === 0 ? undefined : "-1"}><span class="arch__sub-n">{gi + 1}.{k + 1}</span>{byId.get(id)?.tab}</a></li>
                ))}
              </ol>
            </div>
          </li>
        ))}
      </ol>
    </nav>
  </aside>

  <main class="arch__main">
    {SECTIONS.map((s, i) => (
      <>
      {/* each part opens with its number and name, ruled off from the one before */}
      {i > 0 && place.get(s.id)?.first && (
        <div class="arch__part" aria-hidden="true">
          <span class="arch__part-n">{pad(place.get(s.id)!.part)}</span>
          <span class="arch__part-title">{place.get(s.id)!.group.tab}</span>
        </div>
      )}
      <section id={s.id} class:list={["arch__section", { "is--intro": i === 0, "is--first": place.get(s.id)?.first }]} data-section>
        <header class="arch__head">
          {i > 0 && place.get(s.id) && <p class="arch__crumb"><span class="arch__crumb-n">{place.get(s.id)!.n}</span>{place.get(s.id)!.group.tab}</p>}
          {i === 0 ? <h1 class="arch__title">{s.title}</h1> : <h2 class="arch__title">{s.title}</h2>}
          {s.lede && <p class="arch__lede">{s.lede}</p>}
          {s.link && <a class="arch__open" href={s.link.href} target="_blank" rel="noopener">{s.link.label}<span aria-hidden="true">↗</span></a>}
        </header>

        {s.agenda && (
          <div class="arch__agenda">
            <p class="arch__agenda-label">In this guide</p>
            <ol>
              {s.agenda.map((a) => (
                <li><a href={a.href}><span class="arch__agenda-n">{a.n}</span><span class="arch__agenda-title">{a.title}</span><span class="arch__agenda-text">{a.text}</span></a></li>
              ))}
            </ol>
          </div>
        )}

        {s.image && (
          <figure class="arch__shot">
            <Image src={s.image.src} alt={s.image.alt} widths={[960, 1400, s.image.src.width]} sizes="(min-width: 860px) min(68rem, 100vw - 23rem), 100vw" loading="lazy" />
          </figure>
        )}

        {s.tasks && (
          <ol class="arch__tasks">
            {s.tasks.map((task, k) => (
              <li>
                <details>
                  <summary><span class="arch__task-n">{pad(k + 1)}</span><span class="arch__task-title">{task.title}{task.done && <span class="arch__done">Done</span>}</span><span class="arch__task-icon" aria-hidden="true"></span></summary>
                  <div class="arch__task-body">
                    <p>{task.text}</p>
                    {task.items && <ul>{task.items.map((item) => <li>{item}</li>)}</ul>}
                    {task.image && <Image class="arch__task-img" src={task.image.src} alt={task.image.alt} widths={[640, task.image.src.width]} sizes="32rem" loading="lazy" />}
                  </div>
                </details>
              </li>
            ))}
          </ol>
        )}

        {s.compare && (
          <div class="arch__panel cmp">
            <div class="cmp__sides">
              <figure class="cmp__side">
                <figcaption class="cmp__label"><img src="https://www.google.com/s2/favicons?domain=beehiiv.com&sz=64" alt="" width="18" height="18" />In beehiiv</figcaption>
                <div class="cmp__shot">
                  <Image src={s.compare.image} alt={s.compare.alt} widths={[600, 822]} sizes="(min-width: 860px) 32rem, 100vw" loading="lazy" />
                  {s.compare.parts.map((p) => <span class="cmp__n" style={`top:${p.at}%`}>{p.n}</span>)}
                </div>
              </figure>
              <span class="cmp__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
              </span>
              <figure class="cmp__side">
                <figcaption class="cmp__label"><img src="/assets/logo.svg" alt="" width="18" height="18" />On the website</figcaption>
                <!-- the same issue on the site's newsletter page, drawn: its
                     parts numbered as the screenshot's -->
                <div class="cmp__site" aria-hidden="true">
                  <div class="cmp__nav"><img src="/assets/logo.svg" alt="" width="14" height="14" /><span></span><i>Contact</i></div>
                  <div class="cmp__body">
                    <p class="cmp__row"><span class="cmp__n">1</span><span class="cmp__h1">Title</span></p>
                    <p class="cmp__row"><span class="cmp__n">2</span><span class="cmp__lede">Discovering the tools, workflows, and decisions shaping modern architectural practice</span></p>
                    <p class="cmp__meta"><span>17 November 2026</span><span>6 min read</span></p>
                    <p class="cmp__row"><span class="cmp__n">3</span><span class="cmp__img" style={`background-image:url("${s.compare.image.src}")`}></span></p>
                    <div class="cmp__row cmp__cols">
                      <span class="cmp__n">4</span>
                      <span class="cmp__h2">Opening Insight — <em>Why This Matters This Week</em></span>
                      <span class="cmp__text"><span class="cmp__n is--inline">5</span>Architects aren’t short on tools. They’re short on confidence about which decisions actually matter.<i></i><i></i><i class="is--short"></i></span>
                    </div>
                  </div>
                </div>
              </figure>
            </div>
            <ol class="cmp__map">
              {s.compare.parts.map((p) => (
                <li><span class="cmp__n">{p.n}</span><span class="cmp__from">{p.beehiiv}</span><span class="cmp__to" aria-hidden="true">→</span><span>{p.site}</span></li>
              ))}
            </ol>
            {s.compare.link && <a class="cmp__link" href={s.compare.link.href} target="_blank" rel="noopener">{s.compare.link.label}<span aria-hidden="true"> ↗</span></a>}
          </div>
        )}

        {s.timeline && (
          <div class="arch__panel tl-panel" data-tl-panel title="Click to make the timeline bigger">
            <button type="button" class="tl__expand" data-wide-toggle><span class="is--grow">Expand</span><span class="is--shrink">Shrink</span></button>
            <div class="tl" style={`--days:${s.timeline.days.length};--phases:${s.timeline.phases.length}`}>
              {s.timeline.days.map((d, k) => (
                <>
                {/* each day a block of its own down the whole chart, so a bar plainly ends on a day; a weekend's hatched out */}
                <span class:list={["tl__cell", { "is--weekend": d.weekend, "is--today": d.today }]} style={`grid-column:${k + 1}`} aria-hidden="true"></span>
                <div class:list={["tl__day", { "is--today": d.today, "is--weekend": d.weekend }]} style={`grid-column:${k + 1}`}>
                  <span class="tl__day-name">{d.today ? "Today" : d.day}</span>
                  <span class="tl__date">{d.date}</span>
                </div>
                </>
              ))}
              {s.timeline.phases.map((p, k) => (
                <>
                  <div class:list={["tl__phase", `is--${p.who}`]} style={`grid-column:${p.from + 1} / ${p.to + 2};grid-row:${k + 2};--before-weekend:${beforeWeekend(p)}`}>
                    <p class="tl__title">
                      {p.who === "allister" && <img class="tl__face" src="/assets/images/allister-headshot-bw-crop.webp" alt="Allister" width="28" height="28" />}
                      {p.title}
                    </p>
                    {p.items.length > 0 && <ul class="tl__items">
                      {p.items.map((item) => <li>{item}</li>)}
                    </ul>}
                  </div>
                </>
              ))}
            </div>
          </div>
        )}

        {s.diagram && (
          <div class="arch__panel">
            <Diagram id={s.id} diagram={s.diagram} />
          </div>
        )}

        {s.lists && (
          <div class="arch__lists">
            {s.lists.map((l) => (
              <div class="arch__list">
                <p class="arch__list-title">{l.title}</p>
                <ul class="arch__notes">
                  {l.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        )}

        {s.notes && (
          <div class="arch__tip">
            <p class="arch__tip-label">Good to know</p>
            <ul class="arch__notes">
              {s.notes.map((note) => <li>{note}</li>)}
            </ul>
          </div>
        )}

        {nextPart(s.id) && (
          <a class="arch__next" href={nextPart(s.id)!.href}>
            <span class="arch__next-label">{nextPart(s.id)!.n ? "Next" : "Finished"}</span>
            <span class="arch__next-title">{nextPart(s.id)!.n && <span class="arch__next-n">{nextPart(s.id)!.n}</span>}{nextPart(s.id)!.title}</span>
            <span class="arch__next-arrow" aria-hidden="true">{nextPart(s.id)!.n ? "↓" : "↑"}</span>
          </a>
        )}
      </section>
      </>
    ))}
  </main>

  <script>
    // smooth scrolling, as the site's (scroll.js: its lerp and wheel), and
    // the tabs gliding to their section with it; without Lenis (or with
    // reduced motion) the browser's own scroll and jumps
    const Smooth = (window as unknown as { Lenis?: new (o: object) => { scrollTo: (t: Element, o?: object) => void } }).Lenis;
    const lenis = Smooth && !matchMedia("(prefers-reduced-motion: reduce)").matches
      ? new Smooth({ lerp: 0.08, wheelMultiplier: 1, autoRaf: true })
      : null;
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => a.addEventListener("click", (e) => {
      const target = document.querySelector(a.getAttribute("href")!);
      if (!target || !lenis) return;
      e.preventDefault();
      lenis.scrollTo(target, { duration: 1.2 });
      history.replaceState(null, "", a.getAttribute("href"));
    }));

    // a timeline made bigger (2026-11-17): the menu folds to its numbers and
    // the page takes the width; its button, the menu's, or Esc undo it
    const body = document.body;
    const wide = (on: boolean) => body.classList.toggle("is--wide", on);
    document.querySelectorAll<HTMLElement>("[data-tl-panel]").forEach((panel) => panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-wide-toggle]")) return;
      if (!body.classList.contains("is--wide")) wide(true);
    }));
    document.querySelectorAll("[data-wide-toggle]").forEach((b) => b.addEventListener("click", () => wide(!body.classList.contains("is--wide"))));
    document.querySelectorAll("[data-wide-off]").forEach((b) => b.addEventListener("click", () => wide(false)));
    addEventListener("keydown", (e) => { if (e.key === "Escape") wide(false); });

    // the tab of the section being read, marked as the page scrolls; a
    // section's words and diagram coming in once, gently, as it arrives
    const tabs = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-tab]")].map((a) => [a.dataset.tab!, a]));
    const sections = [...document.querySelectorAll<HTMLElement>("[data-section]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const mark = (id: string) => {
      tabs.forEach((a, key) => {
        const on = key === id;
        a.classList.toggle("is--active", on);
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
      // its group open and marked, the others closed
      groups.forEach((g) => {
        const open = !!g.querySelector(`[data-tab="${id}"]`);
        g.classList.toggle("is--open", open);
        const tab = g.querySelector<HTMLElement>("[data-group-tab]")!;
        tab.classList.toggle("is--active", open);
        tab.setAttribute("aria-expanded", String(open));
        g.querySelectorAll<HTMLElement>("[data-tab]").forEach((a) => (open ? a.removeAttribute("tabindex") : a.setAttribute("tabindex", "-1")));
      });
    };
    const reading = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && mark(e.target.id)),
      { rootMargin: "-45% 0px -50% 0px" },
    );
    const arriving = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add("is--in");
        arriving.unobserve(e.target);
      }),
      { rootMargin: "0px 0px -12% 0px" },
    );
    sections.forEach((s) => { reading.observe(s); arriving.observe(s); });
    // the last section may never reach the middle of the screen
    addEventListener("scroll", () => {
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) mark(sections[sections.length - 1].id);
    }, { passive: true });
  </script>
</body>
</html>
