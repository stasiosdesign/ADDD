---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import { pageDocument, reader } from "../sanity/content";
import { contactPage as D } from "../sanity/defaults/contact";

// The words on the page come from the Contact page document in Sanity
// (studio/schemaTypes/pages/contact.ts), each element falling back to its
// own (src/sanity/defaults/contact.ts): see src/sanity/content.ts. The
// form's fields, options and labels, and where the email and phone links
// lead, stay here. Each element names the field it shows (data-page-field)
// so the Studio's Visual editor can outline it and write drafts into it.
//
// Two columns (styles: pages.css, "Contact"): on the left, Allister's pass,
// a flat ID card in its holder hung from an ADDD lanyard that runs up off
// the page, with the logo, his photograph, his name, his role and how to
// reach him; on the right, the enquiry form alone. Stacked below 992px, the
// pass first.
const { t } = reader(await pageDocument(Astro.locals.sanity, "contactPage"), D);
---
<BaseLayout
  title="Contact — ADDD"
  description="Send your enquiry to ADDD. Tell us what you need."
  pageName="Contact"
  theme="dark"
  doc={{ id: "contactPage" }}
>
<main class="page--dark page--grid page--contact">

  <section class="contact">
    <div class="container">
      <div class="contact__grid">

        <div class="contact__pass">
          <!-- the pass, face on: the lanyard running up off the page, its
               clasp, the holder with its slot, and the card in it -->
          <div class="pass">
            <div class="pass__strap" aria-hidden="true"></div>
            <div class="pass__clasp" aria-hidden="true"></div>
            <div class="pass__holder">
              <span class="pass__slot" aria-hidden="true"></span>
              <div class="pass__card">
                <div class="pass__head">
                  <img class="pass__logo" src="/assets/logo.svg" width="40" height="40" alt="ADDD">
                  <span class="pass__meta">addd.io</span>
                </div>
                <img class="pass__photo" src="/assets/images/allister-headshot-bw-crop.webp" width="560" height="700" alt="Allister Lewis" loading="eager" decoding="async">
                <span class="pass__chip">Founder</span>
                <p class="pass__name">Allister Lewis</p>
                <p class="pass__role">Architect &amp; technology strategist</p>
                <dl class="pass__rows">
                  <div><dt>T</dt><dd><a href="tel:+442071833675" data-page-field="hero.phone">{t("hero.phone")}</a></dd></div>
                  <div><dt>E</dt><dd><a href="mailto:allister@addd.io" data-page-field="hero.email">{t("hero.email")}</a></dd></div>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="contact__form">
          <h1 class="visually-hidden" data-page-field="hero.heading">{t("hero.heading")}</h1>
          <form class="form contact-form" onsubmit="return false" data-enquiry-offer>
            <div class="form__row">
              <div class="field"><label for="fn">First name</label><input id="fn" name="first-name" type="text" autocomplete="given-name"></div>
              <div class="field"><label for="ln">Last name</label><input id="ln" name="last-name" type="text" autocomplete="family-name"></div>
            </div>
            <div class="field"><label for="em">Email address</label><input id="em" name="email" type="email" autocomplete="email"></div>

            <div class="field">
              <label for="topic">What&rsquo;s your enquiry about?</label>
              <select id="topic" name="topic">
                <option>Select an option</option>
                <option>Workflow Workshop</option>
                <option>Before Revit</option>
                <option>Technology Blueprint</option>
                <option>Ongoing Advisory</option>
                <option>AEC Tech Partners</option>
                <option>Reports and research</option>
                <option>Something else</option>
              </select>
            </div>

            <div class="field">
              <label for="msg">Message</label>
              <textarea id="msg" name="message" placeholder="Tell us more about your enquiry"></textarea>
            </div>

            <label class="checkbox"><input type="checkbox" name="consent"> I agree to be contacted about my enquiry</label>

            <ActionButton type="submit" style="align-self:flex-start"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
          </form>
        </div>

      </div>
    </div>
  </section>

</main>
</BaseLayout>
