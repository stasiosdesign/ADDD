---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import BookCallDialog from "../components/BookCallDialog.astro";
import { pageDocument, reader } from "../sanity/content";
import { contactPage as D } from "../sanity/defaults/contact";

// The words on the page come from the Contact page document in Sanity
// (studio/schemaTypes/pages/contact.ts), each element falling back to its
// own (src/sanity/defaults/contact.ts): see src/sanity/content.ts. The
// form's fields, options and labels, and where the email and phone links
// lead, stay here. Each element names the field it shows (data-page-field)
// so the Studio's Visual editor can outline it and write drafts into it.
//
// Two columns on white (styles: pages.css, "Contact"), two ways to reach
// ADDD: on the left, a free call with Allister, booked from his pass hung
// on a lanyard that runs up off the page (after the studio pass of the
// references of 2026-11-04: a black holder, the printed card in it with
// the ADDD mark large and slightly raised, his photograph beside his name
// and role, the Book a Free Call button, and his email and telephone as
// links), turning slightly towards the pointer and holding still under it
// (lanyard.js); on the right, the enquiry form. Stacked below 992px, the
// pass first. The button opens the free call's calendar
// (BookCallDialog.astro), set outside the pass so the lanyard's movement
// never carries it.
const { t } = reader(await pageDocument(Astro.locals.sanity, "contactPage"), D);
// the year printed on the pass
const year = new Date().getFullYear();
---
<BaseLayout
  title="Contact — ADDD"
  description="Send your enquiry to ADDD. Tell us what you need."
  pageName="Contact"
  doc={{ id: "contactPage" }}
>
<main class="page--grid page--contact">

  <section class="contact">
    <div class="container">
      <div class="contact__grid">

        <div class="contact__pass">
          <!-- Allister's pass on its lanyard, in markup (pages.css, "The
               lanyard"), as tall as the form beside it: the strap running up
               off the page, the hardware, the holder, and the printed card in
               it, with the Book a Free Call button and his email and
               telephone as links. It hangs at rest; with a fine pointer it
               swings and turns a little towards it, and holds still while
               the pointer is on the card (lanyard.js). -->
          <div class="lanyard" data-lanyard>
            <div class="lanyard__rig" data-lanyard-rig>
              <span class="lanyard__strap" aria-hidden="true"></span>
              <!-- the hardware, after the reference: the strap's sewn end, a
                   ring, a swivel and a lobster clasp, its claw through the
                   slot in the holder's tab -->
              <svg class="lanyard__hook" viewBox="0 0 120 196" aria-hidden="true" focusable="false">
                <rect x="0" y="0" width="120" height="36" rx="3" />
                <circle class="lanyard__ring" cx="60" cy="58" r="20" />
                <circle cx="60" cy="86" r="8.5" />
                <rect x="55" y="90" width="10" height="24" rx="2" />
                <path d="M46 112h28l-4 44a10 10 0 0 1-20 0z" />
                <path class="lanyard__claw" d="M53 152c-14 10-11 37 8 38c17 1 24-17 15-27" />
              </svg>
              <div class="lanyard__card" data-lanyard-card>
                <span class="lanyard__tab" aria-hidden="true"><span class="lanyard__slot"></span></span>
                <div class="lanyard__face">
                  <p class="lanyard__top"><span>ADDD Pass</span><span>{year}</span></p>
                  <span class="lanyard__logo"><img src="/assets/logo.svg" width="100" height="100" alt="ADDD"></span>
                  <div class="lanyard__person">
                    <img class="lanyard__photo" src="/assets/images/allister-headshot-bw-crop.webp" width="96" height="96" alt="" decoding="async" draggable="false">
                    <div>
                      <p class="lanyard__name">Allister Lewis</p>
                      <p class="lanyard__role">Architect &amp; technology strategist</p>
                    </div>
                  </div>
                  <div class="lanyard__book">
                    <ActionButton type="button" data-booking-open="book-call" aria-haspopup="dialog" aria-controls="book-call">Book a Free Call</ActionButton>
                  </div>
                  <p class="lanyard__foot">
                    <a href="mailto:allister@addd.io" data-page-field="hero.email">{t("hero.email")}</a>
                    <a href="tel:+442071833675" data-page-field="hero.phone">{t("hero.phone")}</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="contact__form">
          <h1 class="visually-hidden" data-page-field="hero.heading">{t("hero.heading")}</h1>
          <form class="form contact-form" onsubmit="return false" data-enquiry-offer>
            <div class="form__row">
              <div class="field"><label for="fn">First name</label><input id="fn" name="first-name" type="text" autocomplete="given-name"></div>
              <div class="field"><label for="ln">Last name</label><input id="ln" name="last-name" type="text" autocomplete="family-name"></div>
            </div>
            <div class="field"><label for="em">Email address</label><input id="em" name="email" type="email" autocomplete="email"></div>

            <div class="field">
              <label for="topic">What&rsquo;s your enquiry about?</label>
              <select id="topic" name="topic">
                <option>Select an option</option>
                <option>Workflow Workshop</option>
                <option>Before Revit</option>
                <option>Technology Blueprint</option>
                <option>Ongoing Advisory</option>
                <option>AEC Tech Partners</option>
                <option>Reports and research</option>
                <option>Something else</option>
              </select>
            </div>

            <div class="field">
              <label for="msg">Message</label>
              <textarea id="msg" name="message" placeholder="Tell us more about your enquiry"></textarea>
            </div>

            <label class="checkbox"><input type="checkbox" name="consent"> I agree to be contacted about my enquiry</label>

            <ActionButton type="submit" style="align-self:flex-start"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
          </form>
        </div>

      </div>
    </div>
  </section>

  <BookCallDialog id="book-call" />

</main>
</BaseLayout>
