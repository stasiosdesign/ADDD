---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import { pageDocument, reader } from "../sanity/content";
import { contactPage as D } from "../sanity/defaults/contact";

// The words beside the form come from the Contact page document in Sanity
// (studio/schemaTypes/pages/contact.ts), each element falling back to its
// own (src/sanity/defaults/contact.ts): see src/sanity/content.ts. The
// form's fields, options and labels, and where the email and phone links
// lead, stay here. Each element names the field it shows (data-page-field)
// so the Studio's Visual editor can outline it and write drafts into it.
const { t } = reader(await pageDocument(Astro.locals.sanity, "contactPage"), D);
---
<BaseLayout
  title="Contact — ADDD"
  description="Send your enquiry to ADDD. Tell us what you need."
  pageName="Contact"
  doc={{ id: "contactPage" }}
>
<main class="page--dark page--grid">

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline" data-page-field="hero.tagline">{t("hero.tagline")}</p>
          <h1 class="h2" data-page-field="hero.heading">{t("hero.heading")}</h1>
          <p class="text-md" data-page-field="hero.lede">{t("hero.lede")}</p>
          <ul class="contact-list">
            <li><a href="mailto:allister@addd.io" data-page-field="hero.email">{t("hero.email")}</a></li>
            <li><a href="tel:+15550000000" data-page-field="hero.phone">{t("hero.phone")}</a></li>
            <li data-page-field="hero.address">{t("hero.address")}</li>
          </ul>
        </div>

        <div class="pg-hero__col">
          <form class="form" style="width:100%" onsubmit="return false">
            <div class="form__row">
              <div class="field"><label for="fn">First name</label><input id="fn" type="text" autocomplete="given-name"></div>
              <div class="field"><label for="ln">Last name</label><input id="ln" type="text" autocomplete="family-name"></div>
            </div>
            <div class="form__row">
              <div class="field"><label for="em">Email address</label><input id="em" type="email" autocomplete="email"></div>
              <div class="field"><label for="ph">Phone number</label><input id="ph" type="tel" autocomplete="tel"></div>
            </div>

            <div class="field">
              <label for="topic">What&rsquo;s your enquiry about?</label>
              <select id="topic">
                <option>Select an option</option>
                <option>Workflow Workshop</option>
                <option>Before Revit</option>
                <option>Technology Blueprint</option>
                <option>ADDDvisory</option>
                <option>Sponsorship and partnerships</option>
                <option>Reports and research</option>
                <option>Something else</option>
              </select>
            </div>

            <div class="field" role="radiogroup" aria-labelledby="role-label">
              <span id="role-label">Your role</span>
              <div class="radio-grid">
                <label><input type="radio" name="role"> Director or partner</label>
                <label><input type="radio" name="role"> Technology lead</label>
                <label><input type="radio" name="role"> Practice manager</label>
                <label><input type="radio" name="role"> Operations or strategy</label>
                <label><input type="radio" name="role"> Senior architect</label>
                <label><input type="radio" name="role"> Other</label>
              </div>
            </div>

            <div class="field">
              <label for="msg">Message</label>
              <textarea id="msg" placeholder="Tell us more about your enquiry"></textarea>
            </div>

            <label class="checkbox"><input type="checkbox"> I agree to be contacted about my enquiry</label>

            <ActionButton type="submit" style="align-self:flex-start"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
          </form>
        </div>
      </div>
    </div>
  </section>

</main>
</BaseLayout>
