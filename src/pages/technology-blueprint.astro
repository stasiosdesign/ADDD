---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqPanel from "../components/FaqPanel.astro";
import FaqSection from "../components/FaqSection.astro";
import ActionButton from "../components/ActionButton.astro";
import BlueprintHero from "../components/BlueprintHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Testimonials from "../components/Testimonials.astro";
import ApproachStack from "../components/ApproachStack.astro";
import StageTimeline, { type Stage } from "../components/StageTimeline.astro";
import BookCallFloat from "../components/BookCallFloat.astro";
import LayersDiagram from "../components/LayersDiagram.astro";
import PracticesWall from "../components/PracticesWall.astro";
import { pageDocument, reader } from "../sanity/content";
import { blueprintPage as D } from "../sanity/defaults/blueprint";
import NavLinkLabel from "../components/NavLinkLabel.astro";

// Every section's words come from the Technology Blueprint page document in
// Sanity (studio/schemaTypes/pages/blueprint.ts), each element falling back
// to its own (src/sanity/defaults/blueprint.ts): see src/sanity/content.ts.
// The navigation, the footer, the filter buttons, the enquiry form's inputs
// and where every button and link leads stay here. Each element names the
// field it shows (data-page-field) so the Studio's Visual editor can
// outline it and write drafts into it.
const { t, list } = reader(await pageDocument(Astro.locals.sanity, "blueprintPage"), D);

const benefits = list<{ _key: string; number?: string; tagline?: string; title?: string; text?: string; image?: unknown }>("benefits.tiles");
const steps = list<{ _key: string; label?: string; title?: string; text?: string }>("delivery.steps");
// The roadmap: the eight weeks across the top, and each stage's weeks
// (start, from 0, and how many, after its label) and photograph, the
// page's own; its more from delivery.details, in the steps' order
const WEEKS = Array.from({ length: 8 }, (_, i) => `Week ${i + 1}`);
const SPANS = [{ start: 0, span: 1 }, { start: 1, span: 3 }, { start: 4, span: 3 }, { start: 7, span: 1 }];
const ROADMAP_PHOTOS = [
  "/assets/images/allister-gesture-warm-crop.webp",
  "/assets/images/team-model-review.webp",
  "/assets/images/allister-podium-portrait-crop.webp",
  "/assets/images/allister-keynote-stage-crop.webp",
];
const details = list<{ _key: string; more?: string }>("delivery.details");
const roadmap: Stage[] = steps.map((step, i) => ({
  when: step.label,
  title: step.title,
  text: step.text,
  more: details[i]?.more,
  image: ROADMAP_PHOTOS[i] ? { src: ROADMAP_PHOTOS[i], alt: "" } : undefined,
  ...SPANS[i],
  fields: {
    when: `delivery.steps.${i}.label`,
    title: `delivery.steps.${i}.title`,
    text: `delivery.steps.${i}.text`,
    more: `delivery.details.${i}.more`,
  },
}));
const faq = list<{ _key: string; question?: string; answer?: string }>("faq.questions");
const tabs = list<{ _key: string; label?: string; title?: string; text?: string }>("examine.tabs");

// each tab's icon (2026-11-04), from the SVG Collection (source-assets/
// svg-collection: activity, browser, cloud, lock-closed, zap, wallet,
// flag-square, and layout for a tab it does not know), by the first word
// of the tab's label; drawn in the tab's ink (currentColor)
const ICONS: Record<string, string> = {
  workflows: '<path d="M1.5 12H5.5L9.5 3L14.5 21L18.5 12H22.5"/>',
  software: '<path d="M2 9V20H22V7H13.5L11 9H2Z"/><path d="M2 9V4H22V7"/><path d="M4.5 6V7"/><path d="M7 6V7"/><path d="M9.5 6V7"/>',
  infrastructure: '<path d="M18.6 18C19.7498 18.0003 20.8541 17.5505 21.6764 16.7468C22.4988 15.9432 22.9739 14.8495 23 13.7C23 12.5331 22.5364 11.4139 21.7113 10.5887C20.8861 9.76358 19.767 9.30001 18.6 9.30001H18.1C17.648 8.04348 16.8201 6.95665 15.7286 6.18728C14.6372 5.41792 13.3353 5.00337 12 5.00001C10.6747 4.99456 9.38148 5.4072 8.30426 6.17921C7.22704 6.95121 6.42072 8.04327 6 9.30001H5.4C4.23305 9.30001 3.11389 9.76358 2.28873 10.5887C1.46357 11.4139 1 12.5331 1 13.7C1.02613 14.8495 1.50121 15.9432 2.32356 16.7468C3.1459 17.5505 4.25017 18.0003 5.4 18H18.6Z"/>',
  data: '<path d="M20.5 10.5H3.5V21.5H20.5V10.5Z"/><path d="M12 14.5V17"/><path d="M18 10.5V8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8V10.5"/>',
  ai: '<path d="M13 3L4 14H12L11 21L20 10H12L13 3Z"/>',
  costs: '<path d="M21 7H3V21H21V7Z"/><path d="M21 11H17C16.2044 11 15.4413 11.3161 14.8787 11.8787C14.3161 12.4413 14 13.2044 14 14C14 14.7956 14.3161 15.5587 14.8787 16.1213C15.4413 16.6839 16.2044 17 17 17H21"/><path d="M17 14H18"/><path d="M5 7L13 3L15 7"/><path d="M14 5L17 4L18 7"/>',
  governance: '<path d="M6 21V4H20V14H6"/>',
  other: '<path d="M22 4H2V21H22V4Z"/><path d="M8 9V21"/><path d="M2 9H22"/>',
};
const iconOf = (label = "") => ICONS[label.toLowerCase().split(/[^a-z]+/).find(Boolean) ?? ""] ?? ICONS.other;
const pad = (n: number) => String(n).padStart(2, "0");
---
<BaseLayout
  title="Technology Blueprint — ADDD"
  description="The Technology Blueprint is a full practice-wide technology strategy for architecture practices, covering the technology ecosystem, workflows, software, infrastructure, data, security, AI and priorities."
  pageName="Technology Blueprint"
  doc={{ id: "blueprintPage" }}
>
<main class="page--grid">

  <!-- The opening (BlueprintHero.astro, 2026-11-04, after the reference):
       the network of the practices' systems in the upper right on the
       Blueprint's dash-dot lattice, fading out towards the words in the
       lower left (the buttons, the standfirst, then the heading at the
       foot); the network held in place while the words scroll away and the
       statement comes up after them, then going on up with it. "Start a
       Blueprint" opens the free call's calendar, as every booking button
       on the service pages does since 2026-11-05 (the FAQ's Book a Free
       Call renders it: BookCallDialog.astro); the second button goes down
       to the roadmap.
       In a clipping wrap, as the homepage's hero is (2026-11-04), so the
       band of the practices closes over it as it leaves, the hero falling
       back a little into shadow under it (initHeroParallax); from the
       moment its hold lets go (data-hero-parallax-start: its foot at the
       screen's), so the network stays exactly still while it is held. -->
  <div class="hero-wrap" data-hero-parallax data-hero-parallax-start="bottom bottom" data-hero-parallax-screen>
  <div data-hero-parallax-inner>
  <BlueprintHero heading={t("hero.heading")} lede={t("hero.lede")} statement={t("hero.statement")}>
    <Fragment slot="actions">
      <ActionButton type="button" data-booking-open="book-call" aria-haspopup="dialog" aria-controls="book-call"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
      <ActionButton href="#delivery" variant="secondary" arrow="down"><span data-page-field="hero.linkLabel">{t("hero.linkLabel")}</span></ActionButton>
    </Fragment>
  </BlueprintHero>
  </div>
  <div data-hero-parallax-dark class="hero-wrap__dark"></div>
  </div>


  <!-- The three benefits as the homepage's "How we work" (ApproachStack.astro)
       in its light version: the cards zig-zag either side of the rail
       on a field of ink dots, each with a live drawing (the hub settling
       into one picture for coherence, the towers of impact for direction,
       the layers opened for waste) -->
  <!-- Practices We've Worked With: the homepage's wall of clients' marks
       (PracticesWall.astro), in its light version, between the statement
       and the benefits. The two share one band of dots (data-dot-band), as
       the homepage's wall and approach share its ink band: the benefits'
       field sets the pitch and the lattice (approach-stack.js), and the
       wall is placed on it exactly as the homepage's is. Its entrance is
       the homepage's too (2026-11-04): the band's top edge in pieces, two
       Grid Columns each, rising over the hero at their own rates as it
       comes up (initBandSteps, parallax.js), here in the band's white with
       its dots in ink. -->
  <div class="dot-band band-steps-host" data-dot-band>
  <div class="band-steps" data-band-steps aria-hidden="true">
    {Array.from({ length: 6 }, (_, i) => <span class="band-steps__seg" style={`--i:${i}`}><span class="band-steps__dots dot-grid band-field"></span></span>)}
  </div>
  <PracticesWall />

  <ApproachStack
    light
    label="Why a technology blueprint"
    heading={t("benefits.heading")}
    headingField="benefits.heading"
    note={t("benefits.note")}
    noteField="benefits.note"
    field="benefits.tiles"
    steps={benefits.map((tile) => ({ title: tile.title ?? "", text: tile.text ?? "" }))}
    schematics={["map", "rank", "trace"]}
  />
  </div>

  <!-- What we look at (2026-11-04, second pass, after the user's reference
       of a menu beside a dark panel): on black, the heading centred over
       one panel in two halves. On the left the tabs as a column of rows on
       a light ground, each its number, its name large and its icon in a
       ring at the right, parted by hairlines; the open row the panel's
       dark, its name stepped in. On the right the dark panel of the open
       tab: its heading and words at the top, its icon in a ring in the
       corner, the layers drawing, and at the foot under a hairline its
       number large, with the section's name and the page's in small type.
       The tabs and their words are the Studio's (examine.tabs; tabs.js). -->
  <section class="section examine-sec" aria-labelledby="examine-heading">
    <div class="container">
      <h2 class="h2 examine-sec__heading" id="examine-heading" data-split="heading" data-page-field="examine.heading">{t("examine.heading")}</h2>
      <div class="examine" data-tabs>
        <div class="examine__list" role="tablist" aria-orientation="vertical" aria-label={t("examine.heading")} data-page-list="examine.tabs">
          {tabs.map((tab, i) => (
          <button type="button" role="tab" class="examine__tab" id={`examine-tab-${i + 1}`} aria-controls={`examine-panel-${i + 1}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? undefined : "-1"} data-filter-status={i === 0 ? "active" : undefined} data-page-item={tab._key}>
            <span class="examine__tab-n" aria-hidden="true">{i + 1}</span>
            <span class="examine__tab-label" data-page-item-field="label">{tab.label}</span>
            <span class="examine__ring" aria-hidden="true"><svg class="examine__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-miterlimit="10" set:html={iconOf(tab.label)}></svg></span>
          </button>
          ))}
        </div>
        <div class="examine__stage">
          <div class="examine__media" aria-hidden="true">
            <LayersDiagram class="examine__diagram" />
          </div>
          {tabs.map((tab, i) => (
          <div class:list={["examine__panel", { "is--active": i === 0 }]} role="tabpanel" id={`examine-panel-${i + 1}`} aria-labelledby={`examine-tab-${i + 1}`}>
            <div class="examine__top">
              <h3 class="examine__title" data-page-field={`examine.tabs.${i}.title`}>{tab.title}</h3>
              <span class="examine__ring is--corner" aria-hidden="true"><svg class="examine__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-miterlimit="10" set:html={iconOf(tab.label)}></svg></span>
            </div>
            <p class="examine__p" data-page-field={`examine.tabs.${i}.text`}>{tab.text}</p>
            <div class="examine__foot">
              <p class="examine__big" aria-hidden="true">{pad(i + 1)}<span>/{pad(tabs.length)}</span></p>
              <p class="examine__small"><span>* {t("examine.heading")}</span><span>Technology Blueprint</span></p>
            </div>
          </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- From current reality to a clear roadmap: the four stages on the
       shared timeline (StageTimeline.astro), a plan's chart: the eight
       weeks across the top, each stage a row with its box over its weeks,
       opening its card -->
  <section class="section roadmap is--dark" id="delivery">
    <div class="container">
      <div class="roadmap__head">
        <div>
          <p class="tagline" data-page-field="delivery.tagline">{t("delivery.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="delivery.heading">{t("delivery.heading")}</h2>
        </div>
        <ActionButton href="/contact" variant="secondary"><span data-page-field="delivery.button">{t("delivery.button")}</span></ActionButton>
      </div>
      <div class="roadmap__run">
        <StageTimeline id="blueprint-stages" stages={roadmap} scale={WEEKS} dark />
      </div>
    </div>
  </section>

  <!-- the homepage's testimonials, the same block (Testimonials.astro):
       its quotes are the Home page's -->
  <Testimonials />

  <section class="section">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline" data-page-field="enquiry.tagline">{t("enquiry.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="enquiry.heading">{t("enquiry.heading")}</h2>
          <p class="text-md" data-page-field="enquiry.lede">{t("enquiry.lede")}</p>
          <ul class="contact-list">
            <li><a class="nav-link" href="mailto:hello@addd.studio"><NavLinkLabel data-page-field="enquiry.email">{t("enquiry.email")}</NavLinkLabel></a></li>
            <li><a class="nav-link" href="tel:+442071833675"><NavLinkLabel data-page-field="enquiry.phone">{t("enquiry.phone")}</NavLinkLabel></a></li>
            <li data-page-field="enquiry.address">{t("enquiry.address")}</li>
          </ul>
        </div>
        <div class="pg-hero__col">
          <form class="form" style="width:100%" onsubmit="return false">
            <div class="field"><label for="bp-name">Name</label><input id="bp-name" type="text" autocomplete="name"></div>
            <div class="field"><label for="bp-email">Email</label><input id="bp-email" type="email" autocomplete="email"></div>
            <div class="field"><label for="bp-msg">Message</label><textarea id="bp-msg" placeholder="Tell us about your practice"></textarea></div>
            <label class="checkbox"><input type="checkbox"> I agree to the privacy policy</label>
            <ActionButton type="submit" style="align-self:flex-start"><span data-page-field="enquiry.button">{t("enquiry.button")}</span></ActionButton>
          </form>
        </div>
      </div>
    </div>
  </section>

  <FaqSection>
      <!-- the site's FAQ panel (FaqPanel.astro), each
       question with its icon, and Book a Free Call as its last item -->
      <FaqPanel id="faq" heading={t("faq.heading")} headingField="faq.heading" items={faq} field="faq.questions"
        icons={["user","clock","folder","settings","compass"]} call />
  </FaqSection>

  <ClosingCta />
  <!-- Book a Call, floating at the screen's foot from past the hero to Book a
       Free Call (BookCallFloat.astro) -->
  <BookCallFloat />

</main>
</BaseLayout>
