---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accordion from "../components/Accordion.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";

const faq = [
  { question: "Who should be involved from our side?", answer: "A sponsor at partner or director level, plus whoever owns BIM, IT and operations. Project leads join for the interview stage." },
  { question: "How much time does it take from our team?", answer: "Roughly six to ten hours per participant across the eight weeks, mostly in the discovery stage." },
  { question: "What do we actually receive?", answer: "A written blueprint with findings, a cost picture, prioritised recommendations and a sequenced two to three-year roadmap." },
  { question: "Do you implement the roadmap?", answer: "The blueprint is strategy, not delivery. Ongoing support continues through Advisory." },
  { question: "Should we start with a workshop instead?", answer: "If the problem is isolated to one workflow or project, start with a workshop. If it spans the practice, start here." },
];
---
<BaseLayout
  title="Technology Blueprint — ADDD"
  description="A technology blueprint is how established architecture practices move from scattered tools and unclear spending to a sequenced roadmap that works."
  pageName="Technology Blueprint"
>
<main>

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline">Technology Blueprint</p>
          <h1 class="h1">Eight weeks to a working strategy</h1>
        </div>
        <div class="pg-hero__col">
          <p class="text-md">A technology blueprint is how established architecture practices move from scattered tools and unclear spending to a sequenced roadmap that works. We examine your workflows, software, infrastructure, costs, data, roles and AI readiness, then hand you back a strategy you can actually act on. One practice cut their software spend by 40% and reclaimed two days a week. That&rsquo;s what happens when you see what you actually have.</p>
          <div class="actions">
            <ActionButton href="contact.html">Contact</ActionButton>
            <a class="btn btn--link" href="#delivery">Learn more <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="band band--wide"></div>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        <article class="stack stack--16">
          <p class="tagline tagline--sm">01</p>
          <div class="ph" style="aspect-ratio:4/3"></div>
          <p class="tagline tagline--sm">Coherence</p>
          <h2 class="h4">One reliable view of the practice</h2>
          <p>Most practices operate in silos, with each department making technology choices independently. A blueprint connects those choices into one coherent picture, so you understand how decisions in one area affect everything else.</p>
        </article>
        <article class="stack stack--16">
          <p class="tagline tagline--sm">02</p>
          <div class="ph" style="aspect-ratio:4/3"></div>
          <p class="tagline tagline--sm">Direction</p>
          <h2 class="h4">Stop reacting to every problem</h2>
          <p>Without strategy, you buy software when pressure builds and hope it fits with what you already have. A blueprint lets you choose tools that serve your actual direction instead of chasing problems as they emerge.</p>
        </article>
        <article class="stack stack--16">
          <p class="tagline tagline--sm">03</p>
          <div class="ph" style="aspect-ratio:4/3"></div>
          <p class="tagline tagline--sm">Efficiency</p>
          <h2 class="h4">Eliminate waste and reclaim capacity</h2>
          <p>Overlapping tools, parallel workflows and unclear ownership drain money and time without anyone tracking it. A blueprint finds that waste and shows you exactly what to change to recover both.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <p class="text-md">A technology blueprint examines your practice as one connected system. We don&rsquo;t isolate workflows from software, or software costs from infrastructure&mdash;everything connects.</p>
        <div class="section-title__body">
          <p class="tagline">Examine</p>
          <h2 class="h2">What we look at</h2>
        </div>
      </div>

      <div class="filters">
        <button type="button" data-filter-status="active">Workflows</button>
        <button type="button">Software</button>
        <button type="button">Infrastructure</button>
        <button type="button">AI capability</button>
        <button type="button">Costs</button>
        <button type="button">Governance</button>
      </div>

      <div class="card" style="margin-top:3rem">
        <div class="card__body card__body--lg">
          <div class="card__text">
            <p class="tagline tagline--sm">Workflows</p>
            <h3 class="h3">How work moves through your practice</h3>
            <p>We trace real project delivery from brief through to completion, finding where tools connect and where teams improvise around gaps. This reveals which workflows are intentional and which are fragile.</p>
          </div>
        </div>
        <div class="card__media"></div>
      </div>
    </div>
  </section>

  <section class="section" id="delivery">
    <div class="container">
      <div class="stack">
        <p class="tagline">Delivery</p>
        <h2 class="h2" style="max-width:16ch">From current reality to a clear roadmap</h2>
        <div class="actions">
          <ActionButton href="contact.html" variant="secondary">Explore</ActionButton>
          <a class="btn btn--link" href="about.html">Learn <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
        </div>
      </div>

      <div class="steps">
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Week 1</p>
          <div class="steps__body">
            <h3 class="h4">Mobilisation</h3>
            <p>We align on scope, timeline and who participates from your practice.</p>
          </div>
        </div>
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Weeks 2&ndash;4</p>
          <div class="steps__body">
            <h3 class="h4">Discovery and analysis</h3>
            <p>Interviews map your workflows. Inventory captures every tool and cost. Gap analysis reveals where systems fail.</p>
          </div>
        </div>
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Weeks 5&ndash;7</p>
          <div class="steps__body">
            <h3 class="h4">Strategy and planning</h3>
            <p>Recommendations emerge from findings. Cost analysis shows where money goes. Priorities sequence what matters most.</p>
          </div>
        </div>
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Week 8</p>
          <div class="steps__body">
            <h3 class="h4">Finalisation and handover</h3>
            <p>You receive the blueprint, present it to your leadership, then move into implementation with clear next steps.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="case__panel" style="margin-top:0">
        <div class="case__quote-wrap">
          <div class="case__quote-inner">
            <blockquote class="quote">&ldquo;ADAM Architecture had three separate software systems doing the same job. The blueprint showed us how to consolidate without losing capability, and we recovered nearly half a day per project.&rdquo;</blockquote>
            <div class="avatar">
              <div class="avatar__img"></div>
              <div>
                <p class="avatar__name">Marcus Reid</p>
                <p>Technology director, ADAM Architecture</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline">Investment</p>
          <h2 class="h2">Start here</h2>
          <p class="text-md">Eight weeks, tailored to your practice&rsquo;s scale and complexity.</p>
          <ul class="contact-list">
            <li><a href="mailto:hello@addd.studio">hello@addd.studio</a></li>
            <li><a href="tel:+442071833675">+44 (0) 207 183 3675</a></li>
            <li>London, United Kingdom</li>
          </ul>
        </div>
        <div class="pg-hero__col">
          <form class="form" style="width:100%" onsubmit="return false">
            <div class="field"><label for="bp-name">Name</label><input id="bp-name" type="text" autocomplete="name"></div>
            <div class="field"><label for="bp-email">Email</label><input id="bp-email" type="email" autocomplete="email"></div>
            <div class="field"><label for="bp-msg">Message</label><textarea id="bp-msg" placeholder="Tell us about your practice"></textarea></div>
            <label class="checkbox"><input type="checkbox"> I agree to the privacy policy</label>
            <ActionButton type="submit" style="align-self:flex-start">Send</ActionButton>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2 class="h2">Answers</h2>
      <Accordion id="faq" items={faq} />
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
