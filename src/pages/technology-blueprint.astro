---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accordion from "../components/Accordion.astro";
import ActionButton from "../components/ActionButton.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import LayersDiagram from "../components/LayersDiagram.astro";
import { pageDocument, reader } from "../sanity/content";
import { blueprintPage as D } from "../sanity/defaults/blueprint";
import NavLinkLabel from "../components/NavLinkLabel.astro";

// Every section's words come from the Technology Blueprint page document in
// Sanity (studio/schemaTypes/pages/blueprint.ts), each element falling back
// to its own (src/sanity/defaults/blueprint.ts): see src/sanity/content.ts.
// The navigation, the footer, the filter buttons, the enquiry form's inputs
// and where every button and link leads stay here. Each element names the
// field it shows (data-page-field) so the Studio's Visual editor can
// outline it and write drafts into it.
const { t, list, bg } = reader(await pageDocument(Astro.locals.sanity, "blueprintPage"), D);

const benefits = list<{ _key: string; number?: string; tagline?: string; title?: string; text?: string; image?: unknown }>("benefits.tiles");
const steps = list<{ _key: string; label?: string; title?: string; text?: string }>("delivery.steps");
const faq = list<{ _key: string; question?: string; answer?: string }>("faq.questions");
---
<BaseLayout
  title="Technology Blueprint — ADDD"
  description="The Technology Blueprint is a full practice-wide technology strategy for architecture practices, covering the technology ecosystem, workflows, software, infrastructure, data, security, AI and priorities."
  pageName="Technology Blueprint"
  doc={{ id: "blueprintPage" }}
>
<main class="page--grid">

  <!-- The deck's card for this service at the screen's size
       (ServiceHero.astro): the homepage's card opens into it. -->
  <ServiceHero index={2} name={t("hero.tagline")} heading={t("hero.heading")} lede={t("hero.lede")}>
    <Fragment slot="actions">
      <ActionButton href="contact.html"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
      <a class="btn btn--link nav-link" href="#delivery"><NavLinkLabel data-page-field="hero.linkLabel">{t("hero.linkLabel")}</NavLinkLabel> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
    </Fragment>
  </ServiceHero>
  <div class="band band--wide" id="overview"></div>

  <section class="section">
    <div class="container">
      <div class="grid grid--3" data-page-list="benefits.tiles">
        {benefits.map((tile, i) => {
          const picture = bg(`benefits.tiles.${i}.image`);
          return (
        <article class="stack stack--16" data-page-item={tile._key}>
          <p class="tagline tagline--sm" data-page-item-field="number">{tile.number}</p>
          <div class="ph" style={picture ? `aspect-ratio:4/3;${picture}` : "aspect-ratio:4/3"} data-page-item-field="image" data-page-item-bg></div>
          <p class="tagline tagline--sm" data-page-item-field="tagline">{tile.tagline}</p>
          <h2 class="h4" data-page-item-field="title">{tile.title}</h2>
          <p data-page-item-field="text">{tile.text}</p>
        </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="examine.lede">{t("examine.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="examine.tagline">{t("examine.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="examine.heading">{t("examine.heading")}</h2>
        </div>
      </div>

      <div class="filters filters--tabs">
        <button type="button" data-filter-status="active">Workflows</button>
        <button type="button">Software</button>
        <button type="button">Infrastructure</button>
        <button type="button">Data &amp; security</button>
        <button type="button">AI capability</button>
        <button type="button">Costs</button>
        <button type="button">Governance</button>
      </div>

      <div class="examine-panel">
        <div class="examine-panel__text">
          <h3 class="examine-panel__h" data-page-field="examine.cardHeading">{t("examine.cardHeading")}</h3>
          <div class="examine-panel__row">
            <p class="examine-panel__label"><span class="examine-panel__mark" aria-hidden="true"></span><span data-page-field="examine.cardTagline">{t("examine.cardTagline")}</span></p>
            <p class="examine-panel__p" data-page-field="examine.cardText">{t("examine.cardText")}</p>
          </div>
        </div>
        <div class="examine-panel__media">
          <LayersDiagram class="examine-panel__diagram" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="delivery">
    <div class="container">
      <div class="stack">
        <p class="tagline" data-page-field="delivery.tagline">{t("delivery.tagline")}</p>
        <h2 class="h2" data-split="heading" style="max-width:16ch" data-page-field="delivery.heading">{t("delivery.heading")}</h2>
        <div class="actions">
          <ActionButton href="contact.html" variant="secondary"><span data-page-field="delivery.button">{t("delivery.button")}</span></ActionButton>
          <a class="btn btn--link nav-link" href="about.html"><NavLinkLabel data-page-field="delivery.linkLabel">{t("delivery.linkLabel")}</NavLinkLabel> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
        </div>
      </div>

      <div class="steps" data-page-list="delivery.steps">
        {steps.map((step) => (
        <div class="steps__item" data-page-item={step._key}>
          <p class="tagline tagline--sm steps__label" data-page-item-field="label">{step.label}</p>
          <div class="steps__body">
            <h3 class="h4" data-page-item-field="title">{step.title}</h3>
            <p data-page-item-field="text">{step.text}</p>
          </div>
        </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="case__panel" style="margin-top:0">
        <div class="case__quote-wrap">
          <div class="case__quote-inner">
            <blockquote class="quote" data-page-field="quote.quote">&ldquo;{t("quote.quote")}&rdquo;</blockquote>
            <div class="avatar">
              <div class="avatar__img"></div>
              <div>
                <p class="avatar__name" data-page-field="quote.name">{t("quote.name")}</p>
                <p data-page-field="quote.role">{t("quote.role")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline" data-page-field="enquiry.tagline">{t("enquiry.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="enquiry.heading">{t("enquiry.heading")}</h2>
          <p class="text-md" data-page-field="enquiry.lede">{t("enquiry.lede")}</p>
          <ul class="contact-list">
            <li><a class="nav-link" href="mailto:hello@addd.studio"><NavLinkLabel data-page-field="enquiry.email">{t("enquiry.email")}</NavLinkLabel></a></li>
            <li><a class="nav-link" href="tel:+442071833675"><NavLinkLabel data-page-field="enquiry.phone">{t("enquiry.phone")}</NavLinkLabel></a></li>
            <li data-page-field="enquiry.address">{t("enquiry.address")}</li>
          </ul>
        </div>
        <div class="pg-hero__col">
          <form class="form" style="width:100%" onsubmit="return false">
            <div class="field"><label for="bp-name">Name</label><input id="bp-name" type="text" autocomplete="name"></div>
            <div class="field"><label for="bp-email">Email</label><input id="bp-email" type="email" autocomplete="email"></div>
            <div class="field"><label for="bp-msg">Message</label><textarea id="bp-msg" placeholder="Tell us about your practice"></textarea></div>
            <label class="checkbox"><input type="checkbox"> I agree to the privacy policy</label>
            <ActionButton type="submit" style="align-self:flex-start"><span data-page-field="enquiry.button">{t("enquiry.button")}</span></ActionButton>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2 class="h2" data-split="heading" data-page-field="faq.heading">{t("faq.heading")}</h2>
      <Accordion id="faq" items={faq} field="faq.questions" />
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
