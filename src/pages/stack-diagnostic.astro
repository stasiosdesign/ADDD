---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import { pageDocument, reader } from "../sanity/content";
import { TECH_STACKS_QUERY } from "../sanity/queries";
import { stackDiagnosticPage as D } from "../sanity/defaults/stack-diagnostic";
import { APP_SIGN_UP, CATEGORIES, SAMPLE_STACKS, TOOLS, stackOf, type StackDocument } from "../data/stack-ecosystem";

// Free Tech Stacks, as one screen (2026-11-04, third pass, after the
// user's brief): one continuous row of cards in 3D, every card a piece of
// software, the row running across the screen from off its bottom-left
// corner to off its top-right and going round as it is scrolled through.
// The software in each curated stack stands together in the row, at the
// row's own spacing, in a tone of the stack's own, with a dotted bracket
// beside it and the stack's name at its near end; the stack's tools held
// back until the visitor is in the ADDD app are cards with a lock and no
// name. Any card of a stack chooses the stack: its cards open out and lift
// together, and the stack's sheet opens over the page (its title, the tools
// its preview names, each in a container of its own, the rest locked, and
// the way into the app, which enforces the access: the site never has a
// stack's full list). The software in no stack follows the stacks.
//
// The stacks are the Studio's (studio/schemaTypes/documents/tech-stack.ts).
// Until any are published, labelled samples (src/data/stack-ecosystem.ts)
// stand in on staging and in development; production then shows the
// software alone, and says the stacks are on their way, never a sample.
//
// Drawn on one canvas by src/scripts/stack-space.js; the sheet is
// src/scripts/stack-sheet.js (styles: stack-space.css). The page does not
// scroll and has no footer. The nav is its light version (the ground a
// step darker than the nav's greys, so the bar stands clear of it). The
// words come from the Stack Diagnostic page document in Sanity
// (studio/schemaTypes/pages/stack-diagnostic.ts), falling back to
// src/sanity/defaults/stack-diagnostic.ts.
const { sanity } = Astro.locals;
const [doc, stackDocs] = await Promise.all([
  pageDocument(sanity, "stackDiagnosticPage"),
  sanity.fetch<StackDocument[]>(TECH_STACKS_QUERY),
]);
const { t } = reader(doc, D);

const published = (stackDocs ?? []).map(stackOf).filter((s) => s.name);
const stacks = published.length ? published : __DEPLOYMENT__ === "production" ? [] : SAMPLE_STACKS;
const samples = !published.length && stacks.length > 0;

// a tool as the row and the sheet show it: its name, its home category
// (its role in a workflow), the inventory's line for it, its mark
const categoryName = Object.fromEntries(CATEGORIES.map((c) => [c.id, c.name]));
const toolByName = new Map(TOOLS.map((tool) => [tool.name.toLowerCase(), tool]));
const shown = (name: string) => {
  const tool = toolByName.get(name.toLowerCase());
  const home = tool?.categories[0];
  return { name: tool?.name ?? name, category: home ? categoryName[home] : "", note: tool && home ? tool.notes[home] ?? "" : "", logo: tool?.logo ?? null };
};
const data = {
  stacks: stacks.map((s) => ({ ...s, preview: s.preview.map(shown) })),
  tools: TOOLS.map((tool) => shown(tool.name)),
  signUp: APP_SIGN_UP,
};
// the stacks' tones in the row, alternating (stack-space.js, TONES)
const tones = ["is--tone-a", "is--tone-b"];
---
<BaseLayout
  title="Stack Diagnostic — ADDD"
  description="A short, focused assessment of the technology your practice actually runs—what each tool is for, who depends on it, and where two tools do the same job."
  pageName="Stack Diagnostic"
  doc={{ id: "stackDiagnosticPage" }}
  footer={false}
>
<main class="page--grid sd" data-stack-space>

  <!-- the stage: one canvas, the whole row (stack-space.js); it takes the
       wheel, the keys and a swipe, and Lenis leaves it alone -->
  <div class="sd__stage" data-stack-stage data-lenis-prevent tabindex="0" role="application" aria-roledescription="row of software cards" aria-label="Software, in curated stacks. Use the arrow keys to move through the cards and Enter to open a card's stack.">
    <canvas class="sd__canvas" aria-hidden="true"></canvas>
  </div>

  <header class="sd__head">
    <h1 class="sd__title" data-page-field="hero.heading">{t("hero.heading")}</h1>
    <p class="sd__legend" data-page-field="hero.legend">{t("hero.legend")}</p>
  </header>

  <!-- the list on the right: the stacks, each with its tone in the row (a
       stack chosen opens as a card of it does), then the Software Database -->
  <nav class="sd__index" aria-label="Tech stacks">
    <p class="sd__filter-group">{samples ? "Sample stacks" : "Stacks"}</p>
    {stacks.map((s, i) => (
      <button type="button" class="sd__filter" data-stack-go={i} aria-haspopup="dialog"><span class:list={["sd__swatch", tones[i % tones.length]]} aria-hidden="true"></span>{s.name}<sup>{s.toolCount}</sup></button>
    ))}
    {samples && <p class="sd__sample-note">Samples show how a stack will look, until the first are published. They are not recommendations.</p>}
    {stacks.length === 0 && <p class="sd__sample-note">The first curated stacks are being put together.</p>}
    <a class="sd__switch" href="https://app.addd.io/" target="_blank" rel="noopener">Software Database &#8599;</a>
  </nav>

  <!-- the page's one call: the Free Stack, in the screen's bottom-right corner -->
  <div class="sd__cta">
    <ActionButton href={APP_SIGN_UP} target="_blank" rel="noopener"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
  </div>

  <!-- a stack's sheet (stack-sheet.js): its containers are written into the
       column as it opens -->
  <dialog class="sd-sheet" data-stack-sheet aria-labelledby="sd-sheet-title" data-lenis-prevent>
    <div class="sd-sheet__scrim" data-sheet-close aria-hidden="true"></div>
    <div class="sd-sheet__frame">
      <button type="button" class="sd-sheet__close" data-sheet-close aria-label="Close the stack">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
      </button>
      <div class="sd-sheet__scroll" data-sheet-scroll tabindex="-1">
        <div class="sd-sheet__column" data-sheet-column></div>
      </div>
    </div>
    <template data-sheet-cta><ActionButton href={APP_SIGN_UP} target="_blank" rel="noopener">Unlock the full stack</ActionButton></template>
    <!-- the SVG Collection's lock (source-assets/svg-collection, no. 026) -->
    <template data-sheet-lock><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M12.75 15.75H5.25C4.42125 15.75 3.75 15.0787 3.75 14.25V9C3.75 8.17125 4.42125 7.5 5.25 7.5H12.75C13.5788 7.5 14.25 8.17125 14.25 9V14.25C14.25 15.0787 13.5788 15.75 12.75 15.75Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 7.5V5.25C6 3.59325 7.34325 2.25 9 2.25C10.6567 2.25 12 3.59325 12 5.25V7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></template>
  </dialog>

  <p class="visually-hidden" aria-live="polite" data-stack-live></p>
  <script is:inline type="application/json" data-stack-data set:html={JSON.stringify(data)}></script>
</main>
</BaseLayout>
