---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";
import StackCard from "../components/StackCard.astro";
import type { Props as StackCardData } from "../components/StackCard.astro";
import { pageDocument, reader } from "../sanity/content";
import { stackDiagnosticPage as D } from "../sanity/defaults/stack-diagnostic";
import NavLinkLabel from "../components/NavLinkLabel.astro";

// Every section's words come from the Stack Diagnostic page document in
// Sanity (studio/schemaTypes/pages/stack-diagnostic.ts), each element falling
// back to its own (src/sanity/defaults/stack-diagnostic.ts): see
// src/sanity/content.ts. The navigation, the footer, the chevron icons and
// where every button and link leads stay here. Each element names the field
// it shows (data-page-field) so the Studio's Visual editor can outline it and
// write drafts into it; each list names its blocks (data-page-list,
// data-page-item).
const { t, list } = reader(await pageDocument(Astro.locals.sanity, "stackDiagnosticPage"), D);

type Tile = { _key: string; title?: string; text?: string; linkLabel?: string };
const fitTiles = list<Tile>("fit.tiles");
const alternatives = list<Tile>("fit.alternatives");
const steps = list<{ _key: string; label?: string; title?: string; text?: string }>("method.steps");
const nextTiles = list<Tile>("next.tiles");

// Where the outlined cards' and the closing cards' links lead, by position
const alternativeHrefs = ["workshops-audits.html", "technology-blueprint.html"];
const nextHrefs = ["workshops-audits.html", "technology-blueprint.html", "advisory.html"];

// The hero's card wall (StackCard.astro, stack-cards.css), three across,
// one card per entry, in order, left to right and row by row. Each card:
//   title  its name
//   text   a line or two describing it
//   image  its small square picture, a path under public/ (e.g.
//          /assets/logos/…); left out, a blank square holds its place
//   href   where the whole card leads; left out, the card is not a link
//          yet; another site's address opens in a new tab
// Placeholders until the real cards are supplied.
const cards: StackCardData[] = [
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
  { title: "Card title", text: "A short description of what this card leads to, on one or two lines." },
];
---
<BaseLayout
  title="Stack Diagnostic — ADDD"
  description="A short, focused assessment of the technology your practice actually runs—what each tool is for, who depends on it, and where two tools do the same job."
  pageName="Stack Diagnostic"
  doc={{ id: "stackDiagnosticPage" }}
>
<main class="page--grid">

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline" data-page-field="hero.tagline">{t("hero.tagline")}</p>
          <h1 class="h1" data-split="heading" data-page-field="hero.heading">{t("hero.heading")}</h1>
        </div>
        <div class="pg-hero__col">
          <p class="text-md" data-page-field="hero.lede">{t("hero.lede")}</p>
          <div class="actions">
            <ActionButton href="https://app.addd.io/sign-up" target="_blank" rel="noopener"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
            <a class="btn btn--link nav-link" href="#how-it-works"><NavLinkLabel data-page-field="hero.linkLabel">{t("hero.linkLabel")}</NavLinkLabel> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- The card wall, in the hero's band's place: its first rows in the
       first screen, the rest rising into place as they come up it
       (initStackCards, site.js). -->
  <ul class="stack-cards" role="list" data-stack-cards>
    {cards.map((card) => (
      <li><StackCard {...card} /></li>
    ))}
  </ul>

  <section class="section" id="who-its-for">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="fit.lede">{t("fit.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="fit.tagline">{t("fit.tagline")}</p>
          <h2 class="h2" data-split="heading" style="max-width:16ch" data-page-field="fit.heading">{t("fit.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt" data-page-list="fit.tiles">
        {fitTiles.map((item) => (
        <article class="tile" data-page-item={item._key}>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
        </article>
        ))}
      </div>

      <div class="grid grid--2" style="margin-top:2rem" data-page-list="fit.alternatives">
        {alternatives.map((item, i) => (
        <article class="tile tile--outline" data-page-item={item._key}>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
          <a class="btn btn--link nav-link" href={alternativeHrefs[i] ?? "contact.html"}><NavLinkLabel data-page-item-field="linkLabel">{item.linkLabel}</NavLinkLabel> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
        </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light" id="how-it-works">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="method.lede">{t("method.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="method.tagline">{t("method.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="method.heading">{t("method.heading")}</h2>
        </div>
      </div>

      <div class="steps" data-page-list="method.steps">
        {steps.map((step) => (
        <div class="steps__item" data-page-item={step._key}>
          <p class="tagline tagline--sm steps__label" data-page-item-field="label">{step.label}</p>
          <div class="steps__body">
            <h3 class="h4" data-page-item-field="title">{step.title}</h3>
            <p data-page-item-field="text">{step.text}</p>
          </div>
        </div>
        ))}
      </div>

      <div class="actions" style="margin-top:3rem">
        <ActionButton href="contact.html"><span data-page-field="method.button">{t("method.button")}</span></ActionButton>
        <a class="btn btn--link nav-link" href="technology-blueprint.html"><NavLinkLabel data-page-field="method.linkLabel">{t("method.linkLabel")}</NavLinkLabel> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="next.lede">{t("next.lede")}</p>
        <div class="section-title__body">
          <h2 class="h2" data-split="heading" data-page-field="next.heading">{t("next.heading")}</h2>
        </div>
      </div>
      <div class="grid grid--3 grid--mt" data-page-list="next.tiles">
        {nextTiles.map((item, i) => (
        <article class="tile" data-page-item={item._key}>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
          <a class="btn btn--link nav-link" href={nextHrefs[i] ?? "contact.html"}><NavLinkLabel data-page-item-field="linkLabel">{item.linkLabel}</NavLinkLabel> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
        </article>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
