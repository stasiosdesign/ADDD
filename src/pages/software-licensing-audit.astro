---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { pageDocument, reader } from "../sanity/content";
import { licensingAuditPage as D } from "../sanity/defaults/licensing-audit";

// Every section's words come from the Software & Licensing Audit page
// document in Sanity (studio/schemaTypes/pages/licensing-audit.ts), each
// element falling back to its own (src/sanity/defaults/licensing-audit.ts):
// see src/sanity/content.ts. The navigation, the footer, the chevron icons
// and where every button and link leads stay here. Each element names the
// field it shows (data-page-field) so the Studio's Visual editor can outline
// it and write drafts into it; each list names its blocks (data-page-list,
// data-page-item).
const { t, list } = reader(await pageDocument(Astro.locals.sanity, "licensingAuditPage"), D);

type Tile = { _key: string; title?: string; text?: string; linkLabel?: string };
const fitTiles = list<Tile>("fit.tiles");
const alternatives = list<Tile>("fit.alternatives");
const steps = list<{ _key: string; label?: string; title?: string; text?: string }>("method.steps");
const nextTiles = list<Tile>("next.tiles");

// Where the outlined cards' and the closing cards' links lead, by position
const alternativeHrefs = ["stack-diagnostic.html", "technology-blueprint.html"];
const nextHrefs = ["technology-blueprint.html", "workshops-audits.html", "advisory.html"];
---
<BaseLayout
  title="Software & Licensing Audit — ADDD"
  description="Software cost and licensing review, assessed by ADDD as part of the wider technology strategy and the Technology Blueprint: every seat, renewal date and overlapping subscription set against real usage."
  pageName="Software & Licensing Audit"
  doc={{ id: "licensingAuditPage" }}
>
<main class="page--grid">

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline" data-page-field="hero.tagline">{t("hero.tagline")}</p>
          <h1 class="h1" data-page-field="hero.heading">{t("hero.heading")}</h1>
        </div>
        <div class="pg-hero__col">
          <p class="text-md" data-page-field="hero.lede">{t("hero.lede")}</p>
          <div class="actions">
            <ActionButton href="technology-blueprint.html"><span data-page-field="hero.button">{t("hero.button")}</span></ActionButton>
            <a class="btn btn--link" href="#how-it-works"><span data-page-field="hero.linkLabel">{t("hero.linkLabel")}</span> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="band band--wide"></div>

  <section class="section" id="who-its-for">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="fit.lede">{t("fit.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="fit.tagline">{t("fit.tagline")}</p>
          <h2 class="h2" style="max-width:16ch" data-page-field="fit.heading">{t("fit.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt" data-page-list="fit.tiles">
        {fitTiles.map((item) => (
        <article class="tile" data-page-item={item._key}>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
        </article>
        ))}
      </div>

      <div class="grid grid--2" style="margin-top:2rem" data-page-list="fit.alternatives">
        {alternatives.map((item, i) => (
        <article class="tile tile--outline" data-page-item={item._key}>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
          <a class="btn btn--link" href={alternativeHrefs[i] ?? "contact.html"}><span data-page-item-field="linkLabel">{item.linkLabel}</span> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
        </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light" id="how-it-works">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="method.lede">{t("method.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="method.tagline">{t("method.tagline")}</p>
          <h2 class="h2" data-page-field="method.heading">{t("method.heading")}</h2>
        </div>
      </div>

      <div class="steps" data-page-list="method.steps">
        {steps.map((step) => (
        <div class="steps__item" data-page-item={step._key}>
          <p class="tagline tagline--sm steps__label" data-page-item-field="label">{step.label}</p>
          <div class="steps__body">
            <h3 class="h4" data-page-item-field="title">{step.title}</h3>
            <p data-page-item-field="text">{step.text}</p>
          </div>
        </div>
        ))}
      </div>

      <div class="actions" style="margin-top:3rem">
        <ActionButton href="contact.html"><span data-page-field="method.button">{t("method.button")}</span></ActionButton>
        <a class="btn btn--link" href="reports.html"><span data-page-field="method.linkLabel">{t("method.linkLabel")}</span> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="next.lede">{t("next.lede")}</p>
        <div class="section-title__body">
          <h2 class="h2" data-page-field="next.heading">{t("next.heading")}</h2>
        </div>
      </div>
      <div class="grid grid--3 grid--mt" data-page-list="next.tiles">
        {nextTiles.map((item, i) => (
        <article class="tile" data-page-item={item._key}>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
          <a class="btn btn--link" href={nextHrefs[i] ?? "contact.html"}><span data-page-item-field="linkLabel">{item.linkLabel}</span> <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
        </article>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
