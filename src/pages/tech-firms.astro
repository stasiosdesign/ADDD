---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Hero from "../components/Hero.astro";

// The routes into ADDD's audience, one pinned card each (initApproachSlides,
// site.js). The last is left unpinned and closed over by the shutter.
const opportunities = [
  { title: "Content sponsorship", text: "Sponsor workflow content and episodes that show how technology actually gets used to make architecture, across people, process and projects.", tone: "is--ink", image: "assets/images/allister-podium-portrait.jpg", crop: "is--crop-left" },
  { title: "Newsletter placement", text: "A placement in ADDDitive, the ADDD newsletter for people who run and work in architecture practices.", tone: "is--dark", image: "assets/images/allister-gesture-close.jpg", crop: "is--crop-centre" },
  { title: "Intelligence and research", text: "ADDD research into how architecture practices choose, adopt and use software across their workflows.", tone: "is--ink", image: "assets/images/allister-keynote-stage.jpg", crop: "is--crop-centre" },
  { title: "Events and content", text: "Relevant events and content opportunities that put your product in front of the architecture audience. Nobody pays for recommendations or rankings.", tone: "is--grey", image: "assets/images/allister-gesture-warm.jpg", crop: "is--crop-right" },
];

const fees = { href: "mailto:allister@addd.io?subject=Partnership%20fee%20sheet", label: "Request the Fee Sheet" };
---
<BaseLayout
  title="For AEC Tech Firms — ADDD"
  description="Sponsorship and partnerships that give technology companies access to ADDD’s architecture audience: workflow and episode content, ADDDitive newsletter placement, research and events."
  pageName="Tech Firms"
>
<main class="page--grid">

  <!-- The homepage hero for the AEC technology market: the same Slash
       Field, with the AEC Tech Firms blue as its accent, on the left of
       the viewport and the copy beside it (Hero.astro, "split"). Its
       buttons are the partnership routes, never the practice ones. -->
  <Hero
    arrowHref="#tech-firms-content"
    arrowLabel="Scroll to the partnership opportunities"
    layout="split"
    accent="blue"
    tagline="For AEC tech firms"
    heading="Reach architecture practices through ADDD"
    lede="Sponsorship and partnerships that give technology companies access to ADDD’s architecture audience, through its content, the ADDDitive newsletter, research and events."
    primaryCta={{ href: "contact.html", label: "Partnership Enquiry" }}
    secondaryCta={fees}
  />

  <!-- The opportunities, on the approach cards that used to open the
       homepage: each pinned in turn and tipped away as the next arrives,
       the last closed over by the shutter (initApproachSlides and
       initShutterScrollTransition in src/scripts/site.js). The shutter
       starts 40% of a viewport before the last card's bottom reaches the
       fold, which buys its rows more scroll to close in. -->
  <section class="approach" id="tech-firms-content">
    <div data-approach-slides-init class="approach__slides">
      {opportunities.map((item, i) => {
        const last = i === opportunities.length - 1;
        return (
          <div class="approach__slide" data-shutter-scroll-section={last ? "" : undefined}>
            <div class="approach__slide-wrapper">
              <div class={`approach__card ${item.tone}`}>
                <div class="approach__card-top">
                  <h3 class="approach__card-h">{item.title}</h3>
                  <span class="approach__card-mark" aria-hidden="true"><ArrowIcon /></span>
                </div>
                <div class="approach__card-bottom">
                  <p class="approach__card-p">{item.text}</p>
                  <div class="approach__card-aside">
                    <p class="approach__card-num">({String(i + 1).padStart(2, "0")})</p>
                    <img src={item.image} loading="lazy" alt="" class={`approach__card-image ${item.crop}`}>
                  </div>
                </div>
              </div>
            </div>
            {last && (
              <div data-shutter-scroll-transition="" data-rows="22" data-rows-tablet="14" data-rows-mobile="10" data-scroll-start="bottom bottom+=40%" class="shutter-scroll-transition"></div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <ClosingCta
    label="For technology companies"
    heading="Talk to us about partnering with ADDD"
    primary={{ href: "contact.html", label: "Partnership Enquiry" }}
    secondary={fees}
    accent="blue"
  />

</main>
</BaseLayout>
