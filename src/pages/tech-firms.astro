---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Hero from "../components/Hero.astro";
import { pageDocument, reader } from "../sanity/content";
import { techFirmsPage as D } from "../sanity/defaults/tech-firms";

// Every section's words and pictures come from the For AEC Tech Firms page
// document in Sanity (studio/schemaTypes/pages/tech-firms.ts), each element
// falling back to its own (src/sanity/defaults/tech-firms.ts): see
// src/sanity/content.ts. The hero's pattern, the cards' tones and crops and
// where every button leads stay here. Each element names the field it shows
// (data-page-field) so the Studio's Visual editor can outline it and write
// drafts into it.
const { t, list, img } = reader(await pageDocument(Astro.locals.sanity, "techFirmsPage"), D);

// The routes into ADDD's audience, one pinned card each (initApproachSlides,
// site.js). The last is left unpinned and closed over by the shutter. The
// cards are bound by position (not as a redrawable list) because the
// pinning animates them by position; each card's tone and crop stay here.
const opportunities = list<{ _key: string; title?: string; text?: string; image?: unknown }>("opportunities.items");
const tones = ["is--ink", "is--dark", "is--ink", "is--grey"];
const crops = ["is--crop-left", "is--crop-centre", "is--crop-centre", "is--crop-right"];

const fees = { href: "mailto:allister@addd.io?subject=Partnership%20fee%20sheet" };
---
<BaseLayout
  title="For AEC Tech Firms — ADDD"
  description="Sponsorship and partnerships that give technology companies access to ADDD’s architecture audience: workflow and episode content, ADDDitive newsletter placement, research and events."
  pageName="Tech Firms"
  doc={{ id: "techFirmsPage" }}
>
<main class="page--grid">

  <!-- The homepage hero for the AEC technology market: the same Slash
       Field, with the AEC Tech Firms blue as its accent, on the left of
       the viewport and the copy beside it (Hero.astro, "split"). Its
       buttons are the partnership routes, never the practice ones. -->
  <Hero
    arrowHref="#tech-firms-content"
    arrowLabel="Scroll to the partnership opportunities"
    layout="split"
    accent="blue"
    tagline={t("hero.tagline")}
    lede={t("hero.lede")}
    heading={t("hero.heading")}
    primaryCta={{ href: "contact.html", label: t("hero.primaryButton") }}
    secondaryCta={{ href: fees.href, label: t("hero.secondaryButton") }}
  />

  <!-- The opportunities, on the approach cards that used to open the
       homepage: each pinned in turn and tipped away as the next arrives,
       the last closed over by the shutter (initApproachSlides and
       initShutterScrollTransition in src/scripts/site.js). The shutter
       starts 40% of a viewport before the last card's bottom reaches the
       fold, which buys its rows more scroll to close in. -->
  <section class="approach" id="tech-firms-content">
    <div data-approach-slides-init class="approach__slides">
      {opportunities.map((item, i) => {
        const last = i === opportunities.length - 1;
        const picture = img(`opportunities.items.${i}.image`, 1200, D.opportunities.items[i]?.image);
        return (
          <div class="approach__slide" data-shutter-scroll-section={last ? "" : undefined}>
            <div class="approach__slide-wrapper">
              <div class={`approach__card ${tones[i] ?? tones[tones.length - 1]}`}>
                <div class="approach__card-top">
                  <h3 class="approach__card-h" data-page-field={`opportunities.items.${i}.title`}>{item.title}</h3>
                  <span class="approach__card-mark" aria-hidden="true"><ArrowIcon /></span>
                </div>
                <div class="approach__card-bottom">
                  <p class="approach__card-p" data-page-field={`opportunities.items.${i}.text`}>{item.text}</p>
                  <div class="approach__card-aside">
                    <p class="approach__card-num">({String(i + 1).padStart(2, "0")})</p>
                    <img src={picture.src} width={picture.width} height={picture.height} loading="lazy" alt="" class={`approach__card-image ${crops[i] ?? crops[crops.length - 1]}`} data-page-field={`opportunities.items.${i}.image`} data-page-width="1200">
                  </div>
                </div>
              </div>
            </div>
            {last && (
              <div data-shutter-scroll-transition="" data-rows="22" data-rows-tablet="14" data-rows-mobile="10" data-scroll-start="bottom bottom+=40%" class="shutter-scroll-transition"></div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <ClosingCta
    doc={{ id: "techFirmsPage", defaults: D, field: "closingCta" }}
    primary={{ href: "contact.html" }}
    secondary={{ href: fees.href }}
    accent="blue"
  />

</main>
</BaseLayout>
