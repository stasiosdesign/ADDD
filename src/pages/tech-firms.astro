---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Hero from "../components/Hero.astro";
import ProblemCard from "../components/ProblemCard.astro";
import ServiceTabs from "../components/ServiceTabs.astro";
import ServiceDeck from "../components/ServiceDeck.astro";
import FolderDocument from "../components/FolderDocument.astro";
import type { Folder } from "../components/DeckFolder.astro";
import StageTimeline, { type Stage } from "../components/StageTimeline.astro";
import { pageDocument, reader } from "../sanity/content";
import { techFirmsPage as D } from "../sanity/defaults/tech-firms";

// Every section's words and pictures come from the AEC Tech Partners page
// document in Sanity (studio/schemaTypes/pages/tech-firms.ts), each element
// falling back to its own (src/sanity/defaults/tech-firms.ts): see
// src/sanity/content.ts. The hero's pattern, the cards' photographs and
// where every button leads stay here. Each element names the field it shows
// (data-page-field) so the Studio's Visual editor can outline it and write
// drafts into it.
//
// Second pass (2026-11-04): the sections after Ways to Work brought into
// the site's family, their order and words kept: Why ADDD in the
// homepage's problem cards, each with a photograph of its own; the episode
// format in Before Revit's numbered rows; the partnerships in the Workflow
// Workshop's price cards; the process on the Workshop's timeline, in this
// page's blue, with measurement and independence under it on the ink. The
// three pinned objective cards that followed Why ADDD are gone (they said
// again what Ways to Work says). Styles: pages.css, "AEC Tech Partners".
const { t, list, lines } = reader(await pageDocument(Astro.locals.sanity, "techFirmsPage"), D);

type Offer = { _key: string; title?: string; audience?: string; subtitle?: string; price?: string; priceSuffix?: string; note?: string; includesLabel?: string; includes?: string[]; conditions?: string; button?: string };

const whyTiles = list<{ _key: string; number?: string; title?: string; text?: string }>("why.tiles");
const formatSteps = list<{ _key: string; label?: string; title?: string; text?: string }>("example.steps");
const processTiles = list<{ _key: string; number?: string; title?: string; text?: string }>("process.tiles");
const offers = list<Offer>("options.cards");
const placements = list<Offer>("more.cards");
// the blue panel's statements, one at a time (ServiceTabs.astro)
const statements = lines("services.statements");

// Why ADDD's photographs, one to a card, in the cards' order, from the
// site's own files (as the homepage's problem cards take theirs): a
// practice's team round a model (insight from practice work), a talk on
// real projects (content about real work), and an audience (distribution)
const WHY_PHOTOS = [
  { src: "/assets/images/team-model-review.webp", width: 450, height: 268 },
  { src: "/assets/images/allister-keynote-stage-crop.webp", width: 600, height: 400 },
  { src: "/assets/images/conference-keynote-crop.webp", width: 640, height: 478 },
];

// The process on the Workshop's timeline (StageTimeline.astro): each step
// a phase of its own across the top, named by the Studio's phases, its box
// in its own phase, opening to its line
const processStages: Stage[] = processTiles.map((step, i) => ({
  title: step.title,
  text: step.text,
  start: i,
  span: 1,
  fields: { title: `process.tiles.${i}.title`, text: `process.tiles.${i}.text` },
}));
const processScale = processTiles.map((_, i) => ({ label: lines("process.phases")[i] ?? "", field: `process.phases.${i}` }));

// The name each partnership carries into the enquiry form
// (contact.html?offer=…, initEnquiryOffer in site.js)
const enquire = (offer?: string) => `/contact?offer=${encodeURIComponent(offer ?? "partnership")}`;
// The partnerships as folders (2026-11-05): the three, then the two smaller
// placements, each with the Studio field its words come from; the sheet's
// words through the notch and the pill at the foot stay here, as the
// Workshop's folders keep theirs
const partnerships = [
  ...offers.map((o, i) => ({ ...o, field: `options.cards.${i}` })),
  ...placements.map((o, i) => ({ ...o, field: `more.cards.${i}` })),
];
const documents = list<{ _key: string; kicker?: string; lede?: string; body?: string[]; points?: string[] }>("documents.items");
const FOLDER_PARTS = [
  { covers: ["12 months", "Category exclusive"], kind: "Sponsorship" },
  { covers: ["Real project", "8–10 min video"], kind: "Content" },
  { covers: ["Quarterly", "Anonymised"], kind: "Intelligence" },
  { covers: ["ADDDitive", "One issue"], kind: "Placement" },
  { covers: ["Your event", "LinkedIn carousel"], kind: "Coverage" },
];
const pad = (n: number) => String(n).padStart(2, "0");
const folders: Folder[] = partnerships.map((offer, i) => ({
  n: i + 1,
  label: `Partnership N°${pad(i + 1)}`,
  meta: [offer.price, offer.priceSuffix].filter(Boolean).join(" "),
  title: offer.title,
  text: offer.subtitle,
  titleField: `${offer.field}.title`,
  textField: `${offer.field}.subtitle`,
  ...FOLDER_PARTS[i],
  go: "Open folder",
  action: `Open ${offer.title || "the folder"}`,
  opens: `partner-folder-${i + 1}`,
}));
---
<BaseLayout
  title="AEC Tech Partners — ADDD"
  description="Partnerships for technology companies: channel sponsorship, featured workflow episodes and practice intelligence that help architects understand where your technology fits."
  pageName="AEC Tech Partners"
  doc={{ id: "techFirmsPage" }}
>
<main class="page--grid page--partners">

  <!-- The hero for the AEC technology market: the first screen in the
       ink, its words on the page's centre line, the AEC Tech Firms blue as
       the buttons' accent (Hero.astro, "centred"), running on into the
       ink band of the statements under it. -->
  <Hero
    arrowHref="#why"
    arrowLabel="Scroll to why ADDD"
    layout="centred"
    cue="none"
    tagline={t("hero.tagline")}
    lede={t("hero.lede")}
    heading={t("hero.heading")}
    primaryCta={{ href: enquire(), label: t("hero.primaryButton") }}
    secondaryCta={{ href: "#options", label: t("hero.secondaryButton") }}
    statement={t("hero.statement")}
    statementField="hero.statement"
  />

  <!-- ========== WAYS TO WORK WITH ADDD ==========
       One panel that sticks while the scroll takes it through the
       statements, one large statement at a time on a blue square, its
       number under it (ServiceTabs.astro, service-tabs.js), on a band of
       the ink. -->
  <section class="service-tabs-section">
    <div class="service-tabs-section__body">
      <ServiceTabs statements={statements} label={t("services.tagline")} field="services" />
    </div>
  </section>

  <!-- ========== WHY ADDD ==========
       The heading row, then the homepage's problem cards (ProblemCard.astro):
       the white, black and grey fields of dots each with a photograph in its
       frame and its number in the corner, the title and line in the band
       under it, set out as a stair by the scroll (data-problem-parallax).
       Then what that gives a technology company: its heading on the left,
       the benefits on the right on the site's dotted rule, each marked in
       the page's blue, and the note under them. -->
  <section class="section tf-why" id="why">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="why.lede">{t("why.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="why.tagline">{t("why.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="why.heading">{t("why.heading")}</h2>
        </div>
      </div>

      <div data-problem-parallax class="problem-grid tf-why__cards">
        {whyTiles.map((item, i) => (
        <ProblemCard title={item.title} text={item.text} titleField={`why.tiles.${i}.title`} textField={`why.tiles.${i}.text`}>
          <span class="tf-why__num" data-page-field={`why.tiles.${i}.number`}>{item.number}</span>
          <div class="problem-card__frame">
            <img class="problem-card__image" src={WHY_PHOTOS[i % WHY_PHOTOS.length].src} width={WHY_PHOTOS[i % WHY_PHOTOS.length].width} height={WHY_PHOTOS[i % WHY_PHOTOS.length].height} alt="" loading="lazy" decoding="async" draggable="false">
          </div>
        </ProblemCard>
        ))}
      </div>

      <div class="tf-gives">
        <h3 class="tf-gives__title" data-page-field="why.benefitsTitle">{t("why.benefitsTitle")}</h3>
        <div class="tf-gives__body">
          <ul class="tf-rules" role="list">
            {lines("why.benefits").map((line, i) => (
            <li><span class="tf-mark" aria-hidden="true"></span><span data-page-field={`why.benefits.${i}`}>{line}</span></li>
            ))}
          </ul>
          <p class="tf-gives__note" data-page-field="why.note">{t("why.note")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT AN EPISODE LOOKS LIKE ==========
       The format, labelled as such: no completed episode is shown as a
       case study until one exists. Before Revit's numbered rows on the
       site's dotted rule (.steps), on the white. -->
  <section class="section tf-episode">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="example.lede">{t("example.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="example.tagline">{t("example.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="example.heading">{t("example.heading")}</h2>
        </div>
      </div>

      <ol class="steps" data-page-list="example.steps">
        {formatSteps.map((step) => (
        <li class="steps__item" data-page-item={step._key}>
          <p class="steps__label tagline tagline--sm" data-page-item-field="label">{step.label}</p>
          <div class="steps__body">
            <h3 class="h4" data-page-item-field="title">{step.title}</h3>
            <p data-page-item-field="text">{step.text}</p>
          </div>
        </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== PARTNERSHIP OPTIONS ==========
       (2026-11-05) The Workflow Workshop's Inside the Workshop
       (ServiceDeck.astro, DeckFolder.astro): the heading held on the left,
       the five partnerships as paper folders one under another, the three
       partnerships then the two smaller placements, each opening its paper
       (FolderDocument.astro, folder-docs.js) with who it suits, its price
       and terms, what it involves and what you receive, and the way on to
       the enquiry form, carrying the partnership's name. -->
  <ServiceDeck
    id="options"
    heading={t("options.heading")}
    headingField="options.heading"
    aside={t("options.tagline")}
    folders={folders}
  />
  {partnerships.map((offer, i) => (
  <FolderDocument
    id={`partner-folder-${i + 1}`}
    n={i + 1}
    series="ADDD :: AEC Tech Partners"
    title={offer.title}
    titleField={`${offer.field}.title`}
    kicker={documents[i]?.kicker}
    lede={documents[i]?.lede}
    body={documents[i]?.body}
    points={documents[i]?.points?.length ? documents[i]?.points : offer.includes}
    pointsLabel={offer.includesLabel || "You receive"}
    field={`documents.items.${i}`}
    facts={[
      { label: "Best suited to", value: offer.audience, field: `${offer.field}.audience` },
      { label: "Price", value: [offer.price, offer.priceSuffix].filter(Boolean).join(" "), field: `${offer.field}.price` },
      { label: "Terms", value: [offer.note, offer.conditions].filter(Boolean).join(". "), field: `${offer.field}.conditions` },
    ]}
    cta={{ href: enquire(offer.title), label: offer.button || "Discuss a partnership", field: `${offer.field}.button` }}
  />
  ))}

  <!-- ========== PROCESS, MEASUREMENT AND INDEPENDENCE ==========
       On the ink: the four steps on the Workflow Workshop's timeline
       (StageTimeline.astro, dark), each step a phase across the top and
       opening to its line, its lit columns and rule in the page's blue;
       under it how success is measured, and the editorial independence
       commitments on the site's dotted rule, each marked in the blue. -->
  <section class="section tf-process" id="process">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="process.lede">{t("process.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="process.tagline">{t("process.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="process.heading">{t("process.heading")}</h2>
        </div>
      </div>

      <div class="tf-process__run">
        <StageTimeline id="partner-stages" stages={processStages} scale={processScale} dark />
      </div>

      <div class="tf-terms">
        <div class="tf-terms__measure">
          <h3 class="tf-terms__title" data-page-field="process.measurementTitle">{t("process.measurementTitle")}</h3>
          <p data-page-field="process.measurement">{t("process.measurement")}</p>
          <p data-page-field="process.intelligenceMeasurement">{t("process.intelligenceMeasurement")}</p>
        </div>
        <div class="tf-terms__independence" id="independence">
          <h3 class="tf-terms__title" data-page-field="process.independenceTitle">{t("process.independenceTitle")}</h3>
          <ul class="tf-rules" role="list">
            {lines("process.independence").map((line, i) => (
            <li><span class="tf-mark" aria-hidden="true"></span><span data-page-field={`process.independence.${i}`}>{line}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ClosingCta
    doc={{ id: "techFirmsPage", defaults: D, field: "closingCta" }}
    primary={{ href: enquire() }}
    secondary={{ href: "#options" }}
  />

</main>
</BaseLayout>
