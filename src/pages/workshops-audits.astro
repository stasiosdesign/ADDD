---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accordion from "../components/Accordion.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { pageDocument, reader } from "../sanity/content";
import { workshopPage as D } from "../sanity/defaults/workshop";

// Every section's words come from the Workflow Workshop page document in
// Sanity (studio/schemaTypes/pages/workshop.ts), each element falling back
// to its own (src/sanity/defaults/workshop.ts): see src/sanity/content.ts.
// The navigation, the footer, the two price cards' looks and where every
// button leads stay here. Each element names the field it shows
// (data-page-field) so the Studio's Visual editor can outline it and write
// drafts into it.
const { t, list, lines, bg } = reader(await pageDocument(Astro.locals.sanity, "workshopPage"), D);

type Tile = { _key: string; tagline?: string; title?: string; text?: string; image?: unknown };
type Step = { _key: string; label?: string; title?: string; text?: string };
const symptoms = list<Tile>("symptoms.tiles");
const methods = list<Tile>("method.tiles");
const journey = list<Step>("journey.steps");
const stages = list<Tile>("pricing.tiles");
const faq = list<{ _key: string; question?: string; answer?: string }>("faq.questions");
---
<BaseLayout
  title="Workflow Workshop — ADDD"
  description="A half-day diagnostic using a live project, for practice leaders who know something is not working but need clarity on where to start. Map how work moves, find the friction and receive a written report."
  pageName="Workflow Workshop"
  doc={{ id: "workshopPage" }}
>
<main class="page--grid">

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline" data-page-field="hero.tagline">{t("hero.tagline")}</p>
          <h1 class="h1" data-page-field="hero.heading">{t("hero.heading")}</h1>
        </div>
        <div class="pg-hero__col">
          <p class="text-md" data-page-field="hero.lede">{t("hero.lede")}</p>
          <div class="actions actions--pair">
            <ActionButton href="contact.html"><span data-page-field="hero.primaryButton">{t("hero.primaryButton")}</span></ActionButton>
            <ActionButton href="#pricing" variant="secondary"><span data-page-field="hero.secondaryButton">{t("hero.secondaryButton")}</span></ActionButton>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="band band--wide"></div>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="symptoms.lede">{t("symptoms.lede")}</p>
        <div class="section-title__body">
          <h2 class="h2" data-page-field="symptoms.heading">{t("symptoms.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--2 grid--mt" data-page-list="symptoms.tiles">
        {symptoms.map((tile) => (
        <article class="tile" data-page-item={tile._key}>
          <h3 class="h4" data-page-item-field="title">{tile.title}</h3>
          <p data-page-item-field="text">{tile.text}</p>
        </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="method.lede">{t("method.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="method.tagline">{t("method.tagline")}</p>
          <h2 class="h2" data-page-field="method.heading">{t("method.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt" data-page-list="method.tiles">
        {methods.map((tile, i) => {
          const picture = bg(`method.tiles.${i}.image`);
          return (
        <article class="stack stack--16" data-page-item={tile._key}>
          <div class="ph" style={picture ? `aspect-ratio:4/3;${picture}` : "aspect-ratio:4/3"} data-page-item-field="image" data-page-item-bg></div>
          {tile.tagline && <p class="tagline tagline--sm" data-page-item-field="tagline">{tile.tagline}</p>}
          <h3 class="h4" data-page-item-field="title">{tile.title}</h3>
          <p data-page-item-field="text">{tile.text}</p>
        </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="journey.lede">{t("journey.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="journey.tagline">{t("journey.tagline")}</p>
          <h2 class="h2" data-page-field="journey.heading">{t("journey.heading")}</h2>
        </div>
      </div>

      <div class="steps" data-page-list="journey.steps">
        {journey.map((step) => (
        <div class="steps__item" data-page-item={step._key}>
          <p class="tagline tagline--sm steps__label" data-page-item-field="label">{step.label}</p>
          <div class="steps__body">
            <h3 class="h4" data-page-item-field="title">{step.title}</h3>
            <p data-page-item-field="text">{step.text}</p>
          </div>
        </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <div class="section-title__body">
          <p class="tagline" data-page-field="story.tagline">{t("story.tagline")}</p>
          <h2 class="h2" data-page-field="story.heading">{t("story.heading")}</h2>
        </div>
      </div>
      <div class="case__panel">
        <div class="case__quote-wrap">
          <div class="case__quote-inner">
            <blockquote class="quote" data-page-field="quote.quote">{t("quote.quote")}</blockquote>
            <div class="avatar">
              <div class="avatar__img"></div>
              <div>
                <p class="avatar__name" data-page-field="quote.name">{t("quote.name")}</p>
                <p data-page-field="quote.role">{t("quote.role")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="pricing.lede">{t("pricing.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="pricing.tagline">{t("pricing.tagline")}</p>
          <h2 class="h2" data-page-field="pricing.heading">{t("pricing.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt" data-page-list="pricing.tiles">
        {stages.map((tile) => (
        <article class="tile tile--outline" data-page-item={tile._key}>
          <h3 class="h4" data-page-item-field="title">{tile.title}</h3>
          <p data-page-item-field="text">{tile.text}</p>
        </article>
        ))}
      </div>

      <div class="grid grid--2" style="margin-top:2rem">
        <article class="price-card">
          <div class="stack stack--16">
            <h3 class="h4" data-page-field="pricing.cards.0.title">{t("pricing.cards.0.title")}</h3>
            {t("pricing.cards.0.subtitle") && <p data-page-field="pricing.cards.0.subtitle">{t("pricing.cards.0.subtitle")}</p>}
            <div class="price">{t("pricing.cards.0.pricePrefix") && <Fragment><span data-page-field="pricing.cards.0.pricePrefix">{t("pricing.cards.0.pricePrefix")}</span> </Fragment>}<span class="price__amount" data-page-field="pricing.cards.0.price">{t("pricing.cards.0.price")}</span>{t("pricing.cards.0.priceSuffix") && <Fragment> <span data-page-field="pricing.cards.0.priceSuffix">{t("pricing.cards.0.priceSuffix")}</span></Fragment>}</div>
            {t("pricing.cards.0.note") && <p data-page-field="pricing.cards.0.note">{t("pricing.cards.0.note")}</p>}
          </div>
          {t("pricing.cards.0.includesLabel") && <p class="tagline tagline--sm" data-page-field="pricing.cards.0.includesLabel">{t("pricing.cards.0.includesLabel")}</p>}
          {lines("pricing.cards.0.includes").length > 0 && (
          <ul class="check-list">
            {lines("pricing.cards.0.includes").map((line, j) => (
            <li data-page-field={`pricing.cards.0.includes.${j}`}>{line}</li>
            ))}
          </ul>
          )}
          <ActionButton href="contact.html"><span data-page-field="pricing.cards.0.button">{t("pricing.cards.0.button")}</span></ActionButton>
        </article>

        <article class="price-card price-card--dark">
          <div class="stack stack--16">
            <h3 class="h4" data-page-field="pricing.cards.1.title">{t("pricing.cards.1.title")}</h3>
            {t("pricing.cards.1.subtitle") && <p data-page-field="pricing.cards.1.subtitle">{t("pricing.cards.1.subtitle")}</p>}
            <div class="price">{t("pricing.cards.1.pricePrefix") && <Fragment><span data-page-field="pricing.cards.1.pricePrefix">{t("pricing.cards.1.pricePrefix")}</span> </Fragment>}<span class="price__amount" data-page-field="pricing.cards.1.price">{t("pricing.cards.1.price")}</span>{t("pricing.cards.1.priceSuffix") && <Fragment> <span data-page-field="pricing.cards.1.priceSuffix">{t("pricing.cards.1.priceSuffix")}</span></Fragment>}</div>
            {t("pricing.cards.1.note") && <p data-page-field="pricing.cards.1.note">{t("pricing.cards.1.note")}</p>}
          </div>
          {t("pricing.cards.1.includesLabel") && <p class="tagline tagline--sm" data-page-field="pricing.cards.1.includesLabel">{t("pricing.cards.1.includesLabel")}</p>}
          {lines("pricing.cards.1.includes").length > 0 && (
          <ul class="check-list">
            {lines("pricing.cards.1.includes").map((line, j) => (
            <li data-page-field={`pricing.cards.1.includes.${j}`}>{line}</li>
            ))}
          </ul>
          )}
          <ActionButton href="technology-blueprint.html" variant="secondary"><span data-page-field="pricing.cards.1.button">{t("pricing.cards.1.button")}</span></ActionButton>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2 class="h2" data-page-field="faq.heading">{t("faq.heading")}</h2>
      <Accordion id="faq" items={faq} field="faq.questions" />
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
