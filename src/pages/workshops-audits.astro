---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqPanel from "../components/FaqPanel.astro";
import FaqSection from "../components/FaqSection.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";
import BookCallFloat from "../components/BookCallFloat.astro";
import Testimonials from "../components/Testimonials.astro";
import ProblemCard from "../components/ProblemCard.astro";
import ServiceDeck from "../components/ServiceDeck.astro";
import BeforeRevitHero from "../components/BeforeRevitHero.astro";
import FolderDocument from "../components/FolderDocument.astro";
import StageTimeline, { type Stage } from "../components/StageTimeline.astro";
import PricingPlan from "../components/PricingPlan.astro";
import PlanNext from "../components/PlanNext.astro";
import type { Folder } from "../components/DeckFolder.astro";
import { pageDocument, reader } from "../sanity/content";
import { workshopPage as D } from "../sanity/defaults/workshop";

// Every section's words come from the Workflow Workshop page document in
// Sanity (studio/schemaTypes/pages/workshop.ts), each element falling back
// to its own (src/sanity/defaults/workshop.ts): see src/sanity/content.ts.
// The navigation, the footer, the figures, the two price cards' looks and
// where every button leads stay here. Each element names the field it
// shows (data-page-field) so the Studio's Visual editor can outline it and
// write drafts into it. The layout is the desktop design of 2026-11-04
// ("Workshops • Desktop"), styled in src/styles/workshop.css.
const { t, list, lines } = reader(await pageDocument(Astro.locals.sanity, "workshopPage"), D);

type Tile = { _key: string; tagline?: string; title?: string; text?: string; image?: unknown };
type Step = { _key: string; label?: string; title?: string; text?: string };
const symptoms = list<Tile>("symptoms.tiles");
const methods = list<Tile>("method.tiles");
const journey = list<Step>("journey.steps");
// Workshop Process: each step with its timing and its more (journey.details,
// in the steps' order), and a photograph from the library (the
// page's own, not the Studio's)
const details = list<{ _key: string; meta?: string; more?: string }>("journey.details");
const STAGE_PHOTOS = [
  { src: "/assets/images/allister-gesture-close-crop.webp", alt: "" },
  { src: "/assets/images/conference-keynote-crop.webp", alt: "" },
  { src: "/assets/images/allister-keynote-stage-crop.webp", alt: "" },
  { src: "/assets/images/team-model-review.webp", alt: "" },
];
// On the chart (StageTimeline.astro): each step's timing a phase across
// the top, the step a row of its own, its name on the row's strip, its box
// in its own phase
const expectStages: Stage[] = journey.map((step, i) => ({
  lane: step.label,
  title: step.title,
  text: step.text,
  more: details[i]?.more,
  image: STAGE_PHOTOS[i],
  start: i,
  span: 1,
  fields: {
    lane: `journey.steps.${i}.label`,
    title: `journey.steps.${i}.title`,
    text: `journey.steps.${i}.text`,
    more: `journey.details.${i}.more`,
  },
}));
const expectScale = journey.map((_, i) => ({ label: details[i]?.meta, field: `journey.details.${i}.meta` }));
const stages = list<Tile>("pricing.tiles");
const faq = list<{ _key: string; question?: string; answer?: string }>("faq.questions");

// The problem cards' figures, in the cards' order (problem-figures.js):
// the same problems coming round again, the formats no two teams share,
// and the handoff that never quite connects.
const PROBLEM_FIGURES = [
  { figure: "turntable", label: "Blocks on a turntable that settles back where it started" },
  { figure: "format", label: "A file of crooked lines, each set to a different indent" },
  { figure: "plug", label: "A plug drawn towards its socket that stops short" },
];

// What the workshop delivers: one folder per method tile, each opening its
// document. What the folders show besides the tile's words (the label row,
// the sheet's words, the pill) stays here, as the homepage's routes keep
// theirs in services.ts.
type Doc = { _key: string; kicker?: string; lede?: string; body?: string[]; points?: string[] };
const documents = list<Doc>("method.documents");
const FOLDER_PARTS = [
  { meta: "Your project", covers: ["Recent project", "Real delays"], kind: "Evidence" },
  { meta: "The friction", covers: ["Duplication", "Lost data"], kind: "Diagnosis" },
  { meta: "The map", covers: ["Brief", "Completion"], kind: "Clarity" },
];
const pad = (n: number) => String(n).padStart(2, "0");
const folders: Folder[] = methods.map((tile, i) => ({
  n: i + 1,
  label: `Outcome N°${pad(i + 1)}`,
  ...FOLDER_PARTS[i],
  title: tile.title,
  text: tile.text,
  titleField: `method.tiles.${i}.title`,
  textField: `method.tiles.${i}.text`,
  go: "Open folder",
  action: `Open ${tile.title || "the folder"}`,
  opens: `workshop-folder-${i + 1}`,
}));

// a booking or enquiry button: the free call's calendar (BookCallDialog.astro,
// "book-call", which the FAQ's Book a Free Call renders), as Book a Call
// opens it (2026-11-05)
const BOOK = { type: "button", "data-booking-open": "book-call", "aria-haspopup": "dialog", "aria-controls": "book-call" };
---
<BaseLayout
  title="Workflow Workshop — ADDD"
  description="A half-day diagnostic using a live project, for practice leaders who know something is not working but need clarity on where to start. Map how work moves, find the friction and receive a written report."
  pageName="Workflow Workshop"
  doc={{ id: "workshopPage" }}
>
<main class="page--grid page--workshop">

  <!-- The opening (2026-11-04): the Before Revit hero's composition and
       its red light (BeforeRevitHero.astro; first set in a white light, then
       in the red at the user's word, and without the label over the
       heading): on black, the heading, the standfirst and the two buttons
       on the left, and on the right the exploded drawing on its lattice,
       its frame coming down as the page scrolls. The drawing's words are
       this page's own: the workshop on the platform, the project held over
       it (a project of the participant's own: the outcome folders' "Your
       project"), the standfirst's half-day session, and the stages it runs
       through (the Workshop Process's first three). No red block under it
       any more, and no row of practices. -->
  <BeforeRevitHero
    heading={t("hero.heading")}
    lede={t("hero.lede")}
    statement={t("hero.statement")}
    marks={false}
    words={{
      frame: "Your project",
      note: ["A half-day session", "around a real project"],
      platform: t("hero.tagline") || "Workflow Workshop",
      tags: journey.slice(0, 3).map((step) => step.label ?? "").filter(Boolean),
    }}
  >
    <Fragment slot="actions">
      <!-- the free call's booking calendar, the one every booking button on
           the page opens (since 2026-11-05; rendered by the FAQ's Book a Free
           Call: FaqPanel.astro, BookCallDialog.astro), and the way down to
           the prices, clear of the nav (scroll.js) -->
      <ActionButton type="button" data-booking-open="book-call" aria-haspopup="dialog" aria-controls="book-call"><span data-page-field="hero.primaryButton">{t("hero.primaryButton")}</span></ActionButton>
      <ActionButton href="#pricing" variant="secondary" arrow="down"><span data-page-field="hero.secondaryButton">{t("hero.secondaryButton")}</span></ActionButton>
    </Fragment>
  </BeforeRevitHero>


  <section class="section ws-section is--problems" id="overview">
    <div class="container">
      <div class="ws-head">
        <h2 class="h2" data-split="heading" data-page-field="symptoms.heading">{t("symptoms.heading")}</h2>
      </div>

      <!-- the homepage's problem cards (ProblemCard.astro), each with a
           Hairline figure in the frame the homepage's photograph stands
           in (problem-figures.js), the strip set out as a stair by the
           scroll as the homepage's is -->
      <div data-problem-parallax class="problem-grid ws-problems">
        {symptoms.map((tile, i) => (
        <ProblemCard title={tile.title} text={tile.text} titleField={`symptoms.tiles.${i}.title`} textField={`symptoms.tiles.${i}.text`}>
          <div class="problem-card__frame is--figure">
            <div class="problem-card__figure" data-problem-figure={PROBLEM_FIGURES[i]?.figure} data-label={PROBLEM_FIGURES[i]?.label}></div>
          </div>
        </ProblemCard>
        ))}
      </div>
    </div>
  </section>

  <!-- Inside the Workshop: the homepage's folder cards (ServiceDeck.astro),
       paper folders on the ink as the homepage's are, three of them, each
       opening a document drawn out of it (FolderDocument.astro,
       folder-docs.js); set a little to the left (workshop.css) -->
  <ServiceDeck
    heading={t("method.heading")}
    headingField="method.heading"
    aside={t("method.tagline")}
    folders={folders}
  />
  {folders.map((folder, i) => (
  <FolderDocument
    id={folder.opens!}
    n={folder.n}
    series="ADDD :: Workflow Workshop"
    title={folder.title}
    titleField={folder.titleField}
    kicker={documents[i]?.kicker}
    lede={documents[i]?.lede}
    body={documents[i]?.body}
    points={documents[i]?.points}
    field={`method.documents.${i}`}
    book="book-call"
  />
  ))}

  <!-- Workshop Process: the four stages on a timeline after a Gantt chart
       (StageTimeline.astro), each opening to tell more, given room to
       breathe rather than held to a screen's height -->
  <section class="section ws-section section--dark ws-expect" id="what-to-expect">
    <div class="container">
      <div class="ws-expect__head">
        <div>
          <p class="tagline" data-page-field="journey.tagline">{t("journey.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="journey.heading">{t("journey.heading")}</h2>
        </div>
        <p class="ws-expect__lede" data-page-field="journey.lede">{t("journey.lede")}</p>
      </div>
      <div class="ws-expect__run">
        <StageTimeline id="workshop-stages" stages={expectStages} scale={expectScale} dark />
      </div>
    </div>
  </section>

  <!-- the homepage's testimonials, the same block (Testimonials.astro):
       its quotes are the Home page's -->
  <Testimonials />

  <!-- The prices (2026-11-05, after the user's reference: PricingPlan.astro,
       plan.css): the heading on the left over the day's three parts, the
       workshop's card on the right, and under them one ink panel on to the
       Technology Blueprint (the second card's words, without its list) -->
  <section class="section plan-section" id="pricing">
    <div class="container">
      <PricingPlan
        lead={t("pricing.headingLead")}
        leadField="pricing.headingLead"
        heading={t("pricing.heading")}
        headingField="pricing.heading"
        rowsLabel="The workshop, before, during and after"
        rows={stages.map((tile, i) => ({ title: tile.title, text: tile.text, titleField: `pricing.tiles.${i}.title`, textField: `pricing.tiles.${i}.text` }))}
        plans={[{
          id: "plan-workshop",
          field: "pricing.cards.0",
          title: t("pricing.cards.0.title"),
          badge: t("pricing.cards.0.badge"),
          prefix: t("pricing.cards.0.pricePrefix"),
          price: t("pricing.cards.0.price"),
          suffix: t("pricing.cards.0.priceSuffix"),
          caption: t("pricing.cards.0.subtitle"),
          label: t("pricing.cards.0.includesLabel"),
          includes: lines("pricing.cards.0.includes"),
          note: t("pricing.cards.0.note"),
          button: { label: t("pricing.cards.0.button"), attrs: BOOK },
        }]}
      >
        <PlanNext slot="next" links={[{
          title: t("pricing.cards.1.title"),
          text: t("pricing.cards.1.subtitle"),
          button: t("pricing.cards.1.button"),
          href: "technology-blueprint.html",
          titleField: "pricing.cards.1.title",
          textField: "pricing.cards.1.subtitle",
          buttonField: "pricing.cards.1.button",
        }]} />
      </PricingPlan>
    </div>
  </section>

  <!-- Common Questions: the site's FAQ panel (FaqPanel.astro), each
       question with its icon, and Book a Free Call as its last item -->
  <FaqSection>
      <FaqPanel id="faq" heading={t("faq.heading")} headingField="faq.heading" items={faq} field="faq.questions"
        icons={["user", "chat", "clipboard", "map-pin", "file"]} call />
  </FaqSection>

  <!-- the site's closing call to action, with one button of this page's
       own: on to the Technology Blueprint -->
  <ClosingCta single={{ href: "technology-blueprint.html", label: t("closing.button"), field: "closing.button", doc: "workshopPage" }} />
  <!-- Book a Call, floating at the screen's foot from past the hero to Book a
       Free Call (BookCallFloat.astro) -->
  <BookCallFloat />

</main>
</BaseLayout>
