---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accordion from "../components/Accordion.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";

const faq = [
  { question: "Who should attend the workshop?", answer: "Anyone who shapes how work moves through the practice — a director or partner, the project lead for the chosen project, and whoever owns BIM, IT or operations." },
  { question: "How many people should come?", answer: "Between four and eight. Enough perspectives to see the whole flow, few enough that everyone contributes." },
  { question: "What preparation is required?", answer: "A short questionnaire and the selection of one real project. Nothing else needs to be produced in advance." },
  { question: "Does it have to be in person?", answer: "Yes. The workshop works because people are in the room together, working through a real project. Remote doesn’t create the same clarity." },
  { question: "When do we get the report?", answer: "Within two weeks of the session." },
];
---
<BaseLayout
  title="Workshops & Audits — ADDD"
  description="A half-day session with your team around a real project. Map how work moves through the practice, find where workflows and tools create friction, and receive a written report."
  pageName="Workshops & Audits"
>
<main>

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline">Workshops &amp; Audits</p>
          <h1 class="h1">Find where your practice is losing time</h1>
        </div>
        <div class="pg-hero__col">
          <p class="text-md">A half-day session with your team around a real project. You&rsquo;ll map how work moves through the practice, identify where workflows and tools create friction, and receive a written report with findings and priorities</p>
          <div class="actions">
            <ActionButton href="contact.html">Contact</ActionButton>
            <ActionButton href="#pricing" variant="secondary">Workshop Pricing</ActionButton>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="band band--wide"></div>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <p class="text-md">Most practices don&rsquo;t have a software problem. They have a workflow problem. The same issues recur across projects. Teams solve similar problems in different ways. Information gets lost or recreated. Tools accumulate without clear purpose.</p>
        <div class="section-title__body">
          <h2 class="h2">Does This Sound Like Your Practice?</h2>
        </div>
      </div>

      <div class="grid grid--2 grid--mt">
        <article class="tile">
          <h3 class="h4">The same problems surface on every project</h3>
          <p>Coordination delays, rework and information loss repeat without lasting solutions</p>
        </article>
        <article class="tile">
          <h3 class="h4">Teams work in different ways across the practice</h3>
          <p>No shared method means knowledge stays siloed and effort duplicates</p>
        </article>
        <article class="tile">
          <h3 class="h4">Information disappears between handoffs</h3>
          <p>Data is recreated rather than passed forward, wasting time and introducing error</p>
        </article>
        <article class="tile">
          <h3 class="h4">Growth has exposed weak foundations</h3>
          <p>Systems that worked at 30 people don&rsquo;t scale to 80 without breaking</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <p class="text-md">A structured half-day that examines a real project to reveal where workflows break down.</p>
        <div class="section-title__body">
          <p class="tagline">Method</p>
          <h2 class="h2">How the workshop works</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt">
        <article class="stack stack--16">
          <div class="ph" style="aspect-ratio:4/3"></div>
          <h3 class="h4">Examine one project</h3>
          <p>You select a recent or current project that exposed workflow problems or delays.</p>
        </article>
        <article class="stack stack--16">
          <div class="ph" style="aspect-ratio:4/3"></div>
          <h3 class="h4">Map the actual flow</h3>
          <p>Four hours tracing how information, decisions and work move through your practice from start to finish.</p>
        </article>
        <article class="stack stack--16">
          <div class="ph" style="aspect-ratio:4/3"></div>
          <p class="tagline tagline--sm">Diagnostic</p>
          <h3 class="h4">Identify friction and lost time</h3>
          <p>Spot where duplication happens, information disappears, decisions go unrecorded and responsibility blurs.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <p class="text-md">ADDD arrives to trace how information, decisions and work move through your practice from brief to completion. You&rsquo;ll identify where duplication happens, where information disappears and where responsibility blurs.</p>
        <div class="section-title__body">
          <p class="tagline">Journey</p>
          <h2 class="h2">How the Workshop works</h2>
        </div>
      </div>

      <div class="steps">
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Prepare</p>
          <div class="steps__body">
            <h3 class="h4">You complete the questionnaire</h3>
            <p>A short questionnaire arrives with guidance on choosing a project that exposed real workflow problems. You&rsquo;ll also receive details on who should attend and how to prepare.</p>
          </div>
        </div>
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Attend</p>
          <div class="steps__body">
            <h3 class="h4">Half day in the room</h3>
            <p>ADDD facilitates a structured session tracing how work, information and decisions move through your practice. You&rsquo;ll map the actual flow, identify where friction occurs and agree on what matters most.</p>
          </div>
        </div>
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Review</p>
          <div class="steps__body">
            <h3 class="h4">The report arrives</h3>
            <p>A tailored written report is delivered within two weeks. It contains findings, priority areas, practical recommendations and suggested next steps specific to your practice and the project examined.</p>
          </div>
        </div>
        <div class="steps__item">
          <p class="tagline tagline--sm steps__label">Act</p>
          <div class="steps__body">
            <h3 class="h4">What you leave with</h3>
            <p>A clear map of where time disappears, which problems to address first, and a practical starting point for change without requiring a larger commitment or further investment.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <div class="section-title__body">
          <p class="tagline">What practices discover</p>
          <h2 class="h2">How a 90-person practice found where time was disappearing</h2>
        </div>
      </div>
      <div class="case__panel">
        <div class="case__quote-wrap">
          <div class="case__quote-inner">
            <blockquote class="quote">We thought we needed better software. The workshop showed us we needed better workflows.</blockquote>
            <div class="avatar">
              <div class="avatar__img"></div>
              <div>
                <p class="avatar__name">Design director</p>
                <p>90-person London practice</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="container">
      <div class="section-title">
        <p class="text-md">One half-day session. Everything needed to find where time disappears.</p>
        <div class="section-title__body">
          <p class="tagline">Investment</p>
          <h2 class="h2">The workshop</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt">
        <article class="tile tile--outline">
          <h3 class="h4">Before arrival</h3>
          <p>Short questionnaire and project selection guidance sent in advance</p>
        </article>
        <article class="tile tile--outline">
          <h3 class="h4">During the session</h3>
          <p>Four hours mapping workflows, identifying friction and prioritising opportunities</p>
        </article>
        <article class="tile tile--outline">
          <h3 class="h4">After completion</h3>
          <p>Tailored written report with findings, recommendations and next steps</p>
        </article>
      </div>

      <div class="grid grid--2" style="margin-top:32px">
        <article class="price-card">
          <div class="stack stack--16">
            <h3 class="h4">Standard workshop</h3>
            <p>Includes everything above</p>
            <div class="price"><span class="price__amount">&pound;1,040</span></div>
          </div>
          <p class="tagline tagline--sm">Includes</p>
          <ul class="check-list">
            <li>Pre-workshop questionnaire &mdash; attendee and preparation guidance</li>
            <li>Four-hour facilitated session &mdash; real project analysis and mapping</li>
            <li>Tailored written report &mdash; key findings and priority areas</li>
            <li>Practical recommendations &mdash; quick wins and next steps</li>
            <li>Optional executive readout &mdash; leadership-facing presentation of findings</li>
          </ul>
          <ActionButton href="contact.html">Enquire about a workshop</ActionButton>
        </article>

        <article class="price-card price-card--dark">
          <div class="stack stack--16">
            <h3 class="h4">Technology blueprint</h3>
            <div class="price"><span class="price__amount">Custom</span></div>
          </div>
          <p class="tagline tagline--sm">Includes</p>
          <ul class="check-list">
            <li>Practice-wide workflow analysis</li>
            <li>Software audit and licensing review</li>
            <li>Infrastructure and security assessment</li>
            <li>Governance and decision structure</li>
            <li>AI readiness and capability evaluation</li>
            <li>Vendor strategy and cost optimisation</li>
            <li>Two to three-year implementation roadmap</li>
            <li>Prioritised recommendations and quick wins</li>
          </ul>
          <a class="btn btn--white" href="technology-blueprint.html">Explore the Technology Blueprint</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2 class="h2">Common Questions</h2>
      <Accordion id="faq" items={faq} />
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
