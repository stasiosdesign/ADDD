---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";
import InsightSlider from "../components/InsightSlider.astro";

const related = [
  { href: "report-template.html", image: "assets/images/allister-keynote-stage.jpg", category: "Technology", title: "Building a software strategy", meta: ["7 min read"] },
  { href: "report-template.html", image: "assets/images/allister-podium-portrait.jpg", category: "Workflows", title: "Redesigning processes effectively", meta: ["9 min read"] },
  { href: "report-template.html", image: "assets/images/allister-podium-full.jpg", category: "AI and BIM", title: "Understanding AI’s real impact", meta: ["November 2024"] },
  { href: "report-template.html", image: "assets/images/allister-gesture-warm.jpg", category: "Strategy", title: "Software selection frameworks", meta: ["October 2024"] },
  { href: "report-template.html", image: "assets/images/allister-gesture-close.jpg", category: "Implementation", title: "Process mapping essentials", meta: ["September 2024"] },
  { href: "report-template.html", image: "assets/images/conference-keynote.jpg", category: "Technology", title: "Evaluating emerging tools", meta: ["August 2024"] },
];
---
<BaseLayout
  title="The ultimate BIM 2.0 report — ADDD"
  description="A practical guide to evaluating emerging BIM platforms, generative design tools, and digital workflows that shape modern architecture practice."
  pageName="BIM 2.0 Report"
>
<main class="page--grid">

  <section class="pg-hero">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <div class="cover"></div>
        </div>
        <div class="pg-hero__col">
          <p class="tagline">Report</p>
          <h1 class="h2">The ultimate BIM 2.0 report</h1>
          <p class="text-md">A practical guide to evaluating emerging BIM platforms, generative design tools, and digital workflows that shape modern architecture practice.</p>
          <form class="newsletter-form" onsubmit="return false">
            <input type="email" placeholder="Work email" aria-label="Work email">
            <button class="newsletter-form__submit" type="submit">Download</button>
          </form>
          <p class="text-sm">We respect your inbox. Unsubscribe at any time.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-title">
        <p class="text-md">A breakdown of the platforms, tools, and approaches shaping BIM practice today. This report examines what works, what doesn&rsquo;t, and where your practice fits in.</p>
        <div class="section-title__body">
          <p class="tagline">Inside</p>
          <h2 class="h2">What this report covers</h2>
        </div>
      </div>

      <div class="pg-hero__grid" style="margin-top:5rem">
        <div class="pg-hero__col" style="flex:0 0 20rem">
          <ul class="steps" style="margin-top:0;width:100%">
            <li class="steps__item" style="padding:1.25rem 0"><span class="text-md">BIM platforms</span></li>
            <li class="steps__item" style="padding:1.25rem 0"><span class="text-md">Generative tools</span></li>
            <li class="steps__item" style="padding:1.25rem 0"><span class="text-md">Interoperability</span></li>
            <li class="steps__item" style="padding:1.25rem 0"><span class="text-md">Workflow fit</span></li>
            <li class="steps__item" style="padding:1.25rem 0"><span class="text-md">Selection</span></li>
          </ul>
        </div>
        <div class="pg-hero__col">
          <div class="tile tile--lg" style="background:var(--c-white);width:100%">
            <div class="card__icon"><img src="assets/icons/visibility.svg" alt=""></div>
            <h3 class="h3">Leading BIM 2.0 platforms and their capabilities</h3>
            <p>A detailed look at the tools reshaping how architecture practices work with data and design.</p>
            <div class="actions">
              <ActionButton href="#download" variant="secondary">Read</ActionButton>
              <a class="btn btn--link" href="reports.html">Explore <img class="icon" src="assets/icons/chevron_right.svg" alt=""></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="research__controls" style="margin-top:0">
        <div class="stack stack--16">
          <p class="tagline">Resources</p>
          <h2 class="h2">Related reports</h2>
          <p>Explore more insight-led content to guide your practice forward</p>
        </div>
        <ActionButton href="reports.html" variant="secondary">View all</ActionButton>
      </div>

      <InsightSlider items={related} />
    </div>
  </section>

  <section class="section" id="download">
    <div class="container">
      <div class="card">
        <div class="card__body card__body--lg">
          <div class="card__text">
            <h2 class="h3">Get the BIM 2.0 report</h2>
            <p>Download your copy and explore what&rsquo;s reshaping architecture practice today</p>
          </div>
          <form class="newsletter-form" onsubmit="return false">
            <input type="email" placeholder="Work email" aria-label="Work email">
            <button class="newsletter-form__submit" type="submit">Download report</button>
          </form>
          <p class="text-sm">We respect your inbox. Unsubscribe at any time.</p>
        </div>
      </div>
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
