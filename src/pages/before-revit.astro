---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import BeforeRevitHero from "../components/BeforeRevitHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import BookCall from "../components/BookCall.astro";
import BookCallFloat from "../components/BookCallFloat.astro";
import PricingPlan from "../components/PricingPlan.astro";
import PlanNext from "../components/PlanNext.astro";
import { pageDocument, reader } from "../sanity/content";
import { beforeRevitPage as D } from "../sanity/defaults/before-revit";

// Every section's words come from the Before Revit page document in Sanity
// (studio/schemaTypes/pages/before-revit.ts), each element falling back to
// its own (src/sanity/defaults/before-revit.ts): see src/sanity/content.ts.
// The navigation, the footer, the two price cards' looks and where every
// button leads stay here. Each element names the field it shows
// (data-page-field) so the Studio's Visual editor can outline it and write
// drafts into it.
const { t, list, lines } = reader(await pageDocument(Astro.locals.sanity, "beforeRevitPage"), D);

const steps = list<{ _key: string; label?: string; title?: string; text?: string }>("method.steps");

// a booking or enquiry button: the free call's calendar (BookCallDialog.astro,
// "book-call"), as Book a Call opens it (2026-11-05)
const BOOK = { type: "button", "data-booking-open": "book-call", "aria-haspopup": "dialog", "aria-controls": "book-call" };
---
<BaseLayout
  title="Before Revit — ADDD"
  description="Before Revit is an engagement for architecture practices reviewing their early-stage design workflow: what happens in the early stages of design, before the work moves into Revit or Archicad."
  pageName="Before Revit"
  doc={{ id: "beforeRevitPage" }}
>
<main class="page--grid">

  <!-- The opening (BeforeRevitHero.astro, 2026-11-04, after the
       reference): dark, the words large on the left, the exploded box
       glowing red on the right, held while the words scroll away, its frame
       then landing on the platform. "Inquire" goes to the Contact page;
       "View Pricing" glides down to the prices. The red block that stands
       under every service page's opening stays under it. -->
  <BeforeRevitHero heading={t("hero.heading")} lede={t("hero.lede")} statement={t("hero.statement")}>
    <Fragment slot="actions">
      <ActionButton {...BOOK}><span data-page-field="hero.primaryButton">{t("hero.primaryButton")}</span></ActionButton>
      <ActionButton href="#pricing" variant="secondary" arrow="down"><span data-page-field="hero.secondaryButton">{t("hero.secondaryButton")}</span></ActionButton>
    </Fragment>
  </BeforeRevitHero>

  <section class="section section--light" id="how-it-works">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="method.lede">{t("method.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="method.tagline">{t("method.tagline")}</p>
          <h2 class="h2" data-split="heading" data-page-field="method.heading">{t("method.heading")}</h2>
        </div>
      </div>

      <div class="steps" data-page-list="method.steps">
        {steps.map((step) => (
        <div class="steps__item" data-page-item={step._key}>
          <p class="tagline tagline--sm steps__label" data-page-item-field="label">{step.label}</p>
          <div class="steps__body">
            <h3 class="h4" data-page-item-field="title">{step.title}</h3>
            <p data-page-item-field="text">{step.text}</p>
          </div>
        </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The prices (2026-11-05, the Workflow Workshop's: PricingPlan.astro,
       plan.css): the head and Book a Free Call on the left over the three
       steps, Before Revit's card on the right, and under them two ink
       panels on to the Technology Blueprint and the Workflow Workshop (the
       second card's words, without its price) -->
  <section class="section plan-section" id="pricing">
    <div class="container">
      <PricingPlan
        tagline={t("pricing.tagline")}
        taglineField="pricing.tagline"
        heading={t("pricing.heading")}
        headingField="pricing.heading"
        lede={t("pricing.lede")}
        ledeField="pricing.lede"
        rowsLabel="The three steps"
        rows={steps.map((step, i) => ({ title: step.label, text: step.title, titleField: `method.steps.${i}.label`, textField: `method.steps.${i}.title` }))}
        plans={[{
          id: "plan-before-revit",
          field: "pricing.cards.0",
          title: t("pricing.cards.0.title"),
          badge: t("pricing.cards.0.badge"),
          prefix: t("pricing.cards.0.pricePrefix"),
          price: t("pricing.cards.0.price"),
          suffix: t("pricing.cards.0.priceSuffix"),
          caption: t("pricing.cards.0.subtitle"),
          label: t("pricing.cards.0.includesLabel"),
          includes: lines("pricing.cards.0.includes"),
          note: t("pricing.cards.0.note"),
          button: { label: t("pricing.cards.0.button"), attrs: BOOK },
        }]}
      >
        <BookCall slot="aside" />
        <PlanNext slot="next" links={[
          {
            title: t("pricing.blueprintTitle"),
            text: t("pricing.blueprintText"),
            button: t("pricing.blueprintButton"),
            href: "technology-blueprint.html",
            titleField: "pricing.blueprintTitle",
            textField: "pricing.blueprintText",
            buttonField: "pricing.blueprintButton",
          },
          {
            title: t("pricing.cards.1.title"),
            text: t("pricing.cards.1.subtitle"),
            button: t("pricing.cards.1.button"),
            href: "workshops-audits.html",
            titleField: "pricing.cards.1.title",
            textField: "pricing.cards.1.subtitle",
            buttonField: "pricing.cards.1.button",
          },
        ]} />
      </PricingPlan>
    </div>
  </section>

  <ClosingCta />
  <!-- Book a Call, floating at the screen's foot from past the hero to Book a
       Free Call (BookCallFloat.astro) -->
  <BookCallFloat />

</main>
</BaseLayout>
