---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClosingCta from "../components/ClosingCta.astro";
import InsightCard from "../components/InsightCard.astro";
import { pageDocument, reader } from "../sanity/content";
import { cardOf, indexMeta, type Insight } from "../sanity/insights";
import { ISSUES_QUERY } from "../sanity/queries";
import { newsletterPage as D, ISSUE_CARD_DEFAULTS, ISSUE_FILTER_DEFAULTS } from "../sanity/defaults/newsletter";

// The heading row's words come from the Newsletter page document in Sanity
// (studio/schemaTypes/pages/newsletter.ts), each falling back to the page's
// own (src/sanity/defaults/newsletter.ts): see src/sanity/content.ts. The
// cards are the newsletter issues, newest first, and the filter buttons
// their categories in order of first appearance; while there are no issues
// the page keeps the cards and filters it was built with.
const { sanity } = Astro.locals;
const [doc, items] = await Promise.all([pageDocument(sanity, "newsletterPage"), sanity.fetch<Insight[]>(ISSUES_QUERY)]);
const { t } = reader(doc, D);

const articles = items?.length ? items.map((item) => cardOf(item, indexMeta)) : ISSUE_CARD_DEFAULTS;
// One button per category, shown as written, matched in lowercase (the
// card's chip is its filter token: InsightCard.astro)
const filters = items?.length
  ? [...new Map(items.filter((item) => item.category).map((item) => [item.category!.toLowerCase(), item.category!])).entries()].map(([target, label]) => ({ target, label }))
  : ISSUE_FILTER_DEFAULTS;
---
<BaseLayout
  title="Newsletter — ADDD"
  description="ADDDitive, the ADDD newsletter on The Process of Architecture: the people, process and projects behind how technology actually gets used to make architecture."
  pageName="Newsletter"
  doc={{ id: "newsletterPage" }}
>
<main class="page--grid">

  <section class="pg-hero">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="hero.lede">{t("hero.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="hero.tagline">{t("hero.tagline")}</p>
          <h1 class="h2" data-page-field="hero.heading">{t("hero.heading")}</h1>
        </div>
      </div>

      <!-- The filters and the grid share one group: the buttons and the
           cards they act on have to sit inside the same [data-filter-group].
           Several categories can be held at once, and a card shows if it
           matches any of them. -->
      <div class="insight-archive" data-filter-group data-filter-target-match="multi" data-filter-name-match="multi">
        <div class="filters">
          <button type="button" data-filter-target="all">All articles</button>
          {filters.map((filter, i) => (
          <Fragment>{i > 0 && "\n          "}<button type="button" data-filter-target={filter.target}>{filter.label}</button></Fragment>
          ))}
          <button type="button" class="filters__reset" data-filter-target="reset">Clear filters</button>
        </div>

        <div class="insight-grid">
          {articles.map((article) => <InsightCard {...article} filter />)}
        </div>
      </div>
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
