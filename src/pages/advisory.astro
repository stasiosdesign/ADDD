---
import BaseLayout from "../layouts/BaseLayout.astro";
import Accordion from "../components/Accordion.astro";
import ActionButton from "../components/ActionButton.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { pageDocument, reader } from "../sanity/content";
import { advisoryPage as D } from "../sanity/defaults/advisory";

// Every section's words come from the ADDDvisory page document in Sanity
// (studio/schemaTypes/pages/advisory.ts), each element falling back to its
// own (src/sanity/defaults/advisory.ts): see src/sanity/content.ts. The
// navigation, the footer, the comparison table's column headings and where
// every button leads stay here. Each element names the field it shows
// (data-page-field) so the Studio's Visual editor can outline it and write
// drafts into it; each list names its blocks (data-page-list, data-page-item).
const { t, list, lines, bg } = reader(await pageDocument(Astro.locals.sanity, "advisoryPage"), D);

const structureTiles = list<{ _key: string; title?: string; text?: string }>("structure.tiles");
const impactTiles = list<{ _key: string; number?: string; tagline?: string; title?: string; text?: string }>("impact.tiles");
const rows = list<{ _key: string; label?: string; ours?: string; others?: string }>("difference.rows");
const faq = list<{ _key: string; question?: string; answer?: string }>("faq.questions");

// The four theme squares keep their shape, with a picture behind each once one is set
const square = (path: string) => {
  const picture = bg(path);
  return picture ? `aspect-ratio:1/1;${picture}` : "aspect-ratio:1/1";
};

// The two price cards, by position: the membership, then the Technology Blueprint
const card = (i: number) => ({
  title: t(`pricing.cards.${i}.title`),
  subtitle: t(`pricing.cards.${i}.subtitle`),
  pricePrefix: t(`pricing.cards.${i}.pricePrefix`),
  price: t(`pricing.cards.${i}.price`),
  priceSuffix: t(`pricing.cards.${i}.priceSuffix`),
  note: t(`pricing.cards.${i}.note`),
  includes: lines(`pricing.cards.${i}.includes`),
  button: t(`pricing.cards.${i}.button`),
});
const membership = card(0);
const blueprint = card(1);
---
<BaseLayout
  title="ADDDvisory — ADDD"
  description="ADDDvisory is ongoing strategic guidance for architecture practices, after or alongside the main strategic work: a regular place to make sense of AI, BIM, software, workflows and digital priorities."
  pageName="ADDDvisory"
  doc={{ id: "advisoryPage" }}
>
<main class="page--dark page--grid">

  <section class="pg-hero pg-hero--dark">
    <div class="container">
      <div class="pg-hero__grid">
        <div class="pg-hero__col">
          <p class="tagline" data-page-field="hero.tagline">{t("hero.tagline")}</p>
          <h1 class="h1" data-page-field="hero.heading">{t("hero.heading")}</h1>
        </div>
        <div class="pg-hero__col">
          <p class="text-md" data-page-field="hero.lede">{t("hero.lede")}</p>
          <div class="actions actions--pair">
            <ActionButton href="contact.html"><span data-page-field="hero.primaryButton">{t("hero.primaryButton")}</span></ActionButton>
            <ActionButton href="#pricing" variant="secondary"><span data-page-field="hero.secondaryButton">{t("hero.secondaryButton")}</span></ActionButton>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="band band--wide"></div>

  <section class="section section--dark">
    <div class="container">
      <p class="statement" data-page-field="statement.statement">{t("statement.statement")}</p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="structure.lede">{t("structure.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="structure.tagline">{t("structure.tagline")}</p>
          <h2 class="h2" data-page-field="structure.heading">{t("structure.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--3 grid--mt" data-page-list="structure.tiles">
        {structureTiles.map((item) => (
        <article class="tile" data-page-item={item._key}>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
        </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="themes.lede">{t("themes.lede")}</p>
        <div class="section-title__body">
          <h2 class="h2" data-page-field="themes.heading">{t("themes.heading")}</h2>
        </div>
      </div>
      <div class="grid grid--4 grid--mt">
        <div class="ph" style={square("themes.image1")} data-page-bg="themes.image1"></div>
        <div class="ph" style={square("themes.image2")} data-page-bg="themes.image2"></div>
        <div class="ph" style={square("themes.image3")} data-page-bg="themes.image3"></div>
        <div class="ph" style={square("themes.image4")} data-page-bg="themes.image4"></div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="impact.lede">{t("impact.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="impact.tagline">{t("impact.tagline")}</p>
          <h2 class="h2" data-page-field="impact.heading">{t("impact.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--4 grid--mt" data-page-list="impact.tiles">
        {impactTiles.map((item) => (
        <article class="tile" data-page-item={item._key}>
          <p class="tile__num" data-page-item-field="number">{item.number}</p>
          <p class="tagline tagline--sm" data-page-item-field="tagline">{item.tagline}</p>
          <h3 class="h4" data-page-item-field="title">{item.title}</h3>
          <p data-page-item-field="text">{item.text}</p>
        </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="difference.lede">{t("difference.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="difference.tagline">{t("difference.tagline")}</p>
          <h2 class="h2" data-page-field="difference.heading">{t("difference.heading")}</h2>
        </div>
      </div>

      <table class="table">
        <thead>
          <tr><th></th><th>ADDDvisory</th><th>Other</th></tr>
        </thead>
        <tbody data-page-list="difference.rows">
          {rows.map((row) => (
          <tr data-page-item={row._key}><td data-page-item-field="label">{row.label}</td><td data-page-item-field="ours">{row.ours}</td><td data-page-item-field="others">{row.others}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--dark" id="pricing">
    <div class="container">
      <div class="section-title">
        <p class="text-md" data-page-field="pricing.lede">{t("pricing.lede")}</p>
        <div class="section-title__body">
          <p class="tagline" data-page-field="pricing.tagline">{t("pricing.tagline")}</p>
          <h2 class="h2" data-page-field="pricing.heading">{t("pricing.heading")}</h2>
        </div>
      </div>

      <div class="grid grid--2 grid--mt">
        <article class="price-card">
          <div class="stack stack--16">
            <h3 class="h4" data-page-field="pricing.cards.0.title">{membership.title}</h3>
            <p data-page-field="pricing.cards.0.subtitle">{membership.subtitle}</p>
            <div class="price">{membership.pricePrefix && <Fragment><span data-page-field="pricing.cards.0.pricePrefix">{membership.pricePrefix}</span> </Fragment>}<span class="price__amount" data-page-field="pricing.cards.0.price">{membership.price}</span>{membership.priceSuffix && <span data-page-field="pricing.cards.0.priceSuffix">{membership.priceSuffix}</span>}</div>
            {membership.note && <p class="text-sm" data-page-field="pricing.cards.0.note">{membership.note}</p>}
          </div>
          <ul class="check-list">
            {membership.includes.map((line, j) => (
            <li data-page-field={`pricing.cards.0.includes.${j}`}>{line}</li>
            ))}
          </ul>
          <ActionButton href="contact.html"><span data-page-field="pricing.cards.0.button">{membership.button}</span></ActionButton>
        </article>

        <article class="price-card">
          <div class="stack stack--16">
            <h3 class="h4" data-page-field="pricing.cards.1.title">{blueprint.title}</h3>
            <p data-page-field="pricing.cards.1.subtitle">{blueprint.subtitle}</p>
            <div class="price">{blueprint.pricePrefix && <Fragment><span data-page-field="pricing.cards.1.pricePrefix">{blueprint.pricePrefix}</span> </Fragment>}<span class="price__amount" data-page-field="pricing.cards.1.price">{blueprint.price}</span>{blueprint.priceSuffix && <span data-page-field="pricing.cards.1.priceSuffix">{blueprint.priceSuffix}</span>}</div>
            {blueprint.note && <p class="text-sm" data-page-field="pricing.cards.1.note">{blueprint.note}</p>}
          </div>
          <ul class="check-list">
            {blueprint.includes.map((line, j) => (
            <li data-page-field={`pricing.cards.1.includes.${j}`}>{line}</li>
            ))}
          </ul>
          <ActionButton href="technology-blueprint.html" variant="secondary"><span data-page-field="pricing.cards.1.button">{blueprint.button}</span></ActionButton>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="case__quote-inner" style="margin:0 auto">
        <blockquote class="quote">&ldquo;<span data-page-field="quote.quote">{t("quote.quote")}</span>&rdquo;</blockquote>
        <div class="avatar">
          <div class="avatar__img" style="background:#f2f2f2"></div>
          <div>
            <p class="avatar__name" data-page-field="quote.name">{t("quote.name")}</p>
            <p data-page-field="quote.role">{t("quote.role")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <h2 class="h2" data-page-field="faq.heading">{t("faq.heading")}</h2>
      <Accordion id="faq" items={faq} field="faq.questions" />
    </div>
  </section>

  <ClosingCta />

</main>
</BaseLayout>
