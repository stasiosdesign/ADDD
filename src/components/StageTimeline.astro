---
/*
  Stages on a timeline, drawn as a plan's chart (after the "Process and
  Pricing" chart of a reference of 2026-11-04, in the site's own type,
  hairlines and restrained corners). One layout for every timeline on the
  site, so a change here reaches them all: the Workflow Workshop's
  "Workshop Process" (its four phases across the top) and the Technology
  Blueprint's roadmap (its weeks across the top).

  Second pass (2026-11-04), cleaner and easier to follow:

    - across the top, the scale: its units by name (weeks, phases), each
      over a column, the columns parted by hairlines down the chart
    - a row per stage, under a hairline; in it the stage's box over the
      units it takes (start, span), as long as it lasts. The box reads
      down: its number, its name (lane) or when it runs (when), then its
      title, and a fine plus. (The narrow strip down the rows' start, with
      the number read up it, is gone: the number and the name are in the
      box, read across.)
    - the progression: each box joined to the one before it by a line
      from the earlier box's end, down the column's edge between them, and
      on into this box's start, an arrowhead where it meets it
    - a stage opened (pointed at, or pressed: stage-timeline.js) shows its
      card, over the rows below it (above it, for the lower half of the
      rows, so the chart needs no room kept under it): its photograph, its
      line, and the more it tells. The columns it takes are lit down the
      chart, a red rule over them on the scale, and their names on the
      scale brighten: where in the run it stands, and for how long.

  Styles: stage-timeline.css (dark: the version for an ink section). Below
  992px the stages stand one under another, each card open under its box.

  fields: the Studio fields each stage's words come from, for the Visual
  editor; a unit of the scale can name its own (field).
*/
export interface Stage {
  /** the row's name, in its box after the number */
  lane?: string;
  /** when it runs, in its box after the number (e.g. "Weeks 2–4") */
  when?: string;
  title?: string;
  text?: string;
  more?: string;
  image?: { src: string; alt?: string };
  /** the first unit the stage takes (from 0) and how many */
  start?: number;
  span?: number;
  fields?: { lane?: string; when?: string; title?: string; text?: string; more?: string };
}
type Unit = string | { label?: string; field?: string };
interface Props {
  id: string;
  stages: Stage[];
  /** the units across the top, by name (e.g. Week 1 … Week 8) */
  scale: Unit[];
  /** the label over the extra words, in a card */
  moreLabel?: string;
  /** on a dark ground: white lines, the boxes faint on the ink */
  dark?: boolean;
}
const { id, stages, scale, moreLabel = "In more detail", dark = false } = Astro.props;
const units = Math.max(1, scale.length);
const unitOf = (u: Unit) => (typeof u === "string" ? { label: u, field: undefined } : u);
const pad = (n: number) => String(n).padStart(2, "0");
// each stage's columns; whether its card hangs from the box's end rather
// than its start (a box in the right half of the run, so the card stays
// inside it); and whether it opens upwards (the lower half of the rows)
const placed = stages.map((stage, i) => {
  const start = Math.max(0, Math.min(units - 1, stage.start ?? i));
  const span = Math.max(1, Math.min(units - start, stage.span ?? 1));
  return {
    start,
    span,
    column: `${start + 1} / span ${span}`,
    end: start + span / 2 > units / 2,
    up: stages.length > 2 && i >= Math.ceil(stages.length / 2),
  };
});
---
<div class:list={["stage-timeline", { "is--dark": dark }]} data-stage-timeline style={`--tl-count:${units}`}>
  <div class="stage-timeline__chart">
    <!-- the columns' hairlines, and the open stage's columns lit -->
    <span class="stage-timeline__columns" aria-hidden="true"></span>
    <span class="stage-timeline__band" aria-hidden="true"></span>
    <ol class="stage-timeline__scale" role="list" aria-hidden="true">
      {scale.map((u) => {
        const unit = unitOf(u);
        return <li class="stage-timeline__unit" data-stage-unit data-page-field={unit.field}>{unit.label}</li>;
      })}
    </ol>
    <ol class="stage-timeline__stages" role="list">
      {stages.map((stage, i) => (
      <li class:list={["stage-timeline__stage", { "is--first": i === 0 }]} style={`--i:${i};--at:${placed[i].start};--span:${placed[i].span}`} data-stage>
        <article class="stage-timeline__block" style={`grid-column:${placed[i].column}`} data-stage-block>
          <p class="stage-timeline__meta">
            <span class="stage-timeline__num">{pad(i + 1)}</span>
            {stage.lane && <span class="stage-timeline__lane" data-page-field={stage.fields?.lane}>{stage.lane}</span>}
            {stage.when && <span class="stage-timeline__when" data-page-field={stage.fields?.when}>{stage.when}</span>}
          </p>
          <h3 class="stage-timeline__title">
            <button type="button" class="stage-timeline__toggle" aria-expanded="false" aria-controls={`${id}-card-${i + 1}`} data-stage-toggle>
              <span data-page-field={stage.fields?.title}>{stage.title}</span>
            </button>
          </h3>
          <span class="stage-timeline__icon" aria-hidden="true"></span>
          <div class:list={["stage-timeline__card", { "is--end": placed[i].end, "is--up": placed[i].up }]} id={`${id}-card-${i + 1}`} data-stage-card>
            {stage.image && <img class="stage-timeline__photo" src={stage.image.src} alt={stage.image.alt ?? ""} width="112" height="112" loading="lazy" decoding="async" draggable="false" />}
            <p class="stage-timeline__text" data-page-field={stage.fields?.text}>{stage.text}</p>
            {stage.more && (
              <div class="stage-timeline__more">
                <p class="stage-timeline__more-label">{moreLabel}</p>
                <p data-page-field={stage.fields?.more}>{stage.more}</p>
              </div>
            )}
          </div>
        </article>
      </li>
      ))}
    </ol>
  </div>
</div>
