---
/*
  Stages on a timeline (2026-11-16, after the user's reference: a
  staircase). One layout for every timeline on the site, so a change here
  reaches them all: the Workflow Workshop's "Workshop Process", the
  Technology Blueprint's roadmap and AEC Tech Partners' process.

    - a row per stage, its number at the left ("01 /"), a dashed rule
      across the chart over it;
    - in the row, the stage's box over the units of the run it takes
      (start, span: the weeks or phases, not shown as a scale), a solid
      rule along its top with a square at its start, its title in
      capitals and when it runs beside it, then its items, each with a
      small square: ink for what ADDD does, grey for what your team does,
      hollow for what is optional (the key under the chart);
    - the boxes step down and across the run, so the chart reads as the
      run itself.

  Its stages come from one Studio field (timelineField, 2026-11-17): each
  a title, a length drawn to scale, its timing words and its points. No
  script: nothing opens; live-preview.ts redraws it from drafts.
  Styles: stage-timeline.css (dark: the version for an ink section).
  Below 992px every box takes the row's width.

*/
import type { LaidOutStage } from "../sanity/timeline";
interface Props {
  id: string;
  /** the stages, laid out (layoutTimeline in src/sanity/timeline.ts): each
      placed over its start and span, in half units of its run */
  timeline: { units: number; stages: LaidOutStage[] };
  /** the Studio field it comes from (journey.timeline): the Visual editor
      selects the whole timeline as one block, and redraws it from drafts */
  field?: string;
  /** on a dark ground: white rules and words, the boxes faint on the ink */
  dark?: boolean;
  /** the key's words, and the section they come from (its keyAddd,
      keyYou and keyOptional) */
  keyLabels?: { addd?: string; you?: string; optional?: string };
  keyField?: string;
}
const { id, timeline, field, dark = false, keyLabels = {}, keyField } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const kinds = new Set<string>(timeline.stages.flatMap((s) => s.items.map((item) => item.by)));
const KEY = [
  ["addd", keyLabels.addd || "ADDD", "keyAddd"],
  ["you", keyLabels.you || "Your team", "keyYou"],
  ["optional", keyLabels.optional || "Optional", "keyOptional"],
].filter(([k]) => kinds.has(k));
---
<div class:list={["stage-timeline", { "is--dark": dark }]} id={id} style={`--tl-count:${timeline.units}`} data-page-block={field} data-page-timeline={field}>
  <ol class="stage-timeline__rows" role="list">
    {timeline.stages.map((stage, i) => (
    <li class="stage-timeline__row" data-tl-row>
      <span class="stage-timeline__num" aria-hidden="true" data-tl-num>{pad(i + 1)} /</span>
      <article class="stage-timeline__box" style={`grid-column:${stage.start + 2} / span ${stage.span}`} data-tl-box>
        <h3 class="stage-timeline__title">
          <span data-tl-title>{stage.title}</span>
          <span class="stage-timeline__when" data-tl-when hidden={!stage.when}>{stage.when}</span>
        </h3>
        <ul class="stage-timeline__items" role="list" data-tl-items>
          {stage.items.map((item) => <li class={`is--${item.by}`}>{item.label}</li>)}
        </ul>
      </article>
    </li>
    ))}
  </ol>
  {KEY.length > 1 && (
  <ul class="stage-timeline__key" role="list" aria-label="Key">
    {KEY.map(([k, label, name]) => <li class={`is--${k}`} data-page-field={keyField ? `${keyField}.${name}` : undefined}>{label}</li>)}
  </ul>
  )}
</div>
