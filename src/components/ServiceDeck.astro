---
/*
  Folder cards in a column beside a held title (styles:
  src/styles/service-deck.css): from 992px the title on the left, held
  under the nav while the cards go by, the cards one under another in the
  middle and a word of its own on the right; below it the title over the
  cards. Each card is a folder (DeckFolder.astro). Nothing in it moves with
  the scroll.

  The homepage's four routes: pass the routes' words from the Studio
  (cards: title, text) and where each leads (hrefs); the lists, kinds and
  formats are the routes' own (services.ts), the lists the same each
  service page's hero shows. Each card is a link to its page, which opens
  with the site's wipe, as every link does.

  Any other set of folders: pass them ready made (folders), with the
  heading's field (headingField): the Workflow Workshop's three, each
  opening a document (FolderDocument.astro).

  Under the title, held with it, a line (lede, ledeField) and a button
  (button: the site's CTA, ActionButton.astro), either or both: the
  homepage's "Free Tech Stacks".
*/
import ActionButton from "./ActionButton.astro";
import DeckFolder, { type Folder } from "./DeckFolder.astro";
import { SERVICES } from "./services";

interface Card {
  tagline?: string;
  title?: string;
  text?: string;
}
interface Props {
  /** the section's title, held beside the cards */
  heading?: string;
  /** its Studio field, for the Visual editor */
  headingField?: string;
  /** a line under the title, held with it */
  lede?: string;
  ledeField?: string;
  /** a button under the title (and its line), held with it */
  button?: { href: string; label: string; field?: string };
  /** a word set beside the cards on the right, from 992px (held there as
      the title is) */
  aside?: string;
  /** the homepage's routes: their words, and where each leads */
  cards?: Card[];
  hrefs?: string[];
  /** or the folders themselves */
  folders?: Folder[];
}
const { heading, headingField = "routes.heading", lede, ledeField, button, aside, cards = [], hrefs = [], folders: own } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const folders: Folder[] = own ?? cards.map((card, i) => {
  const route = SERVICES[i];
  return {
    n: i + 1,
    label: `Service N°${pad(i + 1)}`,
    meta: route?.format,
    title: card.title,
    text: card.text,
    titleField: `routes.cards.${i}.title`,
    textField: `routes.cards.${i}.text`,
    covers: route?.covers,
    kind: route?.kind,
    go: "View service",
    action: `View ${card.title || "the service"}`,
    href: hrefs[i] ?? route?.href ?? "contact.html",
  };
});
---
<!-- the title and the word held over every card but the last (from
     992px, in runs of their own: service-deck.css, --deck-count) -->
<div class="service-deck" style={`--deck-count:${folders.length}`}>
  {heading && (
    <div class="service-deck__hold">
      {lede || button ? (
        <div class="service-deck__lead">
          <h2 class="service-deck__title" data-split="heading" data-page-field={headingField}>{heading}</h2>
          {lede && <p class="service-deck__lede" data-page-field={ledeField}>{lede}</p>}
          {button && (
            <div class="service-deck__actions">
              <ActionButton href={button.href}><span data-page-field={button.field}>{button.label}</span></ActionButton>
            </div>
          )}
        </div>
      ) : (
        <h2 class="service-deck__title" data-split="heading" data-page-field={headingField}>{heading}</h2>
      )}
    </div>
  )}
  {aside && <div class="service-deck__hold is--aside"><p class="service-deck__aside" aria-hidden="true">{aside}</p></div>}
  <div class="service-deck__grid">
    {folders.map((folder, i) => <DeckFolder {...folder} index={i} />)}
  </div>
</div>
