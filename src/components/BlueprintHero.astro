---
/*
  The Technology Blueprint's opening (2026-11-04), after the reference the
  user supplied: the label, the heading, the standfirst and the buttons on
  the left (Grid Columns 1–5), and on the right an isometric network of
  the practices' systems, a Hairline figure (blueprint-hero.js,
  network-figure.js): five keys on plinths, each with a practice's mark on
  its coin (the homepage's "Practices we've worked with"), joined by routes
  with rounded turns, a signal running along them into the hub; the key
  under the pointer rises and lights its routes. The whole opening stands
  on the Blueprint's own dash-dot lattice, set out from the figure's ground
  so the routes run on its lines. The red block under it shows across the
  screen's foot, as on the other service pages (SplitHero.astro).

  The words come from the page's Studio fields (labelField, headingField,
  ledeField); the buttons are the slot (actions). Styles: pages.css
  ("Technology Blueprint hero"). Below 992px the figure stands under the
  words.
*/
interface Props {
  label?: string;
  heading?: string;
  lede?: string;
  labelField?: string;
  headingField?: string;
  ledeField?: string;
}
const {
  label,
  heading,
  lede,
  labelField = "hero.tagline",
  headingField = "hero.heading",
  ledeField = "hero.lede",
} = Astro.props;
---
<section class="bp-hero" data-blueprint-hero>
  <div class="bp-hero__ground" data-blueprint-ground data-iso-line="dash" data-iso-module="40" data-iso-ground=".bp-hero__svg" aria-hidden="true"></div>
  <div class="bp-hero__text">
    {label && <p class="split-hero__label" data-page-field={labelField}>{label}</p>}
    <h1 class="bp-hero__heading" data-page-field={headingField}>{heading}</h1>
    {lede && <p class="bp-hero__lede" data-page-field={ledeField}>{lede}</p>}
    <div class="bp-hero__actions"><slot name="actions" /></div>
  </div>
  <div class="bp-hero__figure">
    <div class="bp-hero__stage" data-hairline>
      <svg class="bp-hero__svg" viewBox="0 0 400 320" fill="none" focusable="false" aria-hidden="true"></svg>
    </div>
  </div>
</section>
<div class="split-hero__red" aria-hidden="true"></div>
