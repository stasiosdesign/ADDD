---
/*
  The closing call to action every content page ends on. Third design
  (2026-11-16, at the user's word): the homepage statement's background
  turned to the light. On a white ground its dots are drawn as the
  statement's are, as a grid of cells inside a margin of plain dots, the
  same pitch and the same cell (cta-tiles.js, after cell-grid.js), and six
  software marks stand each in a cell, its box over the cell's lines and
  its mark the statement's size, around a short statement set large in
  the middle, one button under it. Now and then one of them has a fine red
  line round its cell and its mark changes to another, never on the
  scroll, only while the section is on the screen, never with reduced
  motion. Styles: styles.css, "CTA". The ring diagram it replaces
  (cta-diagram.js) is no longer used.

  The words are the Closing call to action section of the Home page document
  in Sanity (src/sanity/defaults/home.ts while nothing is published), so one
  edit there changes every page that ends with it. A page with its own call
  to action — For AEC Tech Firms — passes its own `doc` and field. A page
  can set its own button in place of the default (single: the Workflow
  Workshop's "Start a Tech Blueprint"), a link or, with attrs, a button
  (Before Revit's, opening the free call's calendar).
*/
import ActionButton, { type ActionButtonShape } from "./ActionButton.astro";
import { pageDocument, reader, siteDocument, type Doc } from "../sanity/content";
import { homePage } from "../sanity/defaults/home";

interface Props {
  /** The document and section the words come from: the Home page's closingCta unless a page has its own. */
  doc?: { id: string; defaults: Doc; field?: string };
  /** The button: where it leads (default: the Home page's closingCta.primaryHref) and any attributes of its own. */
  primary?: { href?: string; [attr: string]: unknown };
  /** Kept for the pages that pass it; the call has one button now. */
  secondary?: { href: string; [attr: string]: unknown };
  /** The button's accent: the site's red, or the AEC Tech Firms blue. */
  accent?: "red" | "blue";
  /** The button's form (ActionButton.astro): the site's block, the pill, or the frame. */
  shape?: ActionButtonShape;
  /** A button of the page's own in place of the default: where it leads,
      its words, and the page's own field and document they come from, for
      the Visual editor. */
  single?: { href?: string; label: string; field?: string; doc?: string; attrs?: Record<string, unknown> };
}

const {
  doc = { id: "homePage", defaults: homePage as Doc },
  primary = {},
  accent = "red",
  shape,
  single,
} = Astro.props;
const field = (doc as { field?: string }).field ?? "closingCta";

// The marks, the vendors' own files in their own colours
// (public/assets/logos/software/): the first six stand in the tiles, and
// the rest come in as the tiles change (cta-tiles.js).
// The software marks that turn in the tiles, in order: the Home page
// document's closingCta.marks in Sanity (2026-11-16), shared by every page,
// falling back to the files the block was built with
// (src/sanity/defaults/home.ts). The tiles' places stay here.
const site = reader(await siteDocument(Astro.locals), homePage as Doc);
const LOGOS = site.items("closingCta.marks").map((mark) => mark.img("image", 96).src).filter(Boolean);
const primaryHref = (primary.href as string | undefined) || site.t("closingCta.primaryHref") || "/stack-diagnostic";
// Each tile takes one cell of the grid the dots are drawn as (cta-tiles.js),
// as the homepage statement's marks do (index.astro, PHOTOS; cell-grid.js):
// where it stands among the grid's inner cells (never its outer ring), as
// shares across and down them, 0 to 1, from 992px (at), narrower (narrow)
// and on a phone (phone, or null for none there): the statement's own
// places, three either side in a loose zig-zag, the right side the left
// turned half round. Kept clear of the words and of each other.
// A tablet keeps four, one at each corner of the inner cells (tablet:
// false for the two it leaves out); a phone four of its own.
type Tile = { at: [number, number]; narrow: [number, number]; tablet?: false; phone?: [number, number] | null };
const TILES: Tile[] = [
  { at: [0.12, 0], narrow: [0, 0] },
  { at: [0, 0.4], narrow: [1, 0.12], tablet: false, phone: [1, 0.12] },
  { at: [0.06, 1], narrow: [0, 1], phone: null },
  { at: [0.94, 0], narrow: [1, 0], phone: null },
  { at: [1, 0.6], narrow: [0, 1], tablet: false, phone: [0, 1] },
  { at: [0.88, 1], narrow: [1, 1] },
];
const { t } = doc.id === "homePage" && doc.defaults === (homePage as Doc) ? site : reader(await pageDocument(Astro.locals.sanity, doc.id), doc.defaults);
// The block names its document for the Visual editor: the Home page's,
// unless the page passed its own
const scope = { "data-page-doc": doc.id, "data-page-type": doc.id };
// A line under the heading, where the page's section has one
const lede = t(`${field}.lede`);
---
<section class:list={["cta", { "cta--blue": accent === "blue" }]} {...scope} data-cta-tiles={JSON.stringify(LOGOS)}>
  <!-- the ground: a field of dots the section's whole width and height,
       drawn as a grid of cells inside a margin of plain dots (cta-tiles.js) -->
  <span class="cta__dots dot-grid band-field" aria-hidden="true"></span>
  <!-- the tiles, each in a cell of the grid the dots are drawn as
       (cta-tiles.js), its box over the cell's lines, its mark in the
       middle; a red hairline drawn round it when it changes: decoration -->
  <div class="cta__tiles" aria-hidden="true">
    {TILES.map((tile, i) => (
      <span
        class:list={["cta__tile", { "is--no-tablet": tile.tablet === false, "is--no-phone": tile.phone === null }]}
        data-cta-tile
        data-at={tile.at.join(" ")}
        data-at-narrow={tile.narrow.join(" ")}
        data-at-phone={tile.phone ? tile.phone.join(" ") : undefined}
      >
        <span class="cta__tile-line"></span>
        <span class="cta__tile-win">
          <img class="cta__tile-mark is--a" src={LOGOS[i % LOGOS.length]} alt="" width="48" height="48" loading="lazy" decoding="async" draggable="false">
          <img class="cta__tile-mark is--b" src={LOGOS[i % LOGOS.length]} alt="" width="48" height="48" loading="lazy" decoding="async" draggable="false">
        </span>
      </span>
    ))}
  </div>
  <div class="cta__grid">
    <div class="cta__body">
      <h2 class="h1 cta__heading" data-split="heading" data-page-field={`${field}.heading`}>{t(`${field}.heading`)}</h2>
      {lede && <p class="text-md cta__lede" data-page-field={`${field}.lede`}>{lede}</p>}
      <div class="actions">
        {single ? (
        <ActionButton href={single.href} shape={shape} {...(single.attrs ?? {})}><span data-page-field={single.field} data-page-doc={single.doc} data-page-type={single.doc}>{single.label}</span></ActionButton>
        ) : (
        <ActionButton {...primary} href={primaryHref} shape={shape}><span data-page-field={`${field}.primaryButton`}>{t(`${field}.primaryButton`)}</span></ActionButton>
        )}
      </div>
    </div>
  </div>
</section>
