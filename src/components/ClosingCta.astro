---
/*
  The closing call to action every content page ends on (2026-11-04, after
  the reference the user supplied): on the FAQs' field of dots, a diagram
  the window's full width of eight software marks in white rings, their
  thin lines turning in to the ADDD mark alone in the middle, all set out
  on the dots, and under the mark the heading, a
  line where the page has one, and the buttons, all centred (styles:
  styles.css, "CTA"; held to the dots by cta-diagram.js). Since 2026-11-04
  nothing in it is drawn in or revealed: the drawing, the heading and the
  buttons are all there as soon as the section is on the screen, so a fast
  scroll never passes it empty. The newsletter signup is
  in the footer (Footer.astro).

  After a light FAQ (the Technology Blueprint, the Workflow Workshop) the
  two sections are one ground: the call's dots carry on the FAQ's lattice
  across the boundary (data-dot-follow), the diagram held to its rows, and
  the lines that rise out of the call run on up into the FAQ's foot,
  fading; elsewhere they fade out before the call's top.

  The words are the Closing call to action section of the Home page document
  in Sanity (src/sanity/defaults/home.ts while nothing is published), so one
  edit there changes every page that ends with it. A page with its own call
  to action — For AEC Tech Firms, with its partnership routes — passes its
  own `doc` and field, so the two audiences never share one. A page can
  set one button of its own in place of the pair (single: the Workflow
  Workshop's "Start a Tech Blueprint"), a link or, with attrs, a button
  (Before Revit's, opening the free call's calendar). Where the buttons
  lead stays here.
*/
import ActionButton, { type ActionButtonShape } from "./ActionButton.astro";
import { pageDocument, reader, type Doc } from "../sanity/content";
import { homePage } from "../sanity/defaults/home";

interface Props {
  /** The document and section the words come from: the Home page's closingCta unless a page has its own. */
  doc?: { id: string; defaults: Doc; field?: string };
  primary?: { href: string; [attr: string]: unknown };
  secondary?: { href: string; [attr: string]: unknown };
  /** The primary's accent: the site's red, or the AEC Tech Firms blue. */
  accent?: "red" | "blue";
  /** The buttons' form (ActionButton.astro): the site's block, the pill, or the frame. */
  shape?: ActionButtonShape;
  /** One button in place of the pair (the Workflow Workshop's "Start a Tech
      Blueprint"): where it leads, its words, and the page's own field and
      document they come from, for the Visual editor. */
  single?: { href?: string; label: string; field?: string; doc?: string; attrs?: Record<string, unknown> };
}

const {
  doc = { id: "homePage", defaults: homePage as Doc },
  primary = { href: "stack-diagnostic.html" },
  secondary = { href: "contact.html" },
  accent = "red",
  shape,
  single,
} = Astro.props;
const field = (doc as { field?: string }).field ?? "closingCta";

// The diagram over the call (2026-11-04, after the reference the user
// supplied): eight software marks in white rings, four either side, each
// joined to the ADDD mark in the middle by a thin line that leaves it along
// one level line (the bus), turns off at 45° and runs level into its ring,
// every turn rounded; and each runs on out past its ring, away from the
// middle, turning again, until it leaves the screen at the side or rises
// out of the call towards the section above, fading as it goes. In the
// reference's own units: the bus 240 down from the call's top, the rings 22
// round, the mark 68 across. styles.css sizes a unit (--u) so the whole
// stands on the section's field of dots (cta-diagram.js holds its bus to a
// row of them).
//
// Third pass (2026-11-04): no longer two mirror images. The two sides
// balance but differ: on each, the line that leaves the bus first climbs
// highest, so no two lines cross; the left has two lines rising out of the
// call, the right one; the others leave by the sides at different heights.
// Every ring, turn and line is set out in steps of the field of dots (a
// step, STEP units, is the dots' pitch), across from the column either side
// of the page's middle (the FAQs' columns stand either side of it, so the
// mark, in the middle, stands between two and every x below is a half
// step), down from the bus, which runs along a row; the layout was checked
// for crossings, near misses and each ring's and name's clearance by a
// script, kept with its notes in the session that made it.
const MID = 1800;
const BUS = 240;
const RING = 22;
const STEP = 12;
const LOGO = 68;
// how far above the call's top the drawing reaches (its risers, faded),
// and how far down it runs, in units
const RISE = 180;
const DEPTH = 560;
// out past either side: further than the widest screen shows
const FAR = 150;
// the risers' tops, in steps up from the bus
const TOP = -32;
type Pt = [number, number];
const at = ([sx, sy]: Pt): Pt => [MID + sx * STEP, BUS + sy * STEP];
// each mark: its ring's middle, its route from the middle out to it (the
// ring's middle last), and its line on out past it (the ring's middle
// first), in steps; the left four from the top, then the right four
const LAYOUT: { name: string; src: string; w?: number; h?: number; at: Pt; route: Pt[]; out: Pt[] }[] = [
  { name: "Bluebeam", src: "/assets/logos/software/bluebeam-mark.svg", w: 20, h: 20, at: [-21.5, -14], route: [[0, 0], [-4.5, 0], [-18.5, -14], [-21.5, -14]], out: [[-21.5, -14], [-29.5, -14], [-34.5, -19], [-34.5, TOP]] },
  { name: "Rhino", src: "/assets/logos/software/rhino-icon.svg", at: [-37.5, -9], route: [[0, 0], [-8.5, 0], [-17.5, -9], [-37.5, -9]], out: [[-37.5, -9], [-44.5, -9], [-50.5, -15], [-50.5, TOP]] },
  { name: "Adobe", src: "/assets/logos/software/adobe.svg", at: [-31.5, -3], route: [[0, 0], [-13.5, 0], [-16.5, -3], [-31.5, -3]], out: [[-31.5, -3], [-42.5, -3], [-47.5, 2], [-FAR, 2]] },
  { name: "Figma", src: "/assets/logos/software/figma.svg", at: [-28.5, 6], route: [[0, 0], [-19.5, 0], [-25.5, 6], [-28.5, 6]], out: [[-28.5, 6], [-34.5, 6], [-41.5, 13], [-FAR, 13]] },
  { name: "ChatGPT", src: "/assets/logos/software/chatgpt.svg", at: [36.5, -14], route: [[0, 0], [4.5, 0], [18.5, -14], [36.5, -14]], out: [[36.5, -14], [44.5, -14], [48.5, -18], [48.5, TOP]] },
  { name: "Notion", src: "/assets/logos/software/notion.svg", at: [21.5, -8], route: [[0, 0], [8.5, 0], [16.5, -8], [21.5, -8]], out: [[21.5, -8], [46.5, -8], [49.5, -11], [FAR, -11]] },
  { name: "Slack", src: "/assets/logos/software/slack.svg", at: [42.5, -2], route: [[0, 0], [15.5, 0], [17.5, -2], [42.5, -2]], out: [[42.5, -2], [FAR, -2]] },
  { name: "Google", src: "/assets/logos/software/google.svg", at: [32.5, 6], route: [[0, 0], [22.5, 0], [28.5, 6], [32.5, 6]], out: [[32.5, 6], [38.5, 6], [47.5, 15], [FAR, 15]] },
];
// a polyline with its inner corners rounded (a quadratic turn of r)
const rounded = (pts: Pt[], r = 12) => {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [a, b, c] = [pts[i - 1], pts[i], pts[i + 1]];
    const toward = (p: Pt, q: Pt): Pt => {
      const l = Math.hypot(q[0] - p[0], q[1] - p[1]);
      const k = Math.min(r, l / 2) / l;
      return [p[0] + (q[0] - p[0]) * k, p[1] + (q[1] - p[1]) * k];
    };
    const p1 = toward(b, a), p2 = toward(b, c);
    d += ` L${p1[0].toFixed(1)} ${p1[1].toFixed(1)} Q${b[0]} ${b[1]} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  const z = pts[pts.length - 1];
  return `${d} L${z[0]} ${z[1]}`;
};
const length = (pts: Pt[]) => pts.slice(1).reduce((sum, p, i) => sum + Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]), 0);
const nodes = LAYOUT.map((n) => ({
  ...n,
  ring: at(n.at),
  d: rounded(n.route.map(at)),
  dOut: rounded(n.out.map(at)),
  reach: length(n.route),
}));
// the order they are set down in: the shortest route first, whichever side
const order = nodes.map((_, i) => i).sort((a, b) => nodes[a].reach - nodes[b].reach);
const { t } = reader(await pageDocument(Astro.locals.sanity, doc.id), doc.defaults);
// The block names its document for the Visual editor: the Home page's,
// unless the page passed its own
const scope = { "data-page-doc": doc.id, "data-page-type": doc.id };
// A line under the heading, where the page's section has one
const lede = t(`${field}.lede`);
---
<section class:list={["cta", { "cta--blue": accent === "blue" }]} {...scope}>
  <!-- the ground: the FAQs' field of dots, the section's whole width and
       height, set out from the mark (styles.css); after a light FAQ it
       carries on that section's own dots, unbroken across the boundary
       (dot-field.js, data-dot-follow) -->
  <span class="cta__dots dot-grid band-field" data-dot-follow aria-hidden="true"></span>
  <!-- the diagram, on the dots: the lines, then the rings over their ends,
       then the mark in the middle; decoration (the words below say it). It
       reaches RISE above the call's top, for the lines rising out of it,
       and holds its drawing to the bus's row of dots (--cta-snap,
       cta-diagram.js) -->
  <svg class="cta__diagram" viewBox={`0 ${-RISE} ${2 * MID} ${RISE + DEPTH}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false" data-cta-diagram data-cta-bus={BUS} data-cta-rise={RISE}>
    <g class="cta__lines">
      {order.map((i) => <path d={nodes[i].dOut} data-cta-out />)}
      {order.map((i) => <path d={nodes[i].d} data-cta-route />)}
    </g>
    {order.map((i) => {
      const n = nodes[i];
      const w = n.w ?? 22, h = n.h ?? 22;
      const [x, y] = n.ring;
      return (
        <g class="cta__node" data-cta-node>
          <circle class="cta__ring" cx={x} cy={y} r={RING} />
          <image href={n.src} x={x - w / 2} y={y - h / 2} width={w} height={h} preserveAspectRatio="xMidYMid meet" />
          <text class="cta__name" x={x} y={y + RING + 15} text-anchor="middle">{n.name}</text>
        </g>
      );
    })}
    <g class="cta__hub" data-cta-hub>
      <image href="/assets/logo.svg" x={MID - LOGO / 2} y={BUS - LOGO / 2} width={LOGO} height={LOGO} />
    </g>
  </svg>
  <div class="cta__grid">
    <div class="cta__body">
      <h2 class="h1 cta__heading" data-page-field={`${field}.heading`}>{t(`${field}.heading`)}</h2>
      {lede && <p class="text-md cta__lede" data-page-field={`${field}.lede`}>{lede}</p>}
      {single ? (
      <div class="actions">
        <ActionButton href={single.href} shape={shape} {...(single.attrs ?? {})}><span data-page-field={single.field} data-page-doc={single.doc} data-page-type={single.doc}>{single.label}</span></ActionButton>
      </div>
      ) : (
      <div class="actions actions--pair">
        <ActionButton {...primary} shape={shape}><span data-page-field={`${field}.primaryButton`}>{t(`${field}.primaryButton`)}</span></ActionButton>
        <ActionButton {...secondary} variant="secondary" shape={shape}><span data-page-field={`${field}.secondaryButton`}>{t(`${field}.secondaryButton`)}</span></ActionButton>
      </div>
      )}
    </div>
  </div>
</section>
