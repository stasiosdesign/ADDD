---
/*
  The closing call to action every content page ends on, set the way the
  hero and the routes intro are: a label holding the left edge, the heading
  and its buttons set in from it, the newsletter signup under them, and
  the arrow out on the right gutter.

  The words are the Closing call to action section of the Home page document
  in Sanity (src/sanity/defaults/home.ts while nothing is published), so one
  edit there changes every page that ends with it. A page with its own call
  to action — For AEC Tech Firms, with its partnership routes — passes its
  own `doc` and field, so the two audiences never share one. Where the
  buttons lead stays here.
*/
import ActionButton from "./ActionButton.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { pageDocument, reader, type Doc } from "../sanity/content";
import { homePage } from "../sanity/defaults/home";

interface Props {
  /** The document and section the words come from: the Home page's closingCta unless a page has its own. */
  doc?: { id: string; defaults: Doc; field?: string };
  primary?: { href: string; [attr: string]: unknown };
  secondary?: { href: string; [attr: string]: unknown };
  /** The primary's accent: the site's red, or the AEC Tech Firms blue. */
  accent?: "red" | "blue";
}

const {
  doc = { id: "homePage", defaults: homePage as Doc },
  primary = { href: "stack-diagnostic.html" },
  secondary = { href: "contact.html" },
  accent = "red",
} = Astro.props;
const field = (doc as { field?: string }).field ?? "closingCta";
const { t } = reader(await pageDocument(Astro.locals.sanity, doc.id), doc.defaults);
// The block names its document for the Visual editor: the Home page's,
// unless the page passed its own
const scope = { "data-page-doc": doc.id, "data-page-type": doc.id };
---
<section class:list={["cta", { "cta--blue": accent === "blue" }]} {...scope}>
  <div class="cta__grid">
    <p class="tagline tagline--sm cta__label" data-page-field={`${field}.label`}>{t(`${field}.label`)}</p>
    <div class="cta__body">
      <h2 class="h1 cta__heading" data-page-field={`${field}.heading`}>{t(`${field}.heading`)}</h2>
      <div class="actions actions--pair">
        <ActionButton {...primary}><span data-page-field={`${field}.primaryButton`}>{t(`${field}.primaryButton`)}</span></ActionButton>
        <ActionButton {...secondary} variant="secondary"><span data-page-field={`${field}.secondaryButton`}>{t(`${field}.secondaryButton`)}</span></ActionButton>
      </div>
      <!-- The newsletter signup, under a rule: what it is on the left, the
           shared signup on the right. -->
      <div class="cta__signup">
        <div class="cta__signup-text">
          <p class="tagline tagline--sm">ADDDitive newsletter</p>
          <p class="cta__signup-title">Get ADDDitive in your inbox</p>
          <p class="cta__signup-desc">The Process of Architecture: how technology actually gets used to make architecture.</p>
        </div>
        <form class="newsletter-signup" onsubmit="return false">
          <div class="newsletter-form">
            <input type="email" name="email" placeholder="Your email" aria-label="Your email" required>
            <button class="newsletter-form__submit" type="submit">Subscribe</button>
          </div>
          <fieldset class="newsletter-audience">
            <legend class="newsletter-audience__legend">Which describes you?</legend>
            <label><input type="radio" name="audience" value="practice" required> I run or work in a practice</label>
            <label><input type="radio" name="audience" value="vendor"> I sell to practices</label>
          </fieldset>
        </form>
      </div>
    </div>
    <span class="cta__mark" aria-hidden="true"><ArrowIcon /></span>
  </div>
</section>
