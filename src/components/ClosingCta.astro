---
/*
  The closing call to action every content page ends on, set the way the
  hero and the routes intro are: a label holding the left edge, the heading
  and its buttons set in from it, and the arrow out on the right gutter.
*/
import ActionButton from "./ActionButton.astro";
import ArrowIcon from "./ArrowIcon.astro";
---
<section class="cta">
  <div class="cta__grid">
    <p class="tagline tagline--sm cta__label">For architecture practices</p>
    <div class="cta__body">
      <h2 class="h1 cta__heading">Need help making sense of your technology setup?</h2>
      <div class="actions actions--blocks">
        <ActionButton href="stack-diagnostic.html" variant="secondary" block>Free Tech Stacks</ActionButton>
        <ActionButton href="contact.html" block>Work With Us</ActionButton>
      </div>
    </div>
    <span class="cta__mark" aria-hidden="true"><ArrowIcon /></span>
  </div>
</section>
