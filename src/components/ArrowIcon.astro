---
/*
  The site's directional mark — the logo's own triangle. The CTAs, the
  cards, the closing CTA, the approach steps, the testimonials, the nav's
  dropdowns and service cards all carry it. It is the first D's form,
  drawn from the logo's own geometry (formPath, src/scripts/logo-morph.js),
  so it is the mark exactly, not a lookalike: a solid triangle pointing
  right, 15 by 16 in the logo's units.

  One triangle (the default) is drawn in currentColor on a 24px box at
  half the box's height, its middle set between the box's centre and the
  triangle's own centroid, so it sits optically centred in a chip and
  stays so turned to any side. Each place sizes it from its own CSS and
  turns it to point where it leads: rotate(90deg) down, 180deg left,
  -90deg up.

  count={3} draws the logo's three Ds as they stand in the mark, side by
  side a hair apart: the primary CTAs' mark, so a CTA reads as going on
  rather than as a play button. Its box is the three forms' own bounds
  (47.7 by 16), so its place sets its height and the width follows.

  Any extra attributes (class, aria-hidden) pass through. The text
  links' <img> mark (public/assets/icons/chevron_right.svg) is the same
  single triangle, for the places that set it as an image.
*/
import { formPath } from "../scripts/logo-morph.js";

interface Props {
  count?: 1 | 3;
  [attr: string]: unknown;
}

const { count = 1, ...attrs } = Astro.props;
// the Ds: the first (34.7, 42.7) – (49.7, 50.7) – (34.7, 58.7), then the
// next two after it, to x 82.4
const forms = count === 3 ? [1, 2, 3].map(formPath) : [formPath(1)];
const box = count === 3
  ? { width: 47.7, height: 16, viewBox: "34.7 42.7 47.7 16" }
  : { width: 24, height: 24, viewBox: "25 34.7 32 32" };
---
<svg width={box.width} height={box.height} viewBox={box.viewBox} fill="currentColor" xmlns="http://www.w3.org/2000/svg" {...attrs}>{forms.map((d) => <path d={d}></path>)}</svg>
