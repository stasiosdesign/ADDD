---
/*
  The opening hero: the off-white band with its pattern, then the lede on
  the left and the headline with its buttons on the right. Styles are the
  "1 — hero" block in src/styles/styles.css. The arrow is the scroll cue, so
  each page points it at the section it wants read next.

  The band carries the Slash Field (src/scripts/slash-field.js), a grid
  of / | \ strokes running on past the band's edges, which crop it, and
  running entirely by itself — no hover. The technology words are real
  text placed in the field itself, each on its own spot in the band, on
  the grid, with the pattern running on behind it. One at a time they
  come online in a chain reaction — a word bursts and decodes, and its
  shockwave runs out through the strokes and sets the next one off.
*/
import ActionButton from "./ActionButton.astro";
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  /** The scroll cue's in-page target, e.g. "#approach". */
  arrowHref: string;
  /** The scroll cue's accessible name, saying where it goes. */
  arrowLabel: string;
  /** "band" (the homepage): the pattern runs across the top, the copy
      under it. "split" (For AEC Tech Firms): the pattern takes the left of
      the viewport, to the end of Grid Column 7, and the copy stands in
      Grid Columns 9–12 beside it. Below 992px both are the band. */
  layout?: "band" | "split";
  /** The pattern's accent: the site's red, or the AEC Tech Firms blue. */
  accent?: "red" | "blue";
  /** The copy, the homepage's unless a page has its own. */
  tagline?: string;
  lede?: string;
  heading?: string;
  /** The two buttons, the practice routes unless a page has its own. */
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}

const {
  arrowHref,
  arrowLabel,
  layout = "band",
  accent = "red",
  tagline = "Independent research & strategy",
  lede = "See how technology actually gets used to make architecture, and how workflows, BIM, software, data and AI connect, so better decisions follow.",
  heading = "Technology strategy for architecture practices",
  primaryCta = { href: "stack-diagnostic.html", label: "Free Tech Stacks" },
  secondaryCta = { href: "contact.html", label: "Work With Us" },
} = Astro.props;

// The Slash Field's vocabulary: BIM, Software, Infrastructure and AI, and
// the practice's other subjects — two from the hero's own copy, four from
// the tools around it. Each has a spot of its own, as fractions of the
// band (its centre), scattered high and low across its width so none fall
// into a row or a list; from is the narrowest band, in px, a word appears in, so a phone's
// field carries six words rather than ten.
const fieldWords = [
  { text: "BIM", spot: [0.07, 0.26] },
  { text: "Software", spot: [0.56, 0.2] },
  { text: "Infrastructure", spot: [0.86, 0.66] },
  { text: "Artificial intelligence", spot: [0.33, 0.78] },
  { text: "Data", spot: [0.27, 0.4] },
  { text: "Workflows", spot: [0.74, 0.34] },
  { text: "Automation", spot: [0.94, 0.12], from: 740 },
  { text: "Computation", spot: [0.44, 0.52], from: 740 },
  { text: "Visualisation", spot: [0.62, 0.86], from: 740 },
  { text: "Digital fabrication", spot: [0.13, 0.64], from: 740 },
];

// More of the practice's subjects, for the homepage's first-load intro only
// (logo-morph-loader.js): while the field fills the screen the band's words
// hold its upper half, so these balance them across the lower half, each at
// a spot on the screen (its centre, as fractions of it) clear of the logo
// in the middle. Born into the field by the logo's pulse like the rest, they
// are cropped away as the hero's copy rises over them and leave the field
// once the hero has settled (data-slash-screen; slash-field.js).
const screenWords = [
  { text: "Digital twins", spot: [0.11, 0.6] },
  { text: "Parametric design", spot: [0.32, 0.66], from: 740 },
  { text: "Reality capture", spot: [0.68, 0.62] },
  { text: "Interoperability", spot: [0.9, 0.7], from: 740 },
  { text: "Generative design", spot: [0.16, 0.8] },
  { text: "Point clouds", spot: [0.48, 0.76], from: 740 },
  { text: "Energy modelling", spot: [0.76, 0.84] },
  { text: "Simulation", spot: [0.6, 0.93], from: 740 },
  { text: "Robotics", spot: [0.34, 0.91] },
  { text: "Cloud", spot: [0.93, 0.94], from: 740 },
];
---
<section class:list={["hero", { "hero--split": layout === "split", "hero--blue": accent === "blue" }]}>
  <div class="hero__media" data-slash-field>
    <ul class="hero__labels">
      {fieldWords.map(({ text, spot: [fx, fy], from }) => (
        <li data-slash-label data-slash-spot={`${fx},${fy}`} data-slash-from={from} class="hero__label" style={`left:${fx * 100}%;top:${fy * 100}%`}>{text}</li>
      ))}
      {screenWords.map(({ text, spot: [fx, fy], from }) => (
        <li data-slash-label data-slash-screen data-slash-spot={`${fx},${fy}`} data-slash-from={from} class="hero__label" aria-hidden="true">{text}</li>
      ))}
    </ul>
  </div>

  <div class="container">
    <div class="hero__grid">
      <div class="hero__col hero__col--lede">
        <p class="text-md">{lede}</p>
        <p class="tagline tagline--sm">{tagline}</p>
      </div>
      <div class="hero__col hero__col--heading">
        <h1 class="h1 hero__heading">{heading}</h1>

        <div class="hero__cta-row">
          <div class="actions actions--pair">
            <ActionButton href={primaryCta.href}>{primaryCta.label}</ActionButton>
            <ActionButton href={secondaryCta.href} variant="secondary">{secondaryCta.label}</ActionButton>
          </div>
          <a class="hero__arrow" href={arrowHref} aria-label={arrowLabel}><ArrowIcon aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </div>
</section>
