---
/*
  One service as a card in the nav's Services dropdown (Nav.astro; nav.css,
  "Services cards"): the service's name, large, in the middle of the card,
  a line on the service under it in two set lines, and behind it a
  pattern of its own. The card takes the nav's state, light or
  dark (nav.css).

  A name with a cycle (the Workshop's) is drawn as its stem and a word that
  turns from one ending to the next, the homepage hero's word cycle
  (word-cycle.js, mounted by initMegaNav): "Work", then "shop" or "flow".
  The word stands in a box as wide as the widest of its endings, so the
  name never moves as it changes. Screen readers are given the name as it
  is written (title), once, and not the turning word.

  Behind each, its route's own ground, the service's sub-brand
  (services.ts, "ground"; ServiceGround.astro), the same graphic as on
  its homepage card and its page's hero, here on a cell of its own:

    0  Workflow Workshop     the dash-dot line laid flat, a square grid
                             (PlanGround.astro)
    1  Before Revit          a square grid of dots, close and exact, the
                             approach band's dots on a tighter pitch, the
                             sheet a design is set out on before the model
                             is built (GridGround.astro)
    2  Technology Blueprint  the AEC Tech Partners hero's dash-dot
                             lattice (BlueprintGround.astro)
    3  Ongoing Advisory      isometric paper (PaperGround.astro)

  Every ground runs on across the whole card, behind the name and the
  line under it too, a ground rather than a frame round the words: no
  clearing, mask or fade. It is drawn on a canvas in the card
  (mountIsoField, mounted by initMegaNav), snapped to the screen's
  pixels, set out from an empty svg the card's shape at its widest
  (data-ground, its middle), cropped to the card at any other (slice), so
  it is cropped the same however the card is sized.
*/
interface Props {
  href: string;
  /** The service's place, from 0: its pattern. */
  index: number;
  title: string;
  /** Draw the name as a stem and a word turning through these endings (the first is the name's own). */
  cycle?: { stem: string; words: string[] };
  /** The line under the name, as its set lines: composed rather than
      left to wrap, the first the longer, so the four cards share one
      silhouette. A line still wraps where a card is too narrow for it. */
  text: string[];
  [attr: string]: unknown;
}

import ServiceGround from "./ServiceGround.astro";
import { SERVICES } from "./services";

const { href, index, title, cycle, text, ...attrs } = Astro.props;

// the ground's box: the card's shape at its widest
const W = 400;
const H = 320;

// each ground's cell in the box's units, smaller than on the deck's
// card and the hero, the card being small: the grid of dots 11 (about
// 13px on a wide screen, two thirds of the approach band's pitch), the
// flat squares 64, the lattice 100 (three or so cube tops across), the
// paper 32
const MODULES = { plan: 64, grid: 11, blueprint: 100, paper: 32 } as const;
const ground = SERVICES[index]?.ground;
---
<a class="service-card" href={href} {...attrs}>
  <svg class="service-card__pattern" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" data-ground={`${W / 2} ${H / 2}`} aria-hidden="true"></svg>
  {ground && <ServiceGround kind={ground} class="service-card__dots" module={MODULES[ground]} />}
  {cycle ? (
    <span class="service-card__title"><span class="service-card__sr">{title}</span><span aria-hidden="true">{cycle.stem}<span class="service-card__cycle"><span class="service-card__cycle-word" data-word-cycle={cycle.words.join("|")}>{cycle.words[0]}</span>{cycle.words.map((word) => <span class="service-card__cycle-ghost">{word}</span>)}</span></span></span>
  ) : (
    <span class="service-card__title">{title}</span>
  )}
  <span class="service-card__text">{text.map((line, i) => <>{i > 0 && <br />}{line}</>)}</span>
</a>
