---
/*
  A service's diagram, one per service in the services' order, drawn as
  the homepage's approach schematics are (ApproachStack.astro): exploded
  isometric drawings, forms built of layers stood apart one over the next
  with fine dashed guides between them, each form filled with its field's
  ground so it reads as solid and hides what is behind it, edged in
  hairlines; under each, the same dashed setting-out cross with a ring at
  each end; centred in its field and symmetric about its middle. Solid
  lines draw things; dotted ones draw what moves between or relates them
  (the loop work takes, a design carried across, a part mapped into a
  plan, a roadmap). The site's red only ever draws a line.

    0  Workflow Workshop     the project's site, the floor where the work
                             loops round its four units, the one at the
                             front where it sticks in red, and over it
                             the written report, the red line rising from
                             the sticking point to its mark on it
    1  Before Revit          the plate split by a red threshold: the early
                             design as three loose sheets stood apart
                             before it, the storeyed block marked R
                             (Revit) after it
    2  Technology Blueprint  the practice's parts on its slab, and over it
                             the blueprint, a plan on a grid with the red
                             roadmap down its centre through three
                             milestones
    3  Ongoing Advisory      the practice as three floors stood apart, a
                             ring round each, the middle one red with four
                             regular sessions on it

  Used on the homepage's service stack (dark) and the nav's Services cards
  (light): the lines are drawn in the field's ink (--c-text) and the faces
  in its ground (--diagram-ground), so one drawing serves both, and the
  lines keep one pixel's weight at any size (styles.css, "service
  diagrams"). Coordinates are in a 400 × 256 viewBox, projected by
  src/scripts/iso.js.
*/
import { boxFaces, floorLines, path, plane, projector } from "../scripts/iso.js";

interface Props {
  index: number;
  class?: string;
}
const { index, class: className } = Astro.props;

type Projector = (x: number, y: number, z?: number) => number[];
type Faces = { top: string; left: string; right: string };
const fmt = (n: number) => +n.toFixed(1);
const COS30 = Math.cos(Math.PI / 6);

// the setting-out: the dashed cross through the origin, ringed at its ends
const cross = (P: Projector, reach: number) => ({
  lines: [path([P(-reach, 0), P(reach, 0)], false), path([P(0, -reach), P(0, reach)], false)],
  rings: [P(-reach, 0), P(reach, 0), P(0, -reach), P(0, reach)].map(([cx, cy]) => ({ cx: fmt(cx), cy: fmt(cy) })),
});
// a square slab centred on (x, y)
const slab = (P: Projector, x: number, y: number, half: number, z: number, t: number) => boxFaces(P, x - half, y - half, z, 2 * half, 2 * half, t);
// dashed verticals from one height to another at the given points
const verticals = (P: Projector, points: number[][], from: number, to: number) => points.map(([x, y]) => path([P(x, y, from), P(x, y, to)], false));
// the left and right corners of a square centred on (x, y)
const sides = (x: number, y: number, half: number) => [[x - half, y + half], [x + half, y - half]];

// a horizontal circle of radius r round the vertical axis at height z, as
// its back and front halves, so a form inside it can stand between them:
// in this projection it is an upright ellipse, r·√2·cos30° across and
// r·√2·½ deep
function ring3d(P: Projector, r: number, z: number) {
  const [cx, cy] = P(0, 0, z);
  const rx = fmt(r * Math.SQRT2 * COS30);
  const ry = fmt(r * Math.SQRT2 * 0.5);
  const left = `${fmt(cx - rx)} ${fmt(cy)}`;
  const right = `${fmt(cx + rx)} ${fmt(cy)}`;
  return { back: `M${left}A${rx} ${ry} 0 0 1 ${right}`, front: `M${right}A${rx} ${ry} 0 0 1 ${left}`, cx: fmt(cx), cy: fmt(cy), rx, ry };
}

// 0 — Workflow Workshop: the site, the floor over it, the report over that
const wP = projector(200, 157);
const W_FLOOR = 34;
const W_REPORT = 84;
const W_LOOP = 36;
const W_UNIT = 12;
const wTop = W_FLOOR + 6;
const workshop = {
  cross: cross(wP, 112),
  site: slab(wP, 0, 0, 70, 0, 6),
  floor: slab(wP, 0, 0, 56, W_FLOOR, 6),
  loop: plane(wP, -W_LOOP, -W_LOOP, 2 * W_LOOP, 2 * W_LOOP, wTop),
  // back, left, right; then the front, where it sticks
  units: [[-W_LOOP, -W_LOOP], [-W_LOOP, W_LOOP], [W_LOOP, -W_LOOP]].map(([x, y]) => boxFaces(wP, x - W_UNIT / 2, y - W_UNIT / 2, wTop, W_UNIT, W_UNIT, W_UNIT)),
  stuck: boxFaces(wP, W_LOOP - W_UNIT / 2, W_LOOP - W_UNIT / 2, wTop, W_UNIT, W_UNIT, W_UNIT),
  stuckMark: plane(wP, W_LOOP - 12, W_LOOP - 12, 24, 24, wTop),
  // the report's corners dropped to the floor, and the red line from the
  // sticking point up to its mark
  guides: verticals(wP, sides(0, 0, 44), wTop, W_REPORT),
  rise: path([wP(W_LOOP, W_LOOP, wTop + W_UNIT), wP(W_LOOP, W_LOOP, W_REPORT)], false),
  report: slab(wP, 0, 0, 44, W_REPORT, 3),
  lines: [-22, -10, 2].map((y) => path([wP(-30, y, W_REPORT + 3), wP(14, y, W_REPORT + 3)], false)),
  mark: plane(wP, W_LOOP - 6, W_LOOP - 6, 12, 12, W_REPORT + 3),
};

// 1 — Before Revit: three loose sheets, the threshold, the storeyed block
const rP = projector(200, 128);
const R_PLATE = 5;
const R_AT = 38;
const R_SIZE = 40;
const R_SHEETS = [10, 28, 46];
const rBlock = { x0: R_AT - R_SIZE / 2, y0: -R_AT - R_SIZE / 2 };
// the R set on the block's face towards the threshold (its +y face):
// along the face is x, down it is -z, so the letter keeps the face's slant
const [glyphX, glyphY] = rP(R_AT, rBlock.y0 + R_SIZE, R_PLATE + R_SIZE / 2);
const beforeRevit = {
  cross: cross(rP, 122),
  plate: slab(rP, 0, 0, 80, 0, R_PLATE),
  threshold: path([rP(-80, -80, R_PLATE), rP(80, 80, R_PLATE)], false),
  thresholdEnds: [rP(-80, -80, R_PLATE), rP(80, 80, R_PLATE)].map(([cx, cy]) => ({ cx: fmt(cx), cy: fmt(cy) })),
  link: path([rP(-R_AT, R_AT, R_PLATE), rP(R_AT, -R_AT, R_PLATE)], false),
  // the design carried over the threshold: a dotted path from the top
  // sheet to the top of the block
  carry: path([rP(-R_AT, R_AT, R_SHEETS[R_SHEETS.length - 1] + 3), rP(0, 0, R_PLATE + R_SIZE + 22), rP(R_AT, -R_AT, R_PLATE + R_SIZE)], false),
  sheetGuides: verticals(rP, sides(-R_AT, R_AT, 22), R_PLATE, R_SHEETS[R_SHEETS.length - 1]),
  sheets: R_SHEETS.map((z) => slab(rP, -R_AT, R_AT, 22, z, 3)),
  block: boxFaces(rP, rBlock.x0, rBlock.y0, R_PLATE, R_SIZE, R_SIZE, R_SIZE),
  // its storeys, on the side away from the threshold only, so the R's
  // face stays clear
  storeys: [R_SIZE / 3, (2 * R_SIZE) / 3].map((h) =>
    path([rP(rBlock.x0 + R_SIZE, rBlock.y0 + R_SIZE, R_PLATE + h), rP(rBlock.x0 + R_SIZE, rBlock.y0, R_PLATE + h)], false),
  ).join(""),
  badge: path([
    rP(rBlock.x0 + 6, rBlock.y0 + R_SIZE, R_PLATE + 6), rP(rBlock.x0 + R_SIZE - 6, rBlock.y0 + R_SIZE, R_PLATE + 6),
    rP(rBlock.x0 + R_SIZE - 6, rBlock.y0 + R_SIZE, R_PLATE + R_SIZE - 6), rP(rBlock.x0 + 6, rBlock.y0 + R_SIZE, R_PLATE + R_SIZE - 6),
  ]),
  glyph: `matrix(${fmt(COS30)} 0.5 0 1 ${fmt(glyphX)} ${fmt(glyphY)})`,
};

// 2 — Technology Blueprint: the parts on the slab, the blueprint over them
const bP = projector(200, 144);
const B_BASE = 84;
const B_SHEET = 52;
const B_HIGH = 60;
const B_CELL = (2 * B_SHEET) / 3;
const bTop = B_HIGH + 4;
const blueprint = {
  cross: cross(bP, 126),
  base: slab(bP, 0, 0, B_BASE, 0, 6),
  // the parts by the slab's left, right and front corners, where the
  // blueprint over them leaves them in view
  parts: [[-60, 60], [60, -60], [60, 60]].map(([x, y]) => ({
    ...boxFaces(bP, x - 11, y - 11, 6, 22, 22, 16),
    floors: floorLines(bP, x - 11, y - 11, 6, 22, 22, 16, 8),
  })),
  // each part mapped into the plan: a dotted line from its top to the
  // blueprint's corner nearest it
  maps: [[-60, 60, -B_SHEET, B_SHEET], [60, -60, B_SHEET, -B_SHEET], [60, 60, B_SHEET, B_SHEET]].map(([x, y, cx, cy]) =>
    path([bP(x, y, 22), bP(cx, cy, B_HIGH)], false),
  ),
  sheet: slab(bP, 0, 0, B_SHEET, B_HIGH, 4),
  grid: [-B_CELL / 2, B_CELL / 2].flatMap((t) => [
    path([bP(t, -B_SHEET, bTop), bP(t, B_SHEET, bTop)], false),
    path([bP(-B_SHEET, t, bTop), bP(B_SHEET, t, bTop)], false),
  ]),
  roadmap: path([bP(-B_CELL, -B_CELL, bTop), bP(B_CELL, B_CELL, bTop)], false),
  milestones: [-B_CELL, 0, B_CELL].map((t) => plane(bP, t - 5, t - 5, 10, 10, bTop)),
};

// 3 — Ongoing Advisory: three floors stood apart, a ring round each
const aP = projector(200, 164);
const A_FLOORS = [0, 34, 68];
const A_R = 64;
const A_ACTIVE = 1;
const advisory = {
  cross: cross(aP, 110),
  levels: A_FLOORS.map((z, k) => ({
    k,
    ring: ring3d(aP, A_R, z + 12),
    floor: boxFaces(aP, -18, -18, z, 36, 36, 24),
  })),
  // the rings' outer edges, joined, so they read as one drum
  drum: [-1, 1].map((s) => {
    const low = ring3d(aP, A_R, A_FLOORS[0] + 12);
    const high = ring3d(aP, A_R, A_FLOORS[A_FLOORS.length - 1] + 12);
    return `M${fmt(low.cx + s * low.rx)} ${low.cy}V${high.cy}`;
  }),
  sessions: [[A_R, 0], [0, A_R], [-A_R, 0], [0, -A_R]].map(([x, y]) => {
    const [cx, cy] = aP(x, y, A_FLOORS[A_ACTIVE] + 12);
    return { cx: fmt(cx), cy: fmt(cy) };
  }),
};
---
<svg class:list={["service-diagram", className]} viewBox="0 0 400 256" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none">
  {index === 0 && (
    <Fragment>
      {workshop.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {workshop.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      <g class="service-diagram__solid is--soft"><path d={workshop.site.left} /><path d={workshop.site.right} /><path d={workshop.site.top} /></g>
      <g class="service-diagram__solid"><path d={workshop.floor.left} /><path d={workshop.floor.right} /><path d={workshop.floor.top} /></g>
      <path class="service-diagram__line is--path" d={workshop.loop} />
      <path class="service-diagram__accent is--dash" d={workshop.stuckMark} />
      {workshop.units.map((f: Faces) => (
        <g class="service-diagram__solid"><path d={f.left} /><path d={f.right} /><path d={f.top} /></g>
      ))}
      <g class="service-diagram__solid is--accent"><path d={workshop.stuck.left} /><path d={workshop.stuck.right} /><path d={workshop.stuck.top} /></g>
      {workshop.guides.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      <path class="service-diagram__accent is--dash" d={workshop.rise} />
      <g class="service-diagram__solid is--soft"><path d={workshop.report.left} /><path d={workshop.report.right} /><path d={workshop.report.top} /></g>
      {workshop.lines.map((d) => <path class="service-diagram__line is--soft" d={d} />)}
      <path class="service-diagram__accent" d={workshop.mark} />
    </Fragment>
  )}

  {index === 1 && (
    <Fragment>
      {beforeRevit.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {beforeRevit.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      <g class="service-diagram__solid is--soft"><path d={beforeRevit.plate.left} /><path d={beforeRevit.plate.right} /><path d={beforeRevit.plate.top} /></g>
      <path class="service-diagram__line is--soft is--dash" d={beforeRevit.link} />
      <path class="service-diagram__accent is--dash" d={beforeRevit.threshold} />
      {beforeRevit.thresholdEnds.map((r) => <circle class="service-diagram__ring is--accent" cx={r.cx} cy={r.cy} r="2.5" />)}
      {beforeRevit.sheetGuides.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {beforeRevit.sheets.map((f: Faces, k: number) => (
        <g class:list={["service-diagram__solid", { "is--soft": k < beforeRevit.sheets.length - 1 }]}><path d={f.left} /><path d={f.right} /><path d={f.top} /></g>
      ))}
      <g class="service-diagram__solid"><path d={beforeRevit.block.left} /><path d={beforeRevit.block.right} /><path d={beforeRevit.block.top} /></g>
      <path class="service-diagram__line is--soft" d={beforeRevit.storeys} />
      <path class="service-diagram__line is--soft" d={beforeRevit.badge} />
      <path class="service-diagram__line is--path" d={beforeRevit.carry} />
      <text class="service-diagram__glyph" transform={beforeRevit.glyph} text-anchor="middle" dominant-baseline="central">R</text>
    </Fragment>
  )}

  {index === 2 && (
    <Fragment>
      {blueprint.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {blueprint.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      <g class="service-diagram__solid is--soft"><path d={blueprint.base.left} /><path d={blueprint.base.right} /><path d={blueprint.base.top} /></g>
      {blueprint.parts.map((f) => (
        <g class="service-diagram__solid"><path d={f.left} /><path d={f.right} /><path d={f.top} /><path class="service-diagram__floors" d={f.floors} /></g>
      ))}
      {blueprint.maps.map((d) => <path class="service-diagram__line is--path is--soft" d={d} />)}
      <g class="service-diagram__solid"><path d={blueprint.sheet.left} /><path d={blueprint.sheet.right} /><path d={blueprint.sheet.top} /></g>
      {blueprint.grid.map((d) => <path class="service-diagram__line is--soft is--dash" d={d} />)}
      <path class="service-diagram__accent is--dash" d={blueprint.roadmap} />
      {blueprint.milestones.map((d) => <path class="service-diagram__accent is--mark" d={d} />)}
    </Fragment>
  )}

  {index === 3 && (
    <Fragment>
      {advisory.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {advisory.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      {advisory.drum.map((d) => <path class="service-diagram__line is--soft is--dash" d={d} />)}
      {advisory.levels.map(({ k, ring, floor }) => (
        <Fragment>
          <path class:list={[k === A_ACTIVE ? "service-diagram__accent" : "service-diagram__line is--soft", "is--dash"]} d={ring.back} />
          <g class:list={["service-diagram__solid", { "is--soft": k !== A_FLOORS.length - 1 }]}><path d={floor.left} /><path d={floor.right} /><path d={floor.top} /></g>
          <path class:list={[k === A_ACTIVE ? "service-diagram__accent" : "service-diagram__line is--soft", "is--dash"]} d={ring.front} />
        </Fragment>
      ))}
      {advisory.sessions.map((r) => <circle class="service-diagram__ring is--session" cx={r.cx} cy={r.cy} r="3" />)}
    </Fragment>
  )}
</svg>
