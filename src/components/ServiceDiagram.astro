---
/*
  A service's diagram, one per service in the services' order, drawn as
  the homepage's approach schematics are (ApproachStack.astro): isometric
  drawings of forms stood apart one over another with fine dashed guides
  between them, each form filled with its field's ground so it reads as
  solid and hides what is behind it, edged in hairlines; under each, the
  same dashed setting-out cross with a ring at each end; centred in its
  field and symmetric about its middle. Solid lines draw things; dotted
  ones draw what moves between or relates them. The site's red only ever
  draws a line.

  Each is composed to a square or a little taller than wide, set out
  round one idea, and each has its own outline, so the four read as a
  family rather than one drawing four times:

    0  Workflow Workshop     a live project's floor, the work looping round
                             its four stations, the one at the front where
                             it sticks in red, and stood well above it the
                             written report, small, the red line rising
                             from the sticking point to its mark on it: a
                             broad base under a small sheet
    1  Before Revit          the tools, information and decisions that shape
                             a project as three loose sheets, over them the
                             review, the red outline of their own register,
                             and above it the model, the block marked R: a
                             column, rising from the loose to the resolved
    2  Technology Blueprint  the practice's four systems standing on its
                             slab, and held over them, larger, the
                             blueprint: a plan in four quarters with the
                             red roadmap stepping through a milestone over
                             each system in turn
    3  Ongoing Advisory      the practice as three floors stood apart, a
                             ring round each, the middle one red with four
                             regular sessions on it

  On the homepage's service stack each moves (animate, the data-service-
  diagram attribute: service-diagram.js): the work runs its loop and
  sticks, and the report takes it down; the sheets come into register at
  the review and the model is built over them; the roadmap is drawn
  milestone by milestone, each lighting its system; a session runs round
  the ring. What the markup draws is the drawing at rest, which the nav's
  Services cards show, and every page under reduced motion.

  Used on the homepage's service stack (dark) and the nav's Services cards
  (light): the lines are drawn in the field's ink (--c-text) and the faces
  in its ground (--diagram-ground), so one drawing serves both, and the
  lines keep one pixel's weight at any size (styles.css, "service
  diagrams"). Coordinates are in a 400 × 256 viewBox, projected by
  src/scripts/iso.js.
*/
import { boxFaces, path, plane, projector } from "../scripts/iso.js";

interface Props {
  index: number;
  class?: string;
  /** Moves (service-diagram.js), as on the homepage's service stack; still everywhere else. */
  animate?: boolean;
}
const { index, class: className, animate = false } = Astro.props;

type Projector = (x: number, y: number, z?: number) => number[];
type Faces = { top: string; left: string; right: string };
const fmt = (n: number) => +n.toFixed(1);
const COS30 = Math.cos(Math.PI / 6);

// the setting-out: the dashed cross through the origin, ringed at its ends
const cross = (P: Projector, reach: number) => ({
  lines: [path([P(-reach, 0), P(reach, 0)], false), path([P(0, -reach), P(0, reach)], false)],
  rings: [P(-reach, 0), P(reach, 0), P(0, -reach), P(0, reach)].map(([cx, cy]) => ({ cx: fmt(cx), cy: fmt(cy) })),
});
// a square slab centred on (x, y)
const slab = (P: Projector, x: number, y: number, half: number, z: number, t: number) => boxFaces(P, x - half, y - half, z, 2 * half, 2 * half, t);
// dashed verticals from one height to another at the given points
const verticals = (P: Projector, points: number[][], from: number, to: number) => points.map(([x, y]) => path([P(x, y, from), P(x, y, to)], false));
// a point as an SVG point, for a transform's origin
const at = (P: Projector, x: number, y: number, z: number) => P(x, y, z).map(fmt).join(" ");

// a horizontal circle of radius r round the vertical axis at height z, as
// its back and front halves, so a form inside it can stand between them:
// in this projection it is an upright ellipse, r·√2·cos30° across and
// r·√2·½ deep. The back half runs left to right over the top, the front
// right to left under it, so the two make one way round.
function ring3d(P: Projector, r: number, z: number) {
  const [cx, cy] = P(0, 0, z);
  const rx = fmt(r * Math.SQRT2 * COS30);
  const ry = fmt(r * Math.SQRT2 * 0.5);
  const left = `${fmt(cx - rx)} ${fmt(cy)}`;
  const right = `${fmt(cx + rx)} ${fmt(cy)}`;
  return { back: `M${left}A${rx} ${ry} 0 0 1 ${right}`, front: `M${right}A${rx} ${ry} 0 0 1 ${left}` };
}

// 0 — Workflow Workshop: the floor and its loop; the report over it
const wP = projector(200, 173);
const W_HALF = 54;
const W_T = 5;
const W_LOOP = 24;
const W_UNIT = 12;
// the report: a sheet the proportion of a page, stood high over the floor
const W_REPORT = { x0: -30, y0: -42, w: 60, d: 84, z: 104, t: 3 };
const wReportTop = W_REPORT.z + W_REPORT.t;
// the four stations: back, left, right, and the front one, where the work sticks
const W_BACK = [-W_LOOP, -W_LOOP];
const W_LEFT = [-W_LOOP, W_LOOP];
const W_RIGHT = [W_LOOP, -W_LOOP];
const W_FRONT = [W_LOOP, W_LOOP];
const wUnit = ([x, y]: number[]) => boxFaces(wP, x - W_UNIT / 2, y - W_UNIT / 2, W_T, W_UNIT, W_UNIT, W_UNIT);
const workshop = {
  cross: cross(wP, 80),
  floor: slab(wP, 0, 0, W_HALF, 0, W_T),
  // the loop the work takes, from the sticking point round and back to it
  loop: path([W_FRONT, W_LEFT, W_BACK, W_RIGHT, W_FRONT].map(([x, y]) => wP(x, y, W_T)), false),
  units: [W_BACK, W_LEFT, W_RIGHT].map(wUnit),
  stuck: wUnit(W_FRONT),
  // the report's left and right corners dropped to the floor
  guides: verticals(wP, [[W_REPORT.x0, W_REPORT.y0 + W_REPORT.d], [W_REPORT.x0 + W_REPORT.w, W_REPORT.y0]], W_T, W_REPORT.z),
  rise: path([wP(W_FRONT[0], W_FRONT[1], W_T + W_UNIT), wP(W_FRONT[0], W_FRONT[1], W_REPORT.z)], false),
  riseFoot: at(wP, W_FRONT[0], W_FRONT[1], W_T + W_UNIT),
  report: boxFaces(wP, W_REPORT.x0, W_REPORT.y0, W_REPORT.z, W_REPORT.w, W_REPORT.d, W_REPORT.t),
  // its lines of writing, across the page, the last one short
  lines: [[-30, 16], [-19, 16], [-8, 2]].map(([y, x1]) => ({ d: path([wP(-22, y, wReportTop), wP(x1, y, wReportTop)], false), from: at(wP, -22, y, wReportTop) })),
  mark: plane(wP, W_FRONT[0] - 6, W_FRONT[1] - 6, 12, 12, wReportTop),
};

// 1 — Before Revit: the loose sheets, the review, the model
const rP = projector(200, 188);
const R_SHEET = 38;
// the three sheets, bottom first, each off true by a little, as early
// work is; the animation brings them into register
const R_SHEETS = [
  { z: 0, dx: -7, dy: 6 },
  { z: 11, dx: 6, dy: -5 },
  { z: 22, dx: -3, dy: -8 },
];
// the review: the sheets' own register, which they come into on the way
// to the model
const R_REVIEW = R_SHEET;
const R_REVIEW_Z = 60;
const R_BLOCK = 22;
const R_BLOCK_Z = 98;
const R_BLOCK_H = 44;
// the R on the block's face towards the viewer's left (its +y face):
// along the face is x, down it is -z, so the letter keeps the face's slant
const [glyphX, glyphY] = rP(0, R_BLOCK, R_BLOCK_Z + R_BLOCK_H / 2);
const beforeRevit = {
  cross: cross(rP, 76),
  sheets: R_SHEETS.map(({ z, dx, dy }) => ({ dx, dy, faces: slab(rP, 0, 0, R_SHEET, z, 2) })),
  review: plane(rP, -R_REVIEW, -R_REVIEW, 2 * R_REVIEW, 2 * R_REVIEW, R_REVIEW_Z),
  reviewEnds: [rP(-R_REVIEW, R_REVIEW, R_REVIEW_Z), rP(R_REVIEW, -R_REVIEW, R_REVIEW_Z)].map(([cx, cy]) => ({ cx: fmt(cx), cy: fmt(cy) })),
  guides: verticals(rP, [[-R_BLOCK, R_BLOCK], [R_BLOCK, -R_BLOCK]], R_SHEETS[2].z + 2, R_BLOCK_Z),
  block: boxFaces(rP, -R_BLOCK, -R_BLOCK, R_BLOCK_Z, 2 * R_BLOCK, 2 * R_BLOCK, R_BLOCK_H),
  // its storeys, on the face away from the R
  storeys: [1, 2].map((k) => path([rP(R_BLOCK, R_BLOCK, R_BLOCK_Z + (k * R_BLOCK_H) / 3), rP(R_BLOCK, -R_BLOCK, R_BLOCK_Z + (k * R_BLOCK_H) / 3)], false)).join(""),
  glyph: `matrix(${fmt(COS30)} 0.5 0 1 ${fmt(glyphX)} ${fmt(glyphY)})`,
  blockFoot: at(rP, 0, 0, R_BLOCK_Z),
};
// a sheet's offset from register, in the drawing's own units on the screen
const offset = (dx: number, dy: number) => [fmt((dx - dy) * COS30), fmt((dx + dy) / 2)];

// 2 — Technology Blueprint: the systems on the slab, the blueprint over them
const bP = projector(200, 180);
const B_BASE = 44;
const B_T = 5;
const B_AT = 26;
const B_PART = 18;
const B_SHEET = 52;
const B_Z = 92;
const bTop = B_Z + 3;
// the four systems, back, left, right, front, each its own height; the
// roadmap visits them left, front, right, back
const B_PARTS = [
  { x: -B_AT, y: -B_AT, h: 30 },
  { x: -B_AT, y: B_AT, h: 18 },
  { x: B_AT, y: -B_AT, h: 24 },
  { x: B_AT, y: B_AT, h: 14 },
];
const B_ROUTE = [1, 3, 2, 0];
const blueprint = {
  cross: cross(bP, 78),
  base: slab(bP, 0, 0, B_BASE, 0, B_T),
  parts: B_PARTS.map(({ x, y, h }) => boxFaces(bP, x - B_PART / 2, y - B_PART / 2, B_T, B_PART, B_PART, h)),
  // each system mapped up into the plan
  maps: B_PARTS.map(({ x, y, h }) => path([bP(x, y, B_T + h), bP(x, y, B_Z)], false)),
  sheet: slab(bP, 0, 0, B_SHEET, B_Z, 3),
  // the plan's quarters
  grid: [path([bP(0, -B_SHEET, bTop), bP(0, B_SHEET, bTop)], false), path([bP(-B_SHEET, 0, bTop), bP(B_SHEET, 0, bTop)], false)],
  // the roadmap, one leg from each milestone to the next
  legs: B_ROUTE.slice(1).map((k, i) => {
    const a = B_PARTS[B_ROUTE[i]];
    const b = B_PARTS[k];
    return path([bP(a.x, a.y, bTop), bP(b.x, b.y, bTop)], false);
  }),
  milestones: B_ROUTE.map((k) => ({ k, d: plane(bP, B_PARTS[k].x - 5, B_PARTS[k].y - 5, 10, 10, bTop) })),
};

// 3 — Ongoing Advisory: three floors stood apart, a ring round each
const aP = projector(200, 168);
const A_FLOORS = [0, 40, 80];
const A_R = 52;
const A_ACTIVE = 1;
const advisory = {
  cross: cross(aP, 86),
  levels: A_FLOORS.map((z, k) => ({
    k,
    ring: ring3d(aP, A_R, z + 12),
    floor: boxFaces(aP, -17, -17, z, 34, 34, 22),
  })),
  // the sessions, in the order a way round the ring passes them: over
  // the back from the left, then the front from the right
  sessions: [[-A_R, 0], [0, -A_R], [A_R, 0], [0, A_R]].map(([x, y]) => {
    const [cx, cy] = aP(x, y, A_FLOORS[A_ACTIVE] + 12);
    return { cx: fmt(cx), cy: fmt(cy) };
  }),
};
const live = animate ? { "data-service-diagram": index } : {};
---
<svg class:list={["service-diagram", className]} viewBox="0 0 400 256" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" {...live}>
  {index === 0 && (
    <Fragment>
      {workshop.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {workshop.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      <g class="service-diagram__solid is--soft"><path d={workshop.floor.left} /><path d={workshop.floor.right} /><path d={workshop.floor.top} /></g>
      <path class="service-diagram__line is--path" d={workshop.loop} />
      <path class="service-diagram__pulse" data-s="pulse" d={workshop.loop} pathLength="1" />
      {workshop.units.map((f: Faces) => (
        <g class="service-diagram__solid"><path d={f.left} /><path d={f.right} /><path d={f.top} /></g>
      ))}
      <g class="service-diagram__solid is--accent" data-s="stuck"><path d={workshop.stuck.left} /><path d={workshop.stuck.right} /><path d={workshop.stuck.top} /></g>
      {workshop.guides.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      <path class="service-diagram__accent is--dash" data-s="rise" data-origin={workshop.riseFoot} d={workshop.rise} />
      <g class="service-diagram__solid"><path d={workshop.report.left} /><path d={workshop.report.right} /><path d={workshop.report.top} /></g>
      {workshop.lines.map((line) => <path class="service-diagram__line is--soft" data-s="line" data-origin={line.from} d={line.d} />)}
      <path class="service-diagram__accent" data-s="mark" d={workshop.mark} />
    </Fragment>
  )}

  {index === 1 && (
    <Fragment>
      {beforeRevit.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {beforeRevit.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      {beforeRevit.sheets.map(({ dx, dy, faces }, k) => {
        const [tx, ty] = offset(dx, dy);
        return (
          <g class:list={["service-diagram__solid", { "is--soft": k < beforeRevit.sheets.length - 1 }]} data-s="sheet" transform={`translate(${tx} ${ty})`}>
            <path d={faces.left} /><path d={faces.right} /><path d={faces.top} />
          </g>
        );
      })}
      {beforeRevit.guides.map((d) => <path class="service-diagram__line is--dash" data-s="guide" d={d} />)}
      <path class="service-diagram__accent is--dash" data-s="review" d={beforeRevit.review} />
      {beforeRevit.reviewEnds.map((r) => <circle class="service-diagram__ring is--accent" cx={r.cx} cy={r.cy} r="2.5" />)}
      <g data-s="model" data-origin={beforeRevit.blockFoot}>
        <g class="service-diagram__solid"><path d={beforeRevit.block.left} /><path d={beforeRevit.block.right} /><path d={beforeRevit.block.top} /></g>
        <path class="service-diagram__line is--soft" d={beforeRevit.storeys} />
        <text class="service-diagram__glyph" transform={beforeRevit.glyph} text-anchor="middle" dominant-baseline="central">R</text>
      </g>
    </Fragment>
  )}

  {index === 2 && (
    <Fragment>
      {blueprint.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {blueprint.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      <g class="service-diagram__solid is--soft"><path d={blueprint.base.left} /><path d={blueprint.base.right} /><path d={blueprint.base.top} /></g>
      {blueprint.parts.map((f, k) => (
        <g class="service-diagram__solid" data-s="part" data-k={k}><path d={f.left} /><path d={f.right} /><path d={f.top} /></g>
      ))}
      {blueprint.maps.map((d) => <path class="service-diagram__line is--path is--soft" d={d} />)}
      <g class="service-diagram__solid"><path d={blueprint.sheet.left} /><path d={blueprint.sheet.right} /><path d={blueprint.sheet.top} /></g>
      {blueprint.grid.map((d) => <path class="service-diagram__line is--soft is--dash" d={d} />)}
      {blueprint.legs.map((d) => <path class="service-diagram__accent is--dash" data-s="leg" d={d} />)}
      {blueprint.milestones.map(({ k, d }) => <path class="service-diagram__accent is--mark" data-s="milestone" data-k={k} d={d} />)}
    </Fragment>
  )}

  {index === 3 && (
    <Fragment>
      {advisory.cross.lines.map((d) => <path class="service-diagram__line is--dash" d={d} />)}
      {advisory.cross.rings.map((r) => <circle class="service-diagram__ring" cx={r.cx} cy={r.cy} r="2.5" />)}
      {advisory.levels.map(({ k, ring, floor }) => (
        <Fragment>
          <path class:list={[k === A_ACTIVE ? "service-diagram__accent" : "service-diagram__line is--soft", "is--dash"]} d={ring.back} />
          {k === A_ACTIVE && <path class="service-diagram__pulse" data-s="orbit" d={ring.back} pathLength="1" />}
          <g class:list={["service-diagram__solid", { "is--soft": k !== A_FLOORS.length - 1 }]}><path d={floor.left} /><path d={floor.right} /><path d={floor.top} /></g>
          <path class:list={[k === A_ACTIVE ? "service-diagram__accent" : "service-diagram__line is--soft", "is--dash"]} d={ring.front} />
          {k === A_ACTIVE && <path class="service-diagram__pulse" data-s="orbit" d={ring.front} pathLength="1" />}
        </Fragment>
      ))}
      {advisory.sessions.map((r) => <circle class="service-diagram__ring is--session" data-s="session" cx={r.cx} cy={r.cy} r="3" />)}
    </Fragment>
  )}
</svg>
