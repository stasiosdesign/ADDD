---
/*
  A service's diagram, one per service in the services' order: a Hairline
  figure (src/scripts/service-figures.js), drawn into this svg by the
  script (service-diagram.js), as the approach cards' are:

    0  Workflow Workshop     "Friction": a live project's floor, the work
                             looping round four stations, the written
                             report held over it; the station the pointer
                             picks lifts in red and is traced to its mark
                             on the report
    1  Before Revit          "Register": early design as three loose,
                             crooked sheets, the model over them; as the
                             pointer nears they come into register and the
                             model rises out of them
    2  Technology Blueprint  "Roadmap": four systems on the practice's slab,
                             the blueprint over them; the roadmap is drawn
                             to the picked system's milestone, step by step
    3  Ongoing Advisory      "Calendar": the practice's floors ringed by
                             twelve monthly sessions; the pointer's way
                             round picks a month, which rises with its
                             neighbours

  Each is set out on its field's lattice (dot-field.js, a cell of 54 at
  30°): data-ground is the point of the 400 × 256 frame the lattice runs
  through, and --sd-ground-y its height, which the service tabs use to
  set every drawing on one ground line.

  Used on the homepage's service deck and each service page's hero (dark)
  and the service tabs (light): the lines are drawn in the field's ink
  (--c-text) and the plates in its ground (--diagram-ground), so one
  drawing serves both (styles.css, "service diagrams").
*/
interface Props {
  index: number;
  class?: string;
}
const { index, class: className } = Astro.props;

// each figure's lattice point, as service-figures.js sets the figure out
const GROUNDS = [[200, 168], [200, 182], [200, 186], [200, 177]];
const origin = GROUNDS[index];
---
<svg class:list={["service-diagram", className]} viewBox="0 0 400 256" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" data-ground={origin?.join(" ")} style={origin ? `--sd-ground-y:${origin[1]}` : undefined} data-service-diagram={index}></svg>
