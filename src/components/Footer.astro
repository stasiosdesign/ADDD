---
/*
  The footer is revealed with a parallax: the panel starts high inside a
  clipping wrap and settles as the wrap scrolls up, with a scrim clearing
  off it at the same time. Both are driven from initFooterParallax() in
  src/scripts/site.js. It sits inside the Barba container, so it is swapped
  with the page and animates with it.

  On the site's red: the brand mark alone on the left; on the right the
  link groups three across in two rows, the legal links (with the
  copyright) and the social links among them (the newsletter signup is
  in the closing call to action, ClosingCta.astro);
  and across the foot the logo, drawn in the hero's pattern, its lower
  half running off the panel.

  Every link in the groups is the site's sliding-box link (.nav-link,
  NavLinkLabel.astro), as in the nav; the brand keeps its own.
*/
import NavLinkLabel from "./NavLinkLabel.astro";
---
<div data-footer-parallax="" class="footer-wrap">
  <footer data-footer-parallax-inner="" class="site-footer">
    <div class="site-footer__inner">

      <div class="site-footer__top">
        <a href="/index.html" class="site-footer__brand" aria-label="ADDD home">
          <!-- the logo's four forms (assets/logo.svg) without the circle,
               cropped to their own bounds, in the footer's white -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="18.4 42.7 64 16" fill="currentColor" aria-hidden="true">
            <polygon points="18.4,58.7 34.7,58.7 26.5,42.7" />
            <polygon points="34.7,42.7 49.7,50.7 34.7,58.7" />
            <polygon points="50.7,42.7 66.4,50.7 50.7,58.7" />
            <polygon points="66.8,42.7 82.4,50.7 66.8,58.7" />
          </svg>
        </a>

        <div class="site-footer__groups">
          <div class="site-footer__group">
            <p class="site-footer__eyebrow">Services</p>
            <ul class="site-footer__links">
              <li><a class="nav-link" href="/workshops-audits.html"><NavLinkLabel>Workflow Workshop</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/before-revit.html"><NavLinkLabel>Before Revit</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/technology-blueprint.html"><NavLinkLabel>Technology Blueprint</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/advisory.html"><NavLinkLabel>Ongoing Advisory</NavLinkLabel></a></li>
            </ul>
          </div>
          <div class="site-footer__group">
            <p class="site-footer__eyebrow">Resources</p>
            <ul class="site-footer__links">
              <li><a class="nav-link" href="/stack-diagnostic.html"><NavLinkLabel>Free Tech Stacks</NavLinkLabel></a></li>
              <li><a class="nav-link" href="https://app.addd.io/" target="_blank" rel="noopener"><NavLinkLabel>Software Database &#8599;</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/reports.html"><NavLinkLabel>Reports &amp; Guides</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/newsletter.html"><NavLinkLabel>ADDDitive Newsletter</NavLinkLabel></a></li>
              <li><a class="nav-link" href="https://aectechjobs.com/" target="_blank" rel="noopener"><NavLinkLabel>AEC Jobs &#8599;</NavLinkLabel></a></li>
            </ul>
          </div>
          <div class="site-footer__group">
            <p class="site-footer__eyebrow">Company</p>
            <ul class="site-footer__links">
              <li><a class="nav-link" href="/index.html"><NavLinkLabel>Home</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/about.html"><NavLinkLabel>About</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/tech-firms.html"><NavLinkLabel>AEC Tech Partners</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/contact.html"><NavLinkLabel>Contact</NavLinkLabel></a></li>
              <li><a class="nav-link" href="https://app.addd.io/login" target="_blank" rel="noopener"><NavLinkLabel>Sign in &#8599;</NavLinkLabel></a></li>
            </ul>
          </div>
          <div class="site-footer__group">
            <p class="site-footer__eyebrow">Contact</p>
            <ul class="site-footer__links">
              <li><a class="nav-link" href="mailto:allister@addd.io"><NavLinkLabel>allister@addd.io</NavLinkLabel></a></li>
              <li><a class="nav-link" href="tel:+442071833675"><NavLinkLabel>+44 (0) 207 183 3675</NavLinkLabel></a></li>
              <li><a class="nav-link" href="/contact.html"><NavLinkLabel>Book a call</NavLinkLabel></a></li>
            </ul>
          </div>
          <div class="site-footer__group">
            <p class="site-footer__eyebrow">Legal</p>
            <ul class="site-footer__links">
              <li><a class="nav-link" href="#"><NavLinkLabel>Privacy policy</NavLinkLabel></a></li>
              <li><a class="nav-link" href="#"><NavLinkLabel>Terms of service</NavLinkLabel></a></li>
              <li><a class="nav-link" href="#"><NavLinkLabel>Cookie settings</NavLinkLabel></a></li>
            </ul>
            <p class="site-footer__copy">&copy; 2026 ADDD. All rights reserved.</p>
          </div>
          <div class="site-footer__group">
            <p class="site-footer__eyebrow">Social</p>
            <ul class="site-footer__links">
              <li><a class="nav-link" href="#"><NavLinkLabel>LinkedIn</NavLinkLabel></a></li>
              <li><a class="nav-link" href="#"><NavLinkLabel>Instagram</NavLinkLabel></a></li>
              <li><a class="nav-link" href="#"><NavLinkLabel>X</NavLinkLabel></a></li>
              <li><a class="nav-link" href="#"><NavLinkLabel>Facebook</NavLinkLabel></a></li>
              <li><a class="nav-link" href="#"><NavLinkLabel>YouTube</NavLinkLabel></a></li>
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- The logo across the foot, drawn in the hero's Slash Field: the
         field runs the panel's width and the logo's four forms mask it
         (styles.css), so the pattern, wave and all, is the logo; the
         frame round it is half the logo's height, so its lower half is
         cut off at the panel's foot. Mounted by the page registry with
         every [data-slash-field] (site.js). -->
    <div class="site-footer__mark" aria-hidden="true">
      <div data-slash-field class="site-footer__mark-field"></div>
      <!-- The cover: the footer's red over the field with the four forms of
           assets/logo.svg cut out of it, as shares of their 64 × 16 box
           ((x − 18.4) / 64, (y − 42.7) / 16), so only the strokes inside
           the forms show. A cover rather than a clip or mask: the field's
           canvas let its top row through both. -->
      <svg class="site-footer__mark-cover" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
        <path fill-rule="evenodd" d="M-1 -1H2V2H-1Z M0 1L0.254688 1L0.126563 0Z M0.254688 0L0.489063 0.5L0.254688 1Z M0.504688 0L0.75 0.5L0.504688 1Z M0.75625 0L1 0.5L0.75625 1Z" />
      </svg>
    </div>
  </footer>
  <div data-footer-parallax-dark="" class="footer-wrap__dark"></div>
</div>
