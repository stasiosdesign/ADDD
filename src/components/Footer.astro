---
/*
  The footer is revealed from under the page (data-depth="under",
  initDepthTransitions in src/scripts/parallax.js): in a clipping wrap, its
  contents settle out of a higher offset, the logo from a little higher
  still (data-depth-layer), and the shadow over it clears, all on the
  scroll. It sits inside the Barba container, so it is swapped with the
  page and animates with it.

  On the site's red, a full screen tall, composed on the 12-Column Grid
  (styles.css, "footer") round its anchor, the ADDD logo: its four forms,
  solid white, large across Grid Columns 1–7 at the panel's middle. Over
  it on the left the site map (Services on 1–3, Resources on 4–6); on the
  right, Grid Columns 9–12, Company and under it the newsletter signup at
  the top, and Contact at the foot, level with the social marks at the
  foot on the left. Below 992px the logo leads across the grid and the
  rest follows in pairs. No copyright or legal line.

  Every link in the groups is the site's text link (.nav-link,
  NavLinkLabel.astro), as in the nav; the social marks keep their own.
*/
import NavLinkLabel from "./NavLinkLabel.astro";
import { linkTarget, reader, siteDocument, SITE_SCOPE, telOf } from "../sanity/content";
import { homePage as HOME } from "../sanity/defaults/home";

// Every word and link of the footer comes from the Home page document's
// Footer and Newsletter signup sections in Sanity (2026-11-16), falling
// back to src/sanity/defaults/home.ts; the logo and the social marks'
// drawings stay here.
const { t, items } = reader(await siteDocument(Astro.locals), HOME);
const column = (name: string) => items(`footer.${name}`).map((l) => ({ key: l.key, label: l.t("label"), href: l.t("href") || "/" }));
const groups = [
  { kind: "services", title: "servicesTitle", list: "servicesLinks" },
  { kind: "resources", title: "resourcesTitle", list: "resourcesLinks" },
  { kind: "company", title: "companyTitle", list: "companyLinks" },
].map((g) => ({ ...g, links: column(g.list) }));
const email = t("footer.email");
const phone = t("footer.phone");
// the number as a tel: link, without the (0) and the spaces
const tel = telOf(phone);
const callHref = t("footer.callHref");

// The social marks, each drawn in a 24 × 24 box in the link's colour: the
// icon set supplied for the footer (X and Facebook removed 2026-11-16).
// Where each leads: the footer's fields in the Studio.
