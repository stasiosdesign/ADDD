---
<div data-depth="under" class="footer-wrap" {...SITE_SCOPE}>
  <footer data-depth-content class="site-footer">
    <div class="site-footer__grid">

      {groups.map((group) => (
      <div class={`site-footer__group is--${group.kind}`}>
        <p class="site-footer__eyebrow" data-page-field={`footer.${group.title}`}>{t(`footer.${group.title}`)}</p>
        <ul class="site-footer__links" data-page-list={`footer.${group.list}`}>
          {group.links.map((link) => (
          <li data-page-item={link.key}><a class="nav-link" href={link.href} {...linkTarget(link.href)}><NavLinkLabel data-page-item-field="label">{link.label}</NavLinkLabel></a></li>
          ))}
        </ul>
      </div>
      ))}

      <!-- The newsletter signup: the shared signup (styles.css), with
           the audience question, under its name -->
      <div class="site-footer__signup">
        <p class="site-footer__eyebrow" data-page-field="footer.signupTagline">{t("footer.signupTagline")}</p>
        <p class="site-footer__title" data-page-field="footer.signupHeading">{t("footer.signupHeading")}</p>
        <form class="newsletter-signup" onsubmit="return false">
          <div class="newsletter-form is--plain">
            <input type="email" name="email" placeholder={t("signup.placeholder")} aria-label={t("signup.placeholder")} required>
            <button class="newsletter-form__submit" type="submit" data-page-field="signup.button">{t("signup.button")}</button>
          </div>
          <fieldset class="newsletter-audience">
            <legend class="newsletter-audience__legend" data-page-field="signup.audienceQuestion">{t("signup.audienceQuestion")}</legend>
            <label><input type="radio" name="audience" value="practice" required> <span data-page-field="signup.practiceOption">{t("signup.practiceOption")}</span></label>
            <label><input type="radio" name="audience" value="vendor"> <span data-page-field="signup.vendorOption">{t("signup.vendorOption")}</span></label>
          </fieldset>
        </form>
      </div>

      <!-- The logo, the footer's anchor: assets/logo.svg's four forms
           (the upward triangle and the three pointing on, without the
           disc), solid in the white, its box the forms' own 64 × 16. It
           settles a little behind the words as the footer is uncovered
           (data-depth-layer, initDepthTransitions). -->
      <a class="site-footer__logo" href="/" aria-label="ADDD, home" data-depth-layer="0.06">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="18.4 42.7 64 16" preserveAspectRatio="xMinYMid meet" fill="currentColor" aria-hidden="true">
          <polygon points="18.4,58.7 34.7,58.7 26.5,42.7"/>
          <polygon points="34.7,42.7 49.7,50.7 34.7,58.7"/>
          <polygon points="50.7,42.7 66.4,50.7 50.7,58.7"/>
          <polygon points="66.8,42.7 82.4,50.7 66.8,58.7"/>
        </svg>
      </a>

      <div class="site-footer__group is--contact">
        <p class="site-footer__eyebrow" data-page-field="footer.contactTitle">{t("footer.contactTitle")}</p>
        <ul class="site-footer__links">
          {email && <li><a class="nav-link" href={`mailto:${email}`}><NavLinkLabel data-page-field="footer.email">{email}</NavLinkLabel></a></li>}
          {phone && <li><a class="nav-link" href={`tel:${tel}`}><NavLinkLabel data-page-field="footer.phone">{phone}</NavLinkLabel></a></li>}
          <li><a class="nav-link" href={callHref} {...linkTarget(callHref)}><NavLinkLabel data-page-field="footer.callLabel">{t("footer.callLabel")}</NavLinkLabel></a></li>
        </ul>
      </div>

      <!-- the social marks, at the foot on the left, level with Contact -->
      <ul class="site-footer__social" aria-label="ADDD elsewhere">
        {SOCIAL.map((social) => (
        <li>
          <a class="site-footer__social-link" href={social.href} aria-label={social.name}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox={social.viewBox ?? "0 0 24 24"} fill="currentColor" aria-hidden="true">
              {social.paths.map((d) => <path d={d} />)}
            </svg>
          </a>
        </li>
        ))}
      </ul>

    </div>
  </footer>
  <div class="depth-shade" data-depth-shade aria-hidden="true"></div>
</div>
