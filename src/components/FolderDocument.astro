---
/*
  The document a folder opens (DeckFolder.astro, opens): a sheet of paper
  drawn up out of the folder, standing low in the window and running down
  to its foot, as a page does on a desk (folder-doc.css; folder-docs.js
  runs the drawing out and back). The page behind dims a little and
  softens, and stays still. A native modal dialog, so the browser keeps
  the keyboard in it, closes it on Escape and gives the focus back to the
  folder after.

  A fixed document viewer (2026-11-04): the paper holds its place in the
  window; only what is written on it scrolls, inside it, without a
  scrollbar (on a Lenis of its own, as the page scrolls on the page's:
  folder-docs.js). The close button stands just
  outside the paper, beside its right edge, level with its top. The scrim
  behind stays put; a click on it, beside the paper, closes.

  On the paper, an editorial page in ink and greys: a label row over a
  hairline (the series and the folder's number), a line, the title, then
  "In short" and the summary between two hairlines, the body (a line in
  it written "## …" set as a heading), and what the reader takes away,
  under a hairline of its own.

  field: the Studio list item the words come from (method.documents.N),
  for the Visual editor; the title is the folder's own (titleField).
*/
interface Props {
  id: string;
  n: number;
  series: string;
  title?: string;
  titleField?: string;
  kicker?: string;
  lede?: string;
  body?: string[];
  points?: string[];
  pointsLabel?: string;
  field?: string;
}
const { id, n, series, title, titleField, kicker, lede, body = [], points = [], pointsLabel = "What you take away", field } = Astro.props;
const pad = (v: number) => String(v).padStart(2, "0");
const f = (path: string) => (field ? `${field}.${path}` : undefined);
---
<dialog class="folder-doc" id={id} aria-labelledby={`${id}-title`} data-folder-doc data-lenis-prevent>
  <div class="folder-doc__scrim" data-folder-doc-close aria-hidden="true"></div>
  <!-- the paper's place in the window, and the close button over it -->
  <div class="folder-doc__frame">
    <button type="button" class="folder-doc__close" data-folder-doc-close aria-label="Close">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
    </button>
    <article class="folder-doc__paper">
      <!-- what scrolls: the writing, inside the paper -->
      <div class="folder-doc__scroll" tabindex="-1" data-folder-doc-scroll>
        <div class="folder-doc__sheet">
          <p class="folder-doc__meta"><span>{series}</span><span>N°{pad(n)}</span></p>
          {kicker && <p class="folder-doc__kicker" data-page-field={f("kicker")}>{kicker}</p>}
          <h2 class="folder-doc__title" id={`${id}-title`} data-page-field={titleField}>{title}</h2>
          {lede && (
            <div class="folder-doc__summary">
              <p class="folder-doc__label">In short</p>
              <p class="folder-doc__lede" data-page-field={f("lede")}>{lede}</p>
            </div>
          )}
          <div class="folder-doc__body">
            {body.map((para, i) => (para.startsWith("## ") ? (
              <h3 class="folder-doc__h" data-page-field={f(`body.${i}`)}>{para.slice(3)}</h3>
            ) : (
              <p data-page-field={f(`body.${i}`)}>{para}</p>
            )))}
          </div>
          {points.length > 0 && (
            <div class="folder-doc__points">
              <p class="folder-doc__label">{pointsLabel}</p>
              <ul role="list">{points.map((point, i) => <li data-page-field={f(`points.${i}`)}>{point}</li>)}</ul>
            </div>
          )}
        </div>
      </div>
    </article>
  </div>
</dialog>
