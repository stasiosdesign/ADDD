---
/*
  The mega nav (src/styles/nav.css, initMegaNav() in src/scripts/site.js).
  It sits outside the Barba container, so it is rendered once per document
  and survives every navigation. On desktop the Services and Resources
  toggles open their panels on hover or from the keyboard; below 992px the
  burger opens a drawer and the same panels slide over it.

  The bar is built from blocks, left to right: the logo, the Tech Firms
  feature block, the group of links with Sign in, and the Contact button.
  In the drawer the feature block leads the list.

  For Tech Firms, the two toggles, AEC Jobs, About, Sign in and Contact are
  the site's text links (.nav-link, NavLinkLabel.astro: the label decodes
  and a dotted line draws under it, text-scramble.js): each keeps its
  full-height block as its hit area, and the box is drawn round its label.
  Contact's block (contact-button.css) stays as it is on hover; only its
  label scrambles. The logo keeps its own treatment: hovered, its four
  forms are drawn back into the name, A D D D, by the intro's own morph
  (src/scripts/logo-morph.js, initNavLogo() in site.js), and drawn into
  the forms again as the pointer leaves.
*/
import ArrowIcon from "./ArrowIcon.astro";
import NavLinkLabel from "./NavLinkLabel.astro";
import ServiceCard from "./ServiceCard.astro";
import StackThumb from "./StackThumb.astro";
import { lineGridRatio, type LineGridShape } from "./line-grid";
import { LETTER_COUNT, formPath } from "../scripts/logo-morph.js";
import { linkTarget, reader, siteDocument, SITE_SCOPE } from "../sanity/content";
import { homePage as HOME } from "../sanity/defaults/home";

// The forms as the morph draws them at rest, so the mark is the logo before
// any script has run, and the morph starts from exactly what is on screen.
const logoForms = Array.from({ length: LETTER_COUNT }, (_, i) => formPath(i));

// The Services cards (ServiceCard.astro), four across on the 12-Column
// Grid: each service's name and a line on it, on a card with a pattern of
// its own. Each line is set as two, by hand, after Before Revit's: the
// first the longer, the second about four fifths of it, so the four read
// as one set rather than wrapping wherever their words fall. The names here are the dropdown's own short forms; the services'
// names everywhere else stay as they are. The first ends in a word that
// turns between "shop" and "flow", as the homepage hero's word does: Work,
// then shop or flow. A card with a grid is set on a line grid of that
// shape instead of its route's ground (ServiceCard.astro, LineGrid.astro):
// the Workshop's, 6 × 4 large squares of 4 × 4 small ones, the lines
// running on one small square past the outer large lines to the card's
// edges (2026-11-04: fewer, larger squares than the first 7 × 5, and no
// crosses). The cards' height follows the first card set on a grid (nav.css,
// --sc-grid-ratio: the drawing's height over its width, line-grid.ts), so
// the card is the grid's own shape and shows it whole
//
// Every word, link and picture of the bar and its dropdowns comes from the
// Home page document's Navigation section in Sanity (2026-11-16), falling
// back to src/sanity/defaults/home.ts; the cards' patterns and the first
// card's line grid stay here, by position.
const { t, items, img } = reader(await siteDocument(Astro.locals), HOME);
const gridOf = (list: { grid?: LineGridShape }[]) => list.find((s) => s.grid)?.grid;
const FIRST_GRID: LineGridShape = { cols: 6, rows: 4, sub: 4, bleed: 1 };
const services: { key: string; href: string; name: string; cycle?: { stem: string; words: string[] }; text: string[]; grid?: LineGridShape }[] = items("nav.services").map((s, i) => {
  const words = s.lines("words");
  const stem = s.t("stem");
  return {
    key: s.key,
    href: s.t("href") || "/contact",
    name: s.t("name"),
    cycle: stem && words.length > 1 ? { stem, words } : undefined,
    text: s.lines("lines"),
    grid: i === 0 ? FIRST_GRID : undefined,
  };
});
const navLinks = items("nav.links").map((l) => ({ key: l.key, label: l.t("label"), href: l.t("href") || "/" }));
const partnersHref = t("nav.partners.href");
const signInHref = t("nav.signIn.href");
const contactHref = t("nav.contact.href");
const tile = (name: string) => ({ name: t(`nav.${name}.name`), text: t(`nav.${name}.text`), href: t(`nav.${name}.href`) });
const stacksTile = tile("stacksTile");
const databaseTile = tile("databaseTile");
const reportsTile = tile("reportsTile");
const newsletterTile = tile("newsletterTile");
const reportCover = img("nav.reportTile.image", 960);
const reportHref = t("nav.reportTile.href");
const firstGrid = gridOf(services);
const gridRatio = firstGrid ? +lineGridRatio(firstGrid).toFixed(5) : undefined;
---
<!-- is--floating from the first paint: the floating bar always (an
     experiment: NAV_ALWAYS_FLOATS in nav.js, where to undo it) -->
<nav data-menu-open="false" data-menu-wrap class="mega-nav is--floating" {...SITE_SCOPE}>
  <div class="mega-nav__bar">
    <div class="mega-nav__container">
      <div class="mega-nav__bar-start">
        <!-- Home by the wipe, like any link round the site; on the
             homepage itself it glides back to the top (isSamePage, page.js;
             nav.js). The intro is for genuine loads alone (ARRIVAL,
             site.js). -->
        <a data-menu-logo href="/" class="mega-nav__bar-logo" aria-label="ADDD home">
          <!-- The ADDD triangles from assets/logo.svg, without the circle,
               cropped to their own bounds and drawn in currentColor; each
               one a letter of the morph at rest. The stroke, in the same
               colour, is nothing at rest: the hover gives the name a touch
               of extra weight with it (initNavLogo, site.js). -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="18.4 42.7 64 16" fill="currentColor" stroke="currentColor" stroke-width="0" aria-hidden="true" class="mega-nav__bar-logo-mark">
            {logoForms.map((d) => <path data-logo-morph-letter d={d} />)}
          </svg>
        </a>
        <div data-nav-list id="mega-nav-menu" class="mega-nav__bar-inner">
          <a data-nav-list-item href={partnersHref} {...linkTarget(partnersHref)} class="mega-nav__feature nav-link">
            <NavLinkLabel class="mega-nav__bar-link-label" data-page-field="nav.partners.label">{t("nav.partners.label")}</NavLinkLabel>
          </a>
          <ul class="mega-nav__bar-list">
            <li data-nav-list-item>
              <button type="button" data-dropdown-toggle="services" aria-expanded="false" aria-controls="mega-nav-services" class="mega-nav__bar-link is--dropdown nav-link">
                <NavLinkLabel class="mega-nav__bar-link-label" data-page-field="nav.servicesLabel">{t("nav.servicesLabel")}</NavLinkLabel>
                <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon is--dropdown" />
              </button>
            </li>
            <li data-nav-list-item>
              <button type="button" data-dropdown-toggle="resources" aria-expanded="false" aria-controls="mega-nav-resources" class="mega-nav__bar-link is--dropdown nav-link">
                <NavLinkLabel class="mega-nav__bar-link-label" data-page-field="nav.resourcesLabel">{t("nav.resourcesLabel")}</NavLinkLabel>
                <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon is--dropdown" />
              </button>
            </li>
            {navLinks.map((link, i) => (
            <li data-nav-list-item>
              <a href={link.href} {...linkTarget(link.href)} class="mega-nav__bar-link nav-link"><NavLinkLabel class="mega-nav__bar-link-label" data-page-field={`nav.links.${i}.label`}>{link.label}</NavLinkLabel></a>
            </li>
            ))}
          </ul>
          <ul data-nav-list-item class="mega-nav__bar-list is--actions">
            <li class="mega-nav__bar-action is--grouped">
              <a href={signInHref} {...linkTarget(signInHref)} class="mega-nav__bar-cta nav-link"><NavLinkLabel class="mega-nav__bar-link-label" data-page-field="nav.signIn.label">{t("nav.signIn.label")}</NavLinkLabel></a>
            </li>
            <li class="mega-nav__bar-action">
              <a href={contactHref} {...linkTarget(contactHref)} class="contact-button nav-link"><NavLinkLabel class="contact-button__text" data-page-field="nav.contact.label">{t("nav.contact.label")}</NavLinkLabel></a>
            </li>
          </ul>
        </div>
        <div class="mega-nav__bar-end">
          <!-- Below 992px the bar carries Contact itself, beside the menu. -->
          <a href={contactHref} {...linkTarget(contactHref)} class="mega-nav__bar-end-cta" data-page-field="nav.contact.label">{t("nav.contact.label")}</a>
          <!-- The menu's mark: four of the logo's triangles round a square,
               each pointing on to the next — right, down, left, up — and
               turned to point at the middle while the menu is open
               (animateBurger, site.js). -->
          <button type="button" data-burger-toggle aria-label="Menu" aria-expanded="false" aria-controls="mega-nav-menu" class="mega-nav__burger">
            {[0, 90, 270, 180].map((turn) => (
              <svg data-burger-mark={turn} style={`transform:rotate(${turn}deg)`} class="mega-nav__burger-mark" viewBox="0 0 10 10" aria-hidden="true">
                <polygon points="1.5,1 9,5 1.5,9" fill="currentColor" />
              </svg>
            ))}
          </button>
        </div>
        <div data-mobile-back class="mega-nav__back">
          <button type="button" aria-label="Back to menu" class="mega-nav__bar-link is--back">
            <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon" />
            <span class="mega-nav__bar-link-label">Back</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div data-dropdown-wrapper class="mega-nav__dropdown-wrapper">
    <div data-dropdown-container class="mega-nav__dropdown-container">

      <!-- Each panel is its groups side by side, each an equal column the
           dropdown's full height, with nothing behind them but the dimmed
           page (nav.css, "The dropdowns' columns"). -->
      <div data-nav-content="services" id="mega-nav-services" role="region" aria-label="Services" class="mega-nav__dropdown-panel">
        <div class="mega-nav__dropdown-inner is--services" style={gridRatio ? `--sc-grid-ratio:${gridRatio}` : undefined}>
          {services.map((s, i) => (
            <ServiceCard data-menu-fade href={s.href} index={i} title={s.name} cycle={s.cycle} text={s.text} grid={s.grid} field={`nav.services.${i}`} />
          ))}
        </div>
      </div>

      <div data-nav-content="resources" id="mega-nav-resources" role="region" aria-label="Resources" class="mega-nav__dropdown-panel">
        <div class="mega-nav__dropdown-inner is--resources">

          <!-- Five tiles of their own (2026-11-16; nav.css, "Resources
               tiles"), in the language of the first two: each a box with
               its name in the top left and its line under it, a narrow
               seam of the dimmed page between them. On the left Free Tech
               Stacks over the Software Database; in the middle the latest
               report (its cover filling its right side) over Reports &
               Guides; on the right the newsletter, the two rows tall, its
               signup at its foot. -->

          <!-- Free Tech Stacks: its name in the top left, and behind it the
               Free Tech Stacks page's own row of cards in miniature
               (StackThumb.astro: the page's geometry, stacks and greys, run
               on past the box and clipped by it); the pointer over the box
               only lifts its middle card a little. The whole box is the
               link. -->
          <a data-menu-fade href={stacksTile.href} {...linkTarget(stacksTile.href)} class="resource-tile is--stacks">
            <span class="resource-tile__name" data-page-field="nav.stacksTile.name">{stacksTile.name}</span>
            <span class="resource-tile__desc" data-page-field="nav.stacksTile.text">{stacksTile.text}</span>
            <StackThumb />
          </a>
          <!-- the Software Database, the landscape under the stacks: kept
               plain for now -->
          <a data-menu-fade href={databaseTile.href} {...linkTarget(databaseTile.href)} class="resource-tile is--database">
            <span class="resource-tile__name" data-page-field="nav.databaseTile.name">{databaseTile.name}</span>
            <span class="resource-tile__desc" data-page-field="nav.databaseTile.text">{databaseTile.text}</span>
          </a>

          <!-- The latest report, a feature as Free Tech Stacks is: its
               title, its label and the call to read it in the top left, its cover
               filling the tile's right side. The report is the first on
               /reports; keep the two in step. -->
          <a data-menu-fade href={reportHref} {...linkTarget(reportHref)} class="resource-tile is--report">
            <span class="resource-tile__name" data-page-field="nav.reportTile.name">{t("nav.reportTile.name")}</span>
            <span class="resource-tile__label" data-page-field="nav.reportTile.label">{t("nav.reportTile.label")}</span>
            <span class="resource-tile__cta"><span data-page-field="nav.reportTile.cta">{t("nav.reportTile.cta")}</span> <ArrowIcon aria-hidden="true" class="resource-tile__cta-mark" /></span>
            <span class="resource-tile__cover" aria-hidden="true"><img src={reportCover.src} alt="" width="960" height="720" decoding="async" data-page-field="nav.reportTile.image" data-page-width="960"></span>
          </a>
          <!-- Reports & Guides, plain under it, as the Software Database is -->
          <a data-menu-fade href={reportsTile.href} {...linkTarget(reportsTile.href)} class="resource-tile is--reports">
            <span class="resource-tile__name" data-page-field="nav.reportsTile.name">{reportsTile.name}</span>
            <span class="resource-tile__desc" data-page-field="nav.reportsTile.text">{reportsTile.text}</span>
          </a>

          <!-- ADDDitive: the newsletter's page by its name, and the signup
               (the shared one, styles.css) at the tile's foot -->
          <div data-menu-fade class="resource-tile is--newsletter">
            <a href={newsletterTile.href} {...linkTarget(newsletterTile.href)} class="resource-tile__link">
              <span class="resource-tile__name" data-page-field="nav.newsletterTile.name">{newsletterTile.name}</span>
              <span class="resource-tile__desc" data-page-field="nav.newsletterTile.text">{newsletterTile.text}</span>
            </a>
            <form class="newsletter-signup resource-tile__signup" onsubmit="return false">
              <div class="newsletter-form is--plain">
                <input type="email" name="email" placeholder={t("signup.placeholder")} aria-label={t("signup.placeholder")} required>
                <button class="newsletter-form__submit" type="submit" data-page-field="signup.button">{t("signup.button")}</button>
              </div>
            </form>
          </div>

        </div>
      </div>

    </div>
  </div>

  <div data-menu-backdrop class="mega-nav__backdrop"></div>
</nav>
