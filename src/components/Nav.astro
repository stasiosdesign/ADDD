---
/*
  The mega nav (src/styles/nav.css, initMegaNav() in src/scripts/site.js).
  It sits outside the Barba container, so it is rendered once per document
  and survives every navigation. On desktop the Services and Resources
  toggles open their panels on hover or from the keyboard; below 992px the
  burger opens a drawer and the same panels slide over it.

  The bar is built from blocks, left to right: the logo, the Tech Firms
  feature block, the group of links with Sign in, and the Contact button.
  In the drawer the feature block leads the list.

  For Tech Firms, the two toggles, AEC Jobs, About and Sign in are the
  site's sliding-box links (.nav-link, NavLinkLabel.astro): each keeps its
  full-height block as its hit area, and the box is drawn round its label.
  The logo and the Contact button keep their own treatments: hovered, the
  logo's four forms are drawn back into the name, A D D D, by the intro's
  own morph (src/scripts/logo-morph.js, initNavLogo() in site.js), and
  drawn into the forms again as the pointer leaves.
*/
import ArrowIcon from "./ArrowIcon.astro";
import NavLinkLabel from "./NavLinkLabel.astro";
import ServiceCard from "./ServiceCard.astro";
import { LETTER_COUNT, formPath } from "../scripts/logo-morph.js";

// The forms as the morph draws them at rest, so the mark is the logo before
// any script has run, and the morph starts from exactly what is on screen.
const logoForms = Array.from({ length: LETTER_COUNT }, (_, i) => formPath(i));

// The Services cards (ServiceCard.astro), four across on the 12-Column
// Grid, all on the one white ground. The descriptions are the service pages' own
// claims, held to about the same length so each sets on two lines.
const services: { href: string; name: string; desc: string }[] = [
  {
    href: "/workshops-audits.html",
    name: "Workflow Workshop",
    desc: "A half-day diagnostic on a live project, with a written report.",
  },
  {
    href: "/before-revit.html",
    name: "Before Revit",
    desc: "A review of early-stage design, before Revit or Archicad.",
  },
  {
    href: "/technology-blueprint.html",
    name: "Technology Blueprint",
    desc: "An eight-week practice-wide strategy and sequenced roadmap.",
  },
  {
    href: "/advisory.html",
    name: "Ongoing Advisory",
    desc: "Monthly guidance on AI, BIM, software and digital priorities.",
  },
];
---
<nav data-menu-open="false" data-menu-wrap class="mega-nav">
  <div class="mega-nav__bar">
    <div class="mega-nav__container">
      <div class="mega-nav__bar-start">
        <!-- Barba leaves this link to the browser: going home by the logo
             is a document load that opens on the intro (initHomeLink,
             site.js). -->
        <a data-menu-logo data-barba-prevent href="/index.html" class="mega-nav__bar-logo" aria-label="ADDD home">
          <!-- The ADDD triangles from assets/logo.svg, without the circle,
               cropped to their own bounds and drawn in currentColor; each
               one a letter of the morph at rest. The stroke, in the same
               colour, is nothing at rest: the hover gives the name a touch
               of extra weight with it (initNavLogo, site.js). -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="18.4 42.7 64 16" fill="currentColor" stroke="currentColor" stroke-width="0" aria-hidden="true" class="mega-nav__bar-logo-mark">
            {logoForms.map((d) => <path data-logo-morph-letter d={d} />)}
          </svg>
        </a>
        <div data-nav-list id="mega-nav-menu" class="mega-nav__bar-inner">
          <a data-nav-list-item href="/tech-firms.html" class="mega-nav__feature nav-link">
            <NavLinkLabel class="mega-nav__bar-link-label">AEC Tech Partners</NavLinkLabel>
          </a>
          <ul class="mega-nav__bar-list">
            <li data-nav-list-item>
              <button type="button" data-dropdown-toggle="services" aria-expanded="false" aria-controls="mega-nav-services" class="mega-nav__bar-link is--dropdown nav-link">
                <NavLinkLabel class="mega-nav__bar-link-label">Services</NavLinkLabel>
                <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon is--dropdown" />
              </button>
            </li>
            <li data-nav-list-item>
              <button type="button" data-dropdown-toggle="resources" aria-expanded="false" aria-controls="mega-nav-resources" class="mega-nav__bar-link is--dropdown nav-link">
                <NavLinkLabel class="mega-nav__bar-link-label">Resources</NavLinkLabel>
                <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon is--dropdown" />
              </button>
            </li>
            <li data-nav-list-item>
              <a href="https://aectechjobs.com/" target="_blank" rel="noopener" class="mega-nav__bar-link nav-link"><NavLinkLabel class="mega-nav__bar-link-label">AEC Jobs</NavLinkLabel></a>
            </li>
            <li data-nav-list-item>
              <a href="/about.html" class="mega-nav__bar-link nav-link"><NavLinkLabel class="mega-nav__bar-link-label">About</NavLinkLabel></a>
            </li>
          </ul>
          <ul data-nav-list-item class="mega-nav__bar-list is--actions">
            <li class="mega-nav__bar-action is--grouped">
              <a href="https://app.addd.io/login" target="_blank" rel="noopener" class="mega-nav__bar-cta nav-link"><NavLinkLabel class="mega-nav__bar-link-label">Sign in</NavLinkLabel></a>
            </li>
            <li class="mega-nav__bar-action">
              <a href="/contact.html" class="contact-button">
                <span class="contact-button__block"></span>
                <span data-contact-button-element class="contact-button__element is--default">
                  <span data-contact-button-text class="contact-button__text">Contact</span>
                </span>
                <span class="contact-button__block"></span>
                <span data-contact-button-element aria-hidden="true" class="contact-button__element is--hover">
                  <span data-contact-button-text class="contact-button__text">Contact</span>
                </span>
                <span class="contact-button__block"></span>
              </a>
            </li>
          </ul>
        </div>
        <div class="mega-nav__bar-end">
          <!-- Below 992px the bar carries Contact itself, beside the menu. -->
          <a href="/contact.html" class="mega-nav__bar-end-cta">Contact</a>
          <!-- The menu's mark: four of the logo's triangles round a square,
               each pointing on to the next — right, down, left, up — and
               turned to point at the middle while the menu is open
               (animateBurger, site.js). -->
          <button type="button" data-burger-toggle aria-label="Menu" aria-expanded="false" aria-controls="mega-nav-menu" class="mega-nav__burger">
            {[0, 90, 270, 180].map((turn) => (
              <svg data-burger-mark={turn} style={`transform:rotate(${turn}deg)`} class="mega-nav__burger-mark" viewBox="0 0 10 10" aria-hidden="true">
                <polygon points="1.5,1 9,5 1.5,9" fill="currentColor" />
              </svg>
            ))}
          </button>
        </div>
        <div data-mobile-back class="mega-nav__back">
          <button type="button" aria-label="Back to menu" class="mega-nav__bar-link is--back">
            <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon" />
            <span class="mega-nav__bar-link-label">Back</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div data-dropdown-wrapper class="mega-nav__dropdown-wrapper">
    <div data-dropdown-container class="mega-nav__dropdown-container">

      <!-- Each panel is its groups side by side, each an equal column the
           dropdown's full height, with nothing behind them but the dimmed
           page (nav.css, "The dropdowns' columns"). -->
      <div data-nav-content="services" id="mega-nav-services" role="region" aria-label="Services" class="mega-nav__dropdown-panel">
        <div class="mega-nav__dropdown-inner is--services">
          {services.map((s, i) => (
            <ServiceCard data-menu-fade href={s.href} index={i} title={s.name} text={s.desc} />
          ))}
        </div>
      </div>

      <div data-nav-content="resources" id="mega-nav-resources" role="region" aria-label="Resources" class="mega-nav__dropdown-panel">
        <div class="mega-nav__dropdown-inner is--resources">

          <!-- The three Resources blocks, in the Services cards' language
               (nav.css, "Resources blocks"): a header of the column's
               mark in a compact square and its name beside it; under it
               the column's lead link; under that a feature on the field's
               tone. Every row of text hangs from the name's line. -->

          <!-- Explore — the interactive research layer: the Stack applies the
               knowledge, the database exposes the software landscape under it. -->
          <div data-menu-fade class="resource-block">
            <span class="resource-block__mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16.2 7.79999L14.1 14.1L7.79999 16.2L9.89999 9.89999L16.2 7.79999Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor"></path></svg></span>
            <span class="resource-block__title">Explore</span>
            <a href="/stack-diagnostic.html" class="resource-block__row resource-block__lead">
              <span class="resource-block__name">Free Tech Stacks</span>
              <span class="resource-block__desc">See how software fits together across architecture workflows.</span>
            </a>
            <a href="https://app.addd.io/" target="_blank" rel="noopener" class="resource-block__row resource-block__field">
              <span class="resource-block__name">Software Database &#8599;</span>
              <span class="resource-block__desc">ADDD&rsquo;s research into 1,700+ AEC software solutions.</span>
            </a>
          </div>

          <!-- Reports — the index link, then the latest report as the feature.
               The report is the first on reports.html; keep the two in step. -->
          <div data-menu-fade class="resource-block">
            <span class="resource-block__mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 18L5 13.5L16.5 2H17.5L20 4.5V5.5L8.5 17L4 18Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M14.5 3.5L18.5 7.5" stroke="currentColor" stroke-miterlimit="10"></path><path d="M3.5 21.5H20.5" stroke="currentColor" stroke-miterlimit="10"></path></svg></span>
            <span class="resource-block__title">Reports</span>
            <a href="/reports.html" class="resource-block__row resource-block__lead">
              <span class="resource-block__name">Reports &amp; Guides</span>
              <span class="resource-block__desc">Deeper research into technology, AI, workflows and practice.</span>
            </a>
            <a href="/report-template.html" class="resource-block__row resource-block__field resource-block__report">
              <span class="resource-block__report-text">
                <span class="resource-block__label">Latest report</span>
                <span class="resource-block__name">The state of AI in architecture</span>
                <span class="resource-block__cta">Read the report <ArrowIcon aria-hidden="true" class="resource-block__cta-mark" /></span>
              </span>
              <span class="resource-block__cover" aria-hidden="true">
                <img src="/assets/images/allister-podium-full.jpg" alt="" loading="lazy">
              </span>
            </a>
          </div>

          <!-- ADDDitive — the newsletter's page, then the signup as the
               feature: the shared signup (styles.css) on the field's tone,
               which frames it, so it needs no outline of its own. -->
          <div data-menu-fade class="resource-block">
            <span class="resource-block__mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 5.5H21.5V18.5H2.5V5.5Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M2.5 5.5L12 12.5L21.5 5.5" stroke="currentColor" stroke-miterlimit="10"></path></svg></span>
            <span class="resource-block__title">Newsletter</span>
            <a href="/newsletter.html" class="resource-block__row resource-block__lead">
              <span class="resource-block__name">ADDDitive Newsletter</span>
              <span class="resource-block__desc">How technology actually gets used to make architecture.</span>
            </a>
            <form class="newsletter-signup resource-block__row resource-block__field resource-block__signup" onsubmit="return false">
              <div class="newsletter-form is--plain">
                <input type="email" name="email" placeholder="Your email" aria-label="Your email" required>
                <button class="newsletter-form__submit" type="submit">Subscribe</button>
              </div>
              <fieldset class="newsletter-audience">
                <legend class="newsletter-audience__legend">Which describes you?</legend>
                <label><input type="radio" name="audience" value="practice" required> I run or work in a practice</label>
                <label><input type="radio" name="audience" value="vendor"> I sell to practices</label>
              </fieldset>
            </form>
          </div>

        </div>
      </div>

    </div>
  </div>

  <div data-menu-backdrop class="mega-nav__backdrop"></div>
</nav>
