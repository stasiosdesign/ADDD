---
/*
  The mega nav (src/styles/nav.css, initMegaNav() in src/scripts/site.js).
  It sits outside the Barba container, so it is rendered once per document
  and survives every navigation. On desktop the Services and Resources
  toggles open their panels on hover or from the keyboard; below 992px the
  burger opens a drawer and the same panels slide over it.

  The bar is built from blocks, left to right: the logo, the Tech Firms
  feature block, the group of links with Sign in, and the Contact button.
  In the drawer the feature block leads the list.

  For Tech Firms, the two toggles, AEC Jobs, About and Sign in are the
  site's sliding-box links (.nav-link, NavLinkLabel.astro): each keeps its
  full-height block as its hit area, and the box is drawn round its label.
  The logo and the Contact button keep their own treatments: hovered, the
  logo's four forms are drawn back into the name, A D D D, by the intro's
  own morph (src/scripts/logo-morph.js, initNavLogo() in site.js), and
  drawn into the forms again as the pointer leaves.
*/
import ArrowIcon from "./ArrowIcon.astro";
import NavLinkLabel from "./NavLinkLabel.astro";
import { LETTER_COUNT, formPath } from "../scripts/logo-morph.js";

// The forms as the morph draws them at rest, so the mark is the logo before
// any script has run, and the morph starts from exactly what is on screen.
const logoForms = Array.from({ length: LETTER_COUNT }, (_, i) => formPath(i));

// The Services cards. Each leads with its graphic in a fixed frame, so a
// custom graphic can take its place later without touching the card. For
// now only ADDDvisory has one, a photograph, greyscaled; the frame of a card
// without one is left as a plain grey placeholder of the same size.
// The photograph is from Unsplash (Unsplash License), served from its image
// CDN at the frame's size. Not lazy: the nav outlives every page change, so
// it loads once, at low priority, and is there when the nav opens.
const unsplash = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=720&h=450&q=70`;
const services = [
  {
    href: "workshops-audits.html",
    name: "Workflow Workshop",
    desc: "Half-day diagnostic using a live project",
  },
  {
    href: "before-revit.html",
    name: "Before Revit",
    desc: "Early design workflow, before Revit or Archicad",
  },
  {
    href: "technology-blueprint.html",
    name: "Technology Blueprint",
    desc: "Practice-wide technology strategy and priorities",
  },
  {
    href: "advisory.html",
    name: "ADDDvisory",
    desc: "Ongoing strategic guidance for your practice",
    image: unsplash("1770921178335-ef2cd8b00dea"), // a white interior's lines
  },
];
---
<nav data-menu-open="false" data-menu-wrap class="mega-nav">
  <div class="mega-nav__bar">
    <div class="mega-nav__container">
      <div class="mega-nav__bar-start">
        <!-- Barba leaves this link to the browser: going home by the logo
             is a document load that opens on the intro (initHomeLink,
             site.js). -->
        <a data-menu-logo data-barba-prevent href="index.html" class="mega-nav__bar-logo" aria-label="ADDD home">
          <!-- The ADDD triangles from assets/logo.svg, without the circle,
               cropped to their own bounds and drawn in currentColor; each
               one a letter of the morph at rest. The stroke, in the same
               colour, is nothing at rest: the hover gives the name a touch
               of extra weight with it (initNavLogo, site.js). -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="18.4 42.7 64 16" fill="currentColor" stroke="currentColor" stroke-width="0" aria-hidden="true" class="mega-nav__bar-logo-mark">
            {logoForms.map((d) => <path data-logo-morph-letter d={d} />)}
          </svg>
        </a>
        <div data-nav-list id="mega-nav-menu" class="mega-nav__bar-inner">
          <a data-nav-list-item href="tech-firms.html" class="mega-nav__feature nav-link">
            <NavLinkLabel class="mega-nav__bar-link-label">For AEC Tech Firms</NavLinkLabel>
          </a>
          <ul class="mega-nav__bar-list">
            <li data-nav-list-item>
              <button type="button" data-dropdown-toggle="services" aria-expanded="false" aria-controls="mega-nav-services" class="mega-nav__bar-link is--dropdown nav-link">
                <NavLinkLabel class="mega-nav__bar-link-label">Services</NavLinkLabel>
                <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon is--dropdown" />
              </button>
            </li>
            <li data-nav-list-item>
              <button type="button" data-dropdown-toggle="resources" aria-expanded="false" aria-controls="mega-nav-resources" class="mega-nav__bar-link is--dropdown nav-link">
                <NavLinkLabel class="mega-nav__bar-link-label">Resources</NavLinkLabel>
                <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon is--dropdown" />
              </button>
            </li>
            <li data-nav-list-item>
              <a href="https://aectechjobs.com/" target="_blank" rel="noopener" class="mega-nav__bar-link nav-link"><NavLinkLabel class="mega-nav__bar-link-label">AEC Jobs</NavLinkLabel></a>
            </li>
            <li data-nav-list-item>
              <a href="about.html" class="mega-nav__bar-link nav-link"><NavLinkLabel class="mega-nav__bar-link-label">About</NavLinkLabel></a>
            </li>
          </ul>
          <ul data-nav-list-item class="mega-nav__bar-list is--actions">
            <li class="mega-nav__bar-action is--grouped">
              <a href="https://app.addd.io/login" target="_blank" rel="noopener" class="mega-nav__bar-cta nav-link"><NavLinkLabel class="mega-nav__bar-link-label">Sign in</NavLinkLabel></a>
            </li>
            <li class="mega-nav__bar-action">
              <a href="contact.html" class="contact-button">
                <span class="contact-button__block"></span>
                <span data-contact-button-element class="contact-button__element is--default">
                  <span data-contact-button-text class="contact-button__text">Contact</span>
                </span>
                <span class="contact-button__block"></span>
                <span data-contact-button-element aria-hidden="true" class="contact-button__element is--hover">
                  <span data-contact-button-text class="contact-button__text">Contact</span>
                </span>
                <span class="contact-button__block"></span>
              </a>
            </li>
          </ul>
        </div>
        <div class="mega-nav__bar-end">
          <button type="button" data-burger-toggle aria-label="Menu" aria-expanded="false" aria-controls="mega-nav-menu" class="mega-nav__burger">
            <span data-burger-line="top" class="mega-nav__burger-line"></span>
            <span data-burger-line="mid" class="mega-nav__burger-line"></span>
            <span data-burger-line="bot" class="mega-nav__burger-line"></span>
          </button>
        </div>
        <div data-mobile-back class="mega-nav__back">
          <button type="button" aria-label="Back to menu" class="mega-nav__bar-link is--back">
            <ArrowIcon aria-hidden="true" class="mega-nav__bar-link-icon" />
            <span class="mega-nav__bar-link-label">Back</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div data-dropdown-wrapper class="mega-nav__dropdown-wrapper">
    <div data-dropdown-container class="mega-nav__dropdown-container">
      <div class="mega-nav__dropdown-bg"></div>

      <div data-nav-content="services" id="mega-nav-services" role="region" aria-label="Services" class="mega-nav__dropdown-panel">
        <div class="mega-nav__dropdown-inner">
          <div class="mega-nav__panel-col is--services">
            <div class="mega-nav__service-grid">
              {services.map((s) => (
                <a data-menu-fade href={s.href} class="mega-nav__service-card">
                  <span class="mega-nav__service-card-graphic" aria-hidden="true">
                    {s.image && <img src={s.image} alt="" fetchpriority="low" decoding="async" />}
                  </span>
                  <span class="mega-nav__panel-link-text">{s.name}</span>
                  <span class="mega-nav__panel-link-desc">{s.desc}</span>
                  <span class="mega-nav__service-card-foot">
                    <span class="mega-nav__service-card-arrow" aria-hidden="true"><ArrowIcon /></span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div data-nav-content="resources" id="mega-nav-resources" role="region" aria-label="Resources" class="mega-nav__dropdown-panel">
        <div class="mega-nav__dropdown-inner is--resources">

          <!-- Explore — the interactive research layer: the Stack applies the
               knowledge, the database exposes the software landscape under it. -->
          <div data-menu-fade class="mega-nav__panel-col"><span class="mega-nav__panel-label">Explore</span>
            <ul class="mega-nav__panel-list">
              <li>
                <a href="stack-diagnostic.html" class="mega-nav__panel-link is--lead">
                  <span class="mega-nav__panel-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M11.4508 1.67245C11.7836 1.45159 12.2164 1.45159 12.5492 1.67245L22.0492 7.977C22.3265 8.16103 22.4932 8.47172 22.4932 8.80453V15.1954C22.4932 15.5283 22.3265 15.8389 22.0492 16.023L12.5492 22.3275C12.2164 22.5484 11.7836 22.5484 11.4508 22.3275L1.95082 16.023C1.67352 15.8389 1.50682 15.5283 1.50682 15.1954V8.80453C1.50682 8.47172 1.67352 8.16103 1.95082 7.977L11.4508 1.67245ZM3.49318 10.6556V13.3303L5.49463 11.9839L3.49318 10.6556ZM7.28607 13.1727L4.28768 15.1898L11.0068 19.6489V15.642L7.28607 13.1727ZM12.9932 15.642V19.6489L19.7123 15.1898L16.7139 13.1727L12.9932 15.642ZM18.5054 11.9839L20.5068 13.3303V10.6556L18.5054 11.9839ZM19.7039 8.80453L16.7214 10.7838L12.9932 8.27567V4.35109L19.7039 8.80453ZM11.0068 4.35109V8.27567L7.27856 10.7838L4.29615 8.80453L11.0068 4.35109ZM12 10.0015L9.07 11.9726L12 13.9171L14.93 11.9726L12 10.0015Z" fill="currentColor"></path></svg></span>
                  <span class="mega-nav__panel-link-body">
                    <span class="mega-nav__panel-link-text">Free Tech Stacks</span>
                    <span class="mega-nav__panel-link-desc">See how software fits together across architecture workflows.</span>
                  </span>
                </a>
              </li>
              <li>
                <a href="https://app.addd.io/" target="_blank" rel="noopener" class="mega-nav__panel-link">
                  <span class="mega-nav__panel-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16.2 7.79999L14.1 14.1L7.79999 16.2L9.89999 9.89999L16.2 7.79999Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor"></path></svg></span>
                  <span class="mega-nav__panel-link-body">
                    <span class="mega-nav__panel-link-text">Software Database &#8599;</span>
                    <span class="mega-nav__panel-link-desc">ADDD&rsquo;s research into 1,700+ AEC software solutions.</span>
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Reports — the index link, then the latest report as one featured
               card. The report is the first on reports.html; keep the two in step. -->
          <div data-menu-fade class="mega-nav__panel-col is--tint"><span class="mega-nav__panel-label">Reports</span>
            <ul class="mega-nav__panel-list">
              <li>
                <a href="reports.html" class="mega-nav__panel-link is--lead">
                  <span class="mega-nav__panel-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 18L5 13.5L16.5 2H17.5L20 4.5V5.5L8.5 17L4 18Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M14.5 3.5L18.5 7.5" stroke="currentColor" stroke-miterlimit="10"></path><path d="M3.5 21.5H20.5" stroke="currentColor" stroke-miterlimit="10"></path></svg></span>
                  <span class="mega-nav__panel-link-body">
                    <span class="mega-nav__panel-link-text">Reports &amp; Guides</span>
                    <span class="mega-nav__panel-link-desc">Deeper research into technology, AI, workflows and practice.</span>
                  </span>
                </a>
              </li>
              <li>
                <a href="report-template.html" class="mega-nav__featured">
                  <span class="mega-nav__featured-media" aria-hidden="true">
                    <img src="assets/images/allister-podium-full.jpg" alt="" loading="lazy">
                  </span>
                  <span class="mega-nav__featured-text">
                    <span class="mega-nav__panel-label mega-nav__featured-label">Latest report</span>
                    <span class="mega-nav__panel-link-text">The state of AI in architecture</span>
                    <span class="mega-nav__featured-cta">Read the report <ArrowIcon aria-hidden="true" class="mega-nav__featured-cta-mark" /></span>
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <!-- ADDDitive — the newsletter, set as a resource item on the same
               row as the others (icon chip, name, one line of description)
               so the column reads as part of the same list rather than a
               panel of its own, with the signup compact underneath it. -->
          <div data-menu-fade class="mega-nav__panel-col is--colored"><span class="mega-nav__panel-label">Newsletter</span>
            <ul class="mega-nav__panel-list">
              <li>
                <a href="newsletter.html" class="mega-nav__panel-link is--lead">
                  <span class="mega-nav__panel-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 5.5H21.5V18.5H2.5V5.5Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M2.5 5.5L12 12.5L21.5 5.5" stroke="currentColor" stroke-miterlimit="10"></path></svg></span>
                  <span class="mega-nav__panel-link-body">
                    <span class="mega-nav__panel-link-text">ADDDitive Newsletter</span>
                    <span class="mega-nav__panel-link-desc">How technology actually gets used to make architecture.</span>
                  </span>
                </a>
              </li>
            </ul>
            <form class="newsletter-signup" onsubmit="return false">
              <div class="newsletter-form mega-nav__signup">
                <input type="email" name="email" placeholder="Your email" aria-label="Your email" required>
                <button class="newsletter-form__submit" type="submit">Subscribe</button>
              </div>
              <fieldset class="newsletter-audience">
                <legend class="newsletter-audience__legend">Which describes you?</legend>
                <label><input type="radio" name="audience" value="practice" required> I run or work in a practice</label>
                <label><input type="radio" name="audience" value="vendor"> I sell to practices</label>
              </fieldset>
            </form>
          </div>

        </div>
      </div>

    </div>
  </div>

  <div data-menu-backdrop class="mega-nav__backdrop"></div>
</nav>
