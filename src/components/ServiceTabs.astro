---
/*
  The AEC Tech Partners page's statements as one panel that changes in
  place, on a band of the ink. Under its own heading (the section's
  tagline, set as "What actually costs you time" is, in white), the panel
  sticks under the nav while the page scrolls on past it, and the scroll
  takes it through the statements in turn, then lets it go
  (service-tabs.js).

  Two halves across Grid Columns 1–12 (styles.css, "service tabs"): on the
  left, Grid Columns 1–6, a square of the page's blue, a small + near each corner
  (.corner-marks), and one statement at a time in its middle, large and
  centred, with nothing else, and at its foot the statements' numbers,
  01 on, each a square of its own that fills white as the scroll goes
  through its statement, which say how many there are, which one is
  shown, and take the scroll to any of them; on the right, Grid Columns
  7–12, on the ink, one dotted lattice (dot-field.js) for the whole
  panel, and over it a drawing for each statement (ServiceDiagram.astro,
  by position), moving, set one under another in a tall strip that the
  scroll carries up through the panel.

  The strip moves with the scroll, never locked, slowest round each
  statement so it can be read; the statements change by a fade, one out
  and the next in. Without the script the first shows, as written here.
*/
import ServiceDiagram from "./ServiceDiagram.astro";

interface Props {
  /** The statements, one shown at a time. */
  statements: string[];
  /** The section's tagline, the heading over the panel. */
  label: string;
  /** The page document's section the words are bound to. */
  field?: string;
}
const { statements, label, field = "services" } = Astro.props;
---
<!-- the heading, set as the cost section's is, scrolling with the page -->
<div class="problem-head service-tabs-head">
  <h2 class="problem-head__h" data-split="heading" data-page-field={`${field}.tagline`}>{label}</h2>
</div>

<!-- the scroll the panel sticks for: a stretch for each statement -->
<div class="service-tabs" data-service-tabs style={`--st-count:${statements.length}`}>
  <div class="service-tabs__panel" data-service-tabs-panel>
    <div class="service-tabs__copy">
      <span class="corner-marks service-tabs__marks" aria-hidden="true"></span>

      <!-- every statement in one cell, the cell the size of the largest -->
      <div class="service-tabs__slides">
        {statements.map((statement, i) => (
        <div class:list={["service-tabs__slide", { "is--active": i === 0 }]} id={`service-tabs-panel-${i + 1}`} role="tabpanel" aria-labelledby={`service-tabs-tab-${i + 1}`} data-service-tabs-item>
          <p class="service-tabs__statement" data-page-field={`${field}.statements.${i}`}>{statement}</p>
        </div>
        ))}
      </div>

      <div class="service-tabs__nav" role="tablist" aria-label={label}>
        {statements.map((statement, i) => (
        <button
          type="button"
          class:list={["service-tabs__pos", { "is--active": i === 0 }]}
          id={`service-tabs-tab-${i + 1}`}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`service-tabs-panel-${i + 1}`}
          aria-label={statement}
          tabindex={i === 0 ? "0" : "-1"}
          data-service-tabs-button
        ><span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><span class="service-tabs__pos-fill" data-service-tabs-fill aria-hidden="true">{String(i + 1).padStart(2, "0")}</span></button>
        ))}
      </div>
    </div>

    <!-- one lattice for the whole panel, set out from the first drawing's
         ground (dot-field.js), still; over it the drawings, one under
         another in a strip the panel's height each, carried up through
         the panel (service-tabs.js), each lifted or lowered onto the same
         ground line so every one stands on the one lattice -->
    <div class="service-tabs__media">
      <div class="service-tabs__pattern" data-iso-field data-iso-ground=".service-tabs__diagram" aria-hidden="true"></div>
      <div class="service-tabs__track" data-service-tabs-track>
        {statements.map((_, i) => (
        <div class="service-tabs__visual" style={`--st-i:${i}`} data-service-tabs-visual data-iso-frame aria-hidden="true">
          <ServiceDiagram index={i} class="service-tabs__diagram" />
        </div>
        ))}
      </div>
    </div>
  </div>
</div>
