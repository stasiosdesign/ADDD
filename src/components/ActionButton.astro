---
/*
  The site's CTA (src/styles/action-button.css): a compact slab as long
  as its label, the label face in capitals and the site's arrow at its
  far end, in two variants —

    primary    ink; sweeps to the accent on hover
    secondary  light grey; never takes the accent

  — so a pair of them reads as one system with one clear lead. On a dark
  ground the pair inverts by itself.

  The label is the slot. With an href it is a link; without one it is a
  <button>, for a form's submit (pass type="submit"). Any other
  attributes — target, rel, type — pass through.
*/
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  [attr: string]: unknown;
}

const { href, variant = "primary", ...attrs } = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag href={href} class:list={["action-button", { "is--secondary": variant === "secondary" }]} {...attrs}>
  <span class="action-button__bg"><span class="action-button__bg-hover"></span></span>
  <span class="action-button__inner">
    <span class="action-button__mask"><span class="action-button__text"><slot /></span></span>
    <ArrowIcon class="action-button__arrow" aria-hidden="true" />
  </span>
</Tag>
