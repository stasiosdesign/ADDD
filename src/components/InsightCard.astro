---
/*
  A report or newsletter card: the featured image with the category chip
  and the arrow chip riding on it, then the title, an optional line of
  description and the metadata row.

  `filter` makes the card an item of an archive filter group
  (initFilterGroups() in src/scripts/site.js): the category chip doubles
  as the card's filter token, so the token is never written out twice.

  `editorial` (the homepage's Research & Insights, 2026-11-05, second pass
  after the user's reference): the site's dotted rule across the top, a row
  of the card's number in a square, the title and a square arrow, the line
  of description, then the picture in a frame; no category, no metadata.
  Pointed at (or the deck's front card on a touch screen), the rule and
  the arrow take the red (styles.css, "Research & Insights, editorial").
*/
import ArrowIcon from "./ArrowIcon.astro";

export interface Props {
  href: string;
  image: string;
  category: string;
  title: string;
  description?: string;
  meta: string[];
  filter?: boolean;
  editorial?: boolean;
  n?: number;
}

const { href, image, category, title, description, meta, filter = false, editorial = false, n } = Astro.props;
---
{editorial ? (
<a class="insight-card is--editorial" href={href}>
  <span class="insight-card__rule" aria-hidden="true"></span>
  <div class="insight-card__top">
    <span class="insight-card__mark" aria-hidden="true">{n !== undefined ? String(n).padStart(2, "0") : ""}</span>
    <h3 class="insight-card__h">{title}</h3>
    <span class="insight-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9.5M8.5 4l4 4-4 4" /></svg></span>
  </div>
  {description && <p class="insight-card__p">{description}</p>}
  <div class="insight-card__media">
    <img class="insight-card__img" src={image} alt="" loading="lazy" draggable="false">
  </div>
</a>
) : (
<a class:list={["insight-card", { "filter-item": filter }]} data-filter-name={filter ? "" : undefined} href={href}>
  <div class="insight-card__media">
    <img class="insight-card__img" src={image} alt="" loading="lazy">
    <span class="tagline tagline--sm insight-card__label" data-filter-name-collect={filter ? category.toLowerCase() : undefined}>{category}</span>
    <span class="insight-card__arrow" aria-hidden="true"><ArrowIcon /></span>
  </div>
  <div class="insight-card__body">
    <h3 class="insight-card__h">{title}</h3>
    {description && <p class="insight-card__p">{description}</p>}
    <span class="insight-card__meta">{meta.map((item) => <span>{item}</span>)}</span>
  </div>
</a>
)}
