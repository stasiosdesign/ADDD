---
/*
  The homepage's approach section: "Fix the system, not the symptoms", then
  the three steps as a scroll-driven stack. Built on the supplied Scroll-driven
  Stack Timeline spec (after the stack section on sui.io), adapted to three
  cards and to the site: the steps zig-zag either side of a centre rail, and a
  short window of the rail's dotted line rides at the middle of the viewport
  with the logo's triangle on it, pointing the way the page is scrolling,
  passing each card in turn. Every card is open, with its
  step drawn as a small live schematic that draws in as the card comes into
  view.

  Styles: src/styles/approach-stack.css. Behaviour: src/scripts/
  approach-stack.js, mounted by the page registry in src/scripts/site.js.
  Without the script the schematics show their static drawing.

  The steps are data, so the copy, the layout and the script all read the
  same list. Each step's schematic is a small flat drawing in a 400 × 256
  viewBox, a few plain shapes and one red signal:

    - map    Understand: four nodes, the signal zig-zagging between them
             against the straight dashed line it is meant to take;
    - trace  Diagnose: the practice as a stack of layers, scanned down
             through until the one the trouble starts in is found;
    - rank   Prioritise: findings as bars of impact, the tallest in red,
             re-ranking as the picture changes.
*/
import ArrowIcon from "./ArrowIcon.astro";


const steps = [
  {
    n: "01",
    title: "Understand",
    text: "Map how work, tools, information and decisions actually move through the practice, not how they are supposed to.",
    schematic: "map",
  },
  {
    n: "02",
    title: "Diagnose",
    text: "Trace the causes across workflows, BIM, software, infrastructure, data, costs, roles and AI, rather than treating each issue separately.",
    schematic: "trace",
  },
  {
    n: "03",
    title: "Prioritise",
    text: "Turn what we find into clear priorities: what should change first, who should own it and where investment will have the most impact.",
    schematic: "rank",
  },
];

// The schematics are flat hairline drawings: a few plain shapes on the
// card's ground and one red signal, nothing labelled. Coordinates are in
// the 400 × 256 viewBox.

// Understand: four nodes — work, tools, information, decisions. The route
// work actually takes zig-zags between them; the one it is meant to take is
// the dashed line straight from work to decisions. "at" is how far along
// the route each node sits (its share of the route's length), so the
// signal can light it as it passes.
const mapRoute = [[60, 128], [60, 64], [200, 64], [200, 192], [300, 192], [300, 128], [340, 128]];
const mapNodes = [[60, 128], [130, 64], [250, 192], [340, 128]];
const mapLengths = mapRoute.slice(1).map(([x, y], i) => Math.abs(x - mapRoute[i][0]) + Math.abs(y - mapRoute[i][1]));
const mapTotal = mapLengths.reduce((a, b) => a + b, 0);
// the distance along the route to a point on it
function mapAt([px, py]) {
  let run = 0;
  for (let i = 1; i < mapRoute.length; i++) {
    const [ax, ay] = mapRoute[i - 1];
    const [bx, by] = mapRoute[i];
    const on = (ax === bx && px === ax && py >= Math.min(ay, by) && py <= Math.max(ay, by))
      || (ay === by && py === ay && px >= Math.min(ax, bx) && px <= Math.max(ax, bx));
    if (on) return (run + Math.abs(px - ax) + Math.abs(py - ay)) / mapTotal;
    run += mapLengths[i - 1];
  }
  return 0;
}
const map = {
  route: "M" + mapRoute.map((p) => p.join(" ")).join("L"),
  intended: `M${mapRoute[0].join(" ")}L${mapRoute[mapRoute.length - 1].join(" ")}`,
  nodes: mapNodes.map(([x, y]) => ({ x, y, at: +mapAt([x, y]).toFixed(3) })),
};

// Diagnose: the practice as a stack of layers — workflows, BIM, software,
// data and the rest. A scan runs down through them, finds the one the
// trouble starts in, and the layers above it draw back to open it up.
const TRACE_CAUSE = 3;
const trace = {
  rows: [47, 81, 115, 149, 183],
  marker: { x: 104, y: 152, size: 12 },
};

// Prioritise: four findings as bars on one baseline, their heights the
// impact each would have; the tallest, what should change first, in red.
// The heights here are the ranked picture the card shows without its
// script; the script runs its own figures.
const RANK_BASE = 216;
const rankX = [84, 148, 212, 276];
const rankRest = [96, 152, 64, 120];
const rankFirst = rankRest.indexOf(Math.max(...rankRest));
---
<section class="approach-stack" id="approach" data-approach-stack>
  <div class="approach-stack__intro">
    <h2 class="approach-stack__h">Fix the system, not the symptoms</h2>
    <div class="approach-stack__lede">
      <p class="text-md">Technology problems rarely exist in isolation. ADDD looks across the practice to understand what is connected, what is causing friction, and what should change first.</p>
      <p class="tagline tagline--sm">The ADDD approach</p>
    </div>
  </div>

  <div class="approach-stack__grid">
    <div class="approach-stack__rail" aria-hidden="true" data-approach-stack-rail>
      <div class="approach-stack__window" data-approach-stack-window>
        <span class="approach-stack__dots" data-approach-stack-dots></span>
        <span class="approach-stack__trail is--top" data-approach-stack-trail="top"></span>
        <span class="approach-stack__cube"><ArrowIcon aria-hidden="true" class="approach-stack__mark" data-approach-stack-mark /></span>
        <span class="approach-stack__trail is--bottom" data-approach-stack-trail="bottom"></span>
      </div>
    </div>

    <ol class="approach-stack__list" role="list" style={`--steps:${steps.length}`}>
      {steps.map((step, i) => (
        <li class={`approach-stack__slot ${i % 2 ? "is--right" : "is--left"}`} style={`--step:${i + 1}`} data-approach-stack-slot>
          <article class="step-card" data-step-card>
            <header class="step-card__head">
              <span class="step-card__badge">{step.n}</span>
              <h3 class="step-card__title">{step.title}</h3>
            </header>

            <div class="step-card__panel">
              <div class="step-card__media">
                {step.schematic === "map" && (
                  <svg class="schematic" data-schematic="map" viewBox="0 0 400 256" fill="none" aria-hidden="true" focusable="false">
                    <path class="schematic__route is--intended" data-s="intended" d={map.intended} />
                    <path class="schematic__route" data-s="route" d={map.route} pathLength="1" />
                    <path class="schematic__pulse" data-s="pulse" d={map.route} pathLength="1" />
                    {map.nodes.map((node) => (
                      <rect class="schematic__shape" data-s="node" data-at={node.at} x={node.x - 10} y={node.y - 10} width="20" height="20" rx="2" />
                    ))}
                  </svg>
                )}

                {step.schematic === "trace" && (
                  <svg class="schematic" data-schematic="trace" data-cause={TRACE_CAUSE} viewBox="0 0 400 256" fill="none" aria-hidden="true" focusable="false">
                    {trace.rows.map((y) => (
                      <rect class="schematic__shape" data-s="layer" x="90" y={y} width="220" height="18" rx="2" />
                    ))}
                    <rect class="schematic__ping" data-s="ping" x={trace.marker.x} y={trace.marker.y} width={trace.marker.size} height={trace.marker.size} />
                    <rect class="schematic__marker" data-s="marker" x={trace.marker.x} y={trace.marker.y} width={trace.marker.size} height={trace.marker.size} />
                  </svg>
                )}

                {step.schematic === "rank" && (
                  <svg class="schematic" data-schematic="rank" data-base={RANK_BASE} viewBox="0 0 400 256" fill="none" aria-hidden="true" focusable="false">
                    <path class="schematic__base" data-s="base" d={`M60 ${RANK_BASE}H340`} />
                    {rankX.map((x, k) => (
                      <rect class:list={["schematic__shape", { "is--first": k === rankFirst }]} data-s="bar" x={x} y={RANK_BASE - rankRest[k]} width="40" height={rankRest[k]} rx="2" />
                    ))}
                  </svg>
                )}
              </div>
            </div>

            <div class="step-card__foot">
              <span class="step-card__elbow" aria-hidden="true"></span>
              <p class="step-card__p">{step.text}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
