---
/*
  The homepage's approach section, after its statement (StickyTitle.astro):
  the three steps as a scroll-driven stack. Built on the supplied Scroll-driven
  Stack Timeline spec (after the stack section on sui.io), adapted to three
  cards and to the site: the steps zig-zag either side of a centre rail, and a
  short window of the rail's dotted line rides at the middle of the viewport
  with the logo's triangle on it, pointing the way the page is scrolling,
  passing each card in turn. Every card is open, with its
  step drawn as a small live figure that comes alive as the card comes into
  view.

  Styles: src/styles/approach-stack.css. Behaviour: src/scripts/
  approach-stack.js, mounted by the page registry in src/scripts/site.js.
  The script draws every step's figure.

  The steps are data, so the copy, the layout and the script all read the
  same list. Each step's drawing is a Hairline figure, an isometric line
  drawing in a 400 × 320 frame of which the card shows the middle
  400 × 256: rounded solids in hairlines, dashed setting-out, one bright
  stroke in red, and an unseen pointer walking it while the card is on
  screen, which a real one takes over:

    - map    Understand ("settle", after Hairline's, the ADDD mark on its hub,
             src/scripts/understand-figure.js): twelve tiles lie crooked
             round a hub; as the pointer nears it they slide into a tree
             and the links draw in — what actually connects to what;
    - trace  Diagnose ("Strata", src/scripts/approach-figures.js): the
             practice as a tall stack of slabs; the pointer picks a layer
             and the slabs above lift off to open it up, the layer the
             trouble starts in open at rest — a drawing that reads down;
    - rank   Prioritise ("Massing", the same file): findings as towers of
             impact on a plinth; they rise where the pointer puts the
             effort, the tallest in red.
*/
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  /** The three steps' words, from the Home page's Approach section (src/pages/index.astro): title and text, in order. */
  steps: { title: string; text: string }[];
  /** The heading over the steps, centred, at the cost heading's size (approach.heading). */
  heading?: string;
}

// The steps are data, so the copy (from Sanity, or the page's own words),
// the layout and the script all read the same list; each step's drawing
// and number stay here, by position.
const SCHEMATICS = ["map", "trace", "rank"] as const;
const steps = SCHEMATICS.map((schematic, i) => ({
  n: String(i + 1).padStart(2, "0"),
  title: Astro.props.steps[i]?.title ?? "",
  text: Astro.props.steps[i]?.text ?? "",
  schematic,
}));

// Understand: Hairline's "settle", brought in from the package
// (@lucasmarkes/hairline 0.5.1) with the ADDD mark on its hub, drawn
// by the script (src/scripts/understand-figure.js). The page gives the
// panel's lattice its ground: settle's camera (Cam(45, 0.5, 1.9), fitted
// to its tiles) puts the ground's origin, the hub's middle, at this point
// of its 400 × 320 frame, one ground unit 1.5021 frame units long either
// way, at the 2:1 view's 26.565°; a cell of 25 units runs the lattice
// through the hub and the tiles nearest it. Worked out from settle's
// camera; change them with it.
const U_GROUND = "200.67 163.98";
const U_ANGLE = 26.565;
const U_MODULE = 37.55;

// Diagnose and Prioritise: Hairline figures too (src/scripts/
// approach-figures.js), on the site's own 30° isometric, one world unit a
// frame unit, so their lattice keeps the 54-unit cell (dot-field.js), and
// the figures are drawn on it: Diagnose's slabs two cells square on its
// lines, Prioritise's towers one to a cell with its lines for streets.
// Each ground is a point of the 400 × 320 frame the lattice runs through:
// Diagnose's origin, and the corner of Prioritise's middle cell (its
// origin, 200 196, moved half a cell, 27, along both axes). Change them
// with the figures' cameras and cells.
const FIGURES = {
  trace: { name: "strata", ground: "200 216" },
  rank: { name: "massing", ground: "200 223" },
};

// Each step's parallax, [start, end] in percent of its card's height: the
// middle step (Diagnose) the still anchor, the outer two drifting at
// different rates, so the zig-zag keeps its order. Each drift is even
// about its rest, which it passes through as the card stands at the
// middle of the screen: there the card is set on the band's field of
// dots, as the still one always is (approach-stack.js, placeCards).
const PARALLAX: [number, number][] = [[7, -7], [0, 0], [9.5, -9.5]];
---
<section class="approach-stack" aria-label="The ADDD approach" data-approach-stack>
  <!-- the band's grid of dots (approach-stack.css), set out from the
       cards and the rail on the 12-Column Grid, and the odd one lighting
       red (approach-stack.js, dot-field.js) -->
  <div class="approach-stack__field" data-approach-stack-field aria-hidden="true">
    <span class="approach-stack__field-dots dot-grid band-field" data-approach-stack-field-dots></span>
  </div>
  {Astro.props.heading && <h2 class="approach-stack__head" data-page-field="approach.heading">{Astro.props.heading}</h2>}
  <div class="approach-stack__grid">
    <div class="approach-stack__rail" aria-hidden="true" data-approach-stack-rail>
      <div class="approach-stack__window" data-approach-stack-window>
        <span class="approach-stack__dots" data-approach-stack-dots></span>
        <span class="approach-stack__trail is--top" data-approach-stack-trail="top"></span>
        <span class="approach-stack__cube"><ArrowIcon aria-hidden="true" class="approach-stack__mark" data-approach-stack-mark /></span>
        <span class="approach-stack__trail is--bottom" data-approach-stack-trail="bottom"></span>
      </div>
    </div>

    <ol class="approach-stack__list" role="list" style={`--steps:${steps.length}`}>
      {steps.map((step, i) => (
        <li class={`approach-stack__slot ${i % 2 ? "is--right" : "is--left"}`} style={`--step:${i + 1}`} data-approach-stack-slot
          data-parallax="trigger" data-parallax-disable="tablet" data-parallax-scrub="1.2"
          data-parallax-start={PARALLAX[i][0]} data-parallax-end={PARALLAX[i][1]}>
          <!-- the card's wrapper takes the parallax (initGlobalParallax,
               site.js), so the card's own entrance stays its own -->
          <div class="approach-stack__drift" data-parallax="target">
          <article class="step-card" data-step-card>
            <header class="step-card__head">
              <span class="step-card__badge">{step.n}</span>
              <h3 class="step-card__title" data-page-field={`approach.steps.${i}.title`}>{step.title}</h3>
            </header>

            <div class="step-card__panel">
              <div class="step-card__media">
                <!-- the drawing's ground: a dotted axonometric lattice
                     (dot-field.js), the panel's alone, not the band's -->
                {step.schematic === "map" ? (
                  <Fragment>
                    <!-- the lattice on the figure's own ground: its 2:1 angle,
                         a cell every 25 of its units (through the hub and
                         the tiles nearest it), from its origin -->
                    <div class="step-card__pattern" data-iso-field data-iso-ground="[data-understand-figure] > svg"
                      data-iso-angle={U_ANGLE} data-iso-module={U_MODULE} aria-hidden="true"></div>
                    <!-- settle (understand-figure.js) draws into this svg,
                         its frame 400 × 320, of which the card shows the
                         middle 400 × 256 -->
                    <div class="step-card__figure">
                      <div class="step-card__stage" data-understand-figure data-hairline="settle" aria-hidden="true">
                        <svg viewBox="0 0 400 320" data-ground={U_GROUND} fill="none" focusable="false"></svg>
                      </div>
                    </div>
                  </Fragment>
                ) : (
                  <Fragment>
                    <!-- the lattice at the site's 30° and 54-unit cell, from
                         the figure's origin -->
                    <div class="step-card__pattern" data-iso-field data-iso-ground="[data-approach-figure] > svg" aria-hidden="true"></div>
                    <!-- the Hairline figure (approach-figures.js) draws into
                         this svg, as Understand's does -->
                    <div class="step-card__figure">
                      <div class="step-card__stage" data-approach-figure={FIGURES[step.schematic].name} data-hairline={FIGURES[step.schematic].name} aria-hidden="true">
                        <svg viewBox="0 0 400 320" data-ground={FIGURES[step.schematic].ground} fill="none" focusable="false"></svg>
                      </div>
                    </div>
                  </Fragment>
                )}
              </div>
            </div>

            <div class="step-card__foot">
              <p class="step-card__p" data-page-field={`approach.steps.${i}.text`}>{step.text}</p>
            </div>
          </article>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
