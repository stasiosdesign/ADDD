---
/*
  "Book a Call", floating: the site's CTA (ActionButton.astro) with the
  small portrait of Allister set in its frame, as Book a Free Call has it
  (BookCall.astro), held at the foot of the screen on the four service
  pages, on the nav's right edge (the grid's margin) and as far up from
  the foot as it stands in from the side.

  It opens the page's own free-call calendar, the one Book a Free Call
  opens (BookCall.astro renders it; booking.js): put both on a page.

  Hidden as the page opens; it comes up once the hero has all but gone
  off the top of the screen, stays while the page is read, and goes again
  before Book a Free Call (or, without one, the closing CTA) comes into
  view, so it never stands beside either. Over a dark section it turns
  over to white, as the nav does (book-float.js; grounds.js). Styles:
  styles.css ("Book a Call, floating").

  A direct child of the page's <main>, after its sections: nothing round
  it may be transformed, or it would be held to that instead of the
  screen.
*/
import ActionButton from "./ActionButton.astro";

interface Props {
  /** the calendar it opens: BookCall.astro's id on the page */
  opens?: string;
  label?: string;
}
const { opens = "book-call", label = "Book a Call" } = Astro.props;
---
<div class="book-float" data-book-float>
  <ActionButton type="button" photo={{ src: "/assets/images/allister-headshot-bw-crop.webp", position: "50% 22%" }} data-booking-open={opens} aria-haspopup="dialog" aria-controls={opens}>{label}</ActionButton>
</div>
