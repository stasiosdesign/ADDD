---
/*
  The free call's booking calendar (BookingDialog.astro, booking.js): a
  short call with Allister, any weekday, a morning or an afternoon. Opened
  by any button marked data-booking-open with its id: the service pages'
  Book a Free Call (BookCall.astro) and their floating Book a Call, and
  the button on the Contact page's pass. One per page. A preview until a
  real calendar is connected: nothing is sent anywhere.

  Its words and times come from the Home page document's Booking section
  in Sanity (2026-11-16), shared by every page that offers the call,
  falling back to src/sanity/defaults/home.ts; which weekdays can be
  picked stays here.
*/
import BookingDialog from "./BookingDialog.astro";
import { reader, siteDocument } from "../sanity/content";
import { homePage as HOME } from "../sanity/defaults/home";

interface Props {
  /** the dialog's id: one per page */
  id?: string;
}
const { id = "book-call" } = Astro.props;
const { t, items } = reader(await siteDocument(Astro.locals), HOME);
---
<BookingDialog
  id={id}
  link={t("booking.link")}
  label={t("booking.label")}
  title={t("booking.title")}
  note={t("booking.note")}
  slots={items("booking.slots").map((slot) => ({ name: slot.t("name"), time: slot.t("time") }))}
  days={[1, 2, 3, 4, 5]}
  summary={t("booking.summary")}
  button={t("booking.button")}
  done={t("booking.done")}
  field="booking"
/>
