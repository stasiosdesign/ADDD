---
/*
  The inside of a text link (src/styles/nav-link.css, text-scramble.js):
  the label in a box of its own, which holds the dotted underline the
  hover draws under it. The link around it — an <a>, or a dropdown toggle
  in the bar, carrying .nav-link — keeps its own size and hit area, and an
  icon beside the label stays outside the box. class goes on the label,
  and any other attribute too (a data-page-field, so the Studio's Visual
  editor can write into the label itself).
*/
interface Props {
  class?: string;
  [attr: string]: unknown;
}

const { class: className, ...attrs } = Astro.props;
const label = await Astro.slots.render("default");
---
<span class="nav-link__box"><span class:list={["nav-link__text", className]} {...attrs} set:html={label} /></span>
