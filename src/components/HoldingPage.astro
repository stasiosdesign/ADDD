---
/*
  What a page shows while it waits to be published (src/holding.ts): on
  black under the nav, centred in the screen, Hairline's tray of cards
  (holding-figure.js) over two lines, the first in the display face, the
  second smaller and quieter (styles: pages.css, "Holding page").
*/
---
<main class="holding">
  <div class="holding__inner">
    <div class="holding__figure" data-holding-figure></div>
    <h1 class="holding__h">Deployment pending</h1>
    <p class="holding__p">This page is awaiting its next preview deployment.</p>
  </div>
</main>
