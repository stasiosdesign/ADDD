---
/*
  The shell every page shares. Its shape is what Barba needs:

    body[data-barba="wrapper"]
      .morph-loader          — first-load logo intro, outside the container
      .transition            — the wipe panel, outside the container
      nav.mega-nav           — persistent, outside the container
      .column-grid           — the 12-Column Grid overlay (Shift + G)
      div[data-barba="container"][data-page-name]
        main                 — the page body (the slot)
        footer               — swapped with the page so it animates with it

  The nav sits outside the container so it survives navigation: its GSAP
  timelines and the Contact button's width measurement are wired up once per
  document rather than per page. Anything inside the container is replaced on
  every navigation, so page-level behaviour is bound in initPage() in
  src/scripts/site.js.

  Barba swaps only the container, never <head>, so every page must load the
  same stylesheets and scripts. They are all declared here, once, and no page
  or component carries a <style> or <script> of its own. For the same reason
  the inline script in <head> runs on document loads only — never on a Barba
  navigation — which is exactly what it is for.
*/
import MorphLoader from "../components/MorphLoader.astro";
import Transition from "../components/Transition.astro";
import Nav from "../components/Nav.astro";
import ColumnGrid from "../components/ColumnGrid.astro";
import Footer from "../components/Footer.astro";
import DraftModeLabel from "../components/DraftModeLabel.astro";
import { BUILD_STAMP } from "../build-stamp.js";

// Site stylesheets, bundled into one file in this order — the cascade order
// the pages have always loaded them in, after the scaling system that sets
// the size every other sheet is measured in.
import "../styles/scaling.css";
import "../styles/lenis.css";
import "../styles/styles.css";
import "../styles/pages.css";
import "../styles/nav.css";
import "../styles/nav-link.css";
import "../styles/media.css";
import "../styles/contact-button.css";
import "../styles/action-button.css";
import "../styles/accordion.css";
import "../styles/transition.css";
import "../styles/morph-loader.css";
import "../styles/column-grid.css";
import "../styles/page-grid.css";
import "../styles/approach-stack.css";
import "../styles/sticky-title.css";

interface Props {
  /** The document <title>. */
  title: string;
  /** The search-result summary, taken from the page's own opening copy. */
  description: string;
  /** The page's display name, carried on the Barba container. */
  pageName: string;
  /** The homepage: the one page the logo intro opens, since it plays out in
      the hero's own field (see ARRIVAL in src/scripts/site.js). */
  home?: boolean;
  /** The Sanity document the page shows (src/sanity/content.ts): its ID and,
      for a collection item, its type. Named on the Barba container for the
      Studio's Visual editor (src/sanity/live-preview.ts). */
  doc?: { id: string; type?: string };
}

const { title, description, pageName, home = false, doc } = Astro.props;
const docAttrs = doc ? { "data-page-doc": doc.id, "data-page-type": doc.type ?? doc.id } : {};
// Staging and development render on request and are never indexed; a page in
// draft mode says so to the person looking at it (DraftModeLabel)
const staging = __DEPLOYMENT__ !== "production";
const draftMode = staging && Astro.locals.draftMode;
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="build" content={BUILD_STAMP}>
{staging && <meta name="robots" content="noindex, nofollow">}
{/* How this document load arrives — the logo intro or the wipe's reveal —
    decided before the first paint, so a loader that is not going to play is
    never shown. The intro is the homepage's: it opens the session's first
    visit to it, every visit made by the nav's logo, and every reload of the
    homepage, which starts again from the top. Every other load reveals, a
    reload of any other page included, which keeps its place. Ahead of the
    stylesheets, which an inline script would otherwise wait on. See ARRIVAL
    in src/scripts/site.js. */}
<script is:inline define:vars={{ home }}>
  (function () {
    var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
    var reload = nav ? nav.type === "reload" : (performance.navigation || {}).type === 1;
    var seen = false;
    var requested = false;
    try {
      // "played" after the session's first load; "requested" when the nav's
      // logo was clicked to come here (initHomeLink in site.js).
      var intro = sessionStorage.getItem("addd:intro");
      seen = !!intro;
      requested = intro === "requested";
      sessionStorage.setItem("addd:intro", "played");
    } catch (err) {}
    // Arriving from one of the site's own pages is a move within the site,
    // even when sessionStorage holds no record of the intro: a link opened
    // in a new tab can start without it, and storage can be blocked outright.
    try {
      seen = seen || new URL(document.referrer).origin === location.origin;
    } catch (err) {}
    document.documentElement.dataset.arrival = home && (requested || reload || !seen) ? "intro" : "reveal";
  })();
</script>
<noscript><style>.morph-loader { display: none; }</style></noscript>
<link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
<link rel="preconnect" href="https://use.typekit.net" crossorigin>
<link rel="stylesheet" href="https://use.typekit.net/lzu8hkz.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&display=swap">
</head>
<body data-barba="wrapper">
<MorphLoader />
<Transition />
<Nav />
<ColumnGrid />
<div data-barba="container" data-page-name={pageName} {...docAttrs}>
<slot />
<Footer />
</div>
{draftMode && <DraftModeLabel />}
<script is:inline src="https://cdn.jsdelivr.net/npm/@barba/core@2.10.3/dist/barba.umd.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/CustomEase.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/SplitText.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrambleTextPlugin.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/Draggable.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/InertiaPlugin.min.js"></script>
{/* Bundled as a module, so it runs once the document has parsed — after the
    classic CDN scripts above have defined barba, Lenis and gsap. */}
<script src="../scripts/site.js"></script>
{/* Staging and development only: inside the Studio's Visual editor, the
    click-to-edit layer and live drafts (src/sanity/live-preview.ts), loaded
    on demand so visitors never download it. Production builds leave it out. */}
{staging && (
<script>
  if (window.self !== window.top) import("../sanity/live-preview");
</script>
)}
</body>
</html>
