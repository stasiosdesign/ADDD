---
/*
  TEMPORARY (2026-11-16): one diagram of the Backend and integrations page at
  /backend (see platforms.ts, sections.ts). Its plane (w by h) is
  scaled to the column as one piece (presentation.css: every size in the
  plane's units), and its edges are drawn in an SVG of the same plane, each
  from the edge of one box to the edge of the next with a small gap, worked
  out here from the boxes' sizes, so nothing is measured in the browser.
*/
import { PLATFORMS } from "./platforms";
import type { Diagram, DiagramNode } from "./sections";

interface Props {
  /** unique on the page (the arrowhead's id) */
  id: string;
  diagram: Diagram;
}
const { id, diagram } = Astro.props;
const { w: W, h: H, nodes, edges } = diagram;
const GAP = 10;
const arrow = `${id}-arrow`;
const byId = new Map(nodes.map((n) => [n.id, n]));

/* Every line runs straight across or straight down, never at a slant (at
   the user's word, 2026-11-17): straight where the two boxes share a
   column or a row, else one right-angle turn. Of the two ways to turn
   (across first, then down into the box; or down first, then across into
   it), the first that crosses no other box. A line's label sits on its
   longest stretch: above it when that runs across, beside it when down. */
type Pt = { x: number; y: number };
const left = (n: DiagramNode) => n.x - n.w / 2;
const right = (n: DiagramNode) => n.x + n.w / 2;
const top = (n: DiagramNode) => n.y - n.h / 2;
const bottom = (n: DiagramNode) => n.y + n.h / 2;

// does the straight stretch p–q cross box n (a little room round it)?
function crosses(p: Pt, q: Pt, n: DiagramNode) {
  const pad = 4;
  const x1 = Math.min(p.x, q.x), x2 = Math.max(p.x, q.x), y1 = Math.min(p.y, q.y), y2 = Math.max(p.y, q.y);
  return x2 > left(n) - pad && x1 < right(n) + pad && y2 > top(n) - pad && y1 < bottom(n) + pad;
}

function route(a: DiagramNode, b: DiagramNode): Pt[] {
  // sharing a column (a good part of the narrower box's width, so a line
  // never drops down a box's very edge): straight down (or up), in the
  // middle of what they share
  const colL = Math.max(left(a), left(b)), colR = Math.min(right(a), right(b));
  if (colR - colL > Math.min(a.w, b.w) * 0.4) {
    const x = a.x >= colL && a.x <= colR ? a.x : b.x >= colL && b.x <= colR ? b.x : (colL + colR) / 2;
    const down = b.y > a.y;
    return [{ x, y: down ? bottom(a) + GAP : top(a) - GAP }, { x, y: down ? top(b) - GAP : bottom(b) + GAP }];
  }
  // sharing a row: straight across
  const rowT = Math.max(top(a), top(b)), rowB = Math.min(bottom(a), bottom(b));
  if (rowB - rowT > Math.min(a.h, b.h) * 0.4) {
    const y = a.y >= rowT && a.y <= rowB ? a.y : b.y >= rowT && b.y <= rowB ? b.y : (rowT + rowB) / 2;
    const fwd = b.x > a.x;
    return [{ x: fwd ? right(a) + GAP : left(a) - GAP, y }, { x: fwd ? left(b) - GAP : right(b) + GAP, y }];
  }
  const toRight = b.x > a.x, below = b.y > a.y;
  // across first, from a's side, then down (or up) into b
  const across: Pt[] = [
    { x: toRight ? right(a) + GAP : left(a) - GAP, y: a.y },
    { x: b.x, y: a.y },
    { x: b.x, y: below ? top(b) - GAP : bottom(b) + GAP },
  ];
  // down (or up) first, from a's top or foot, then across into b
  const downFirst: Pt[] = [
    { x: a.x, y: below ? bottom(a) + GAP : top(a) - GAP },
    { x: a.x, y: b.y },
    { x: toRight ? left(b) - GAP : right(b) + GAP, y: b.y },
  ];
  const others = nodes.filter((n) => n !== a && n !== b && n.kind !== "frame" && n.kind !== "label");
  const clear = (pts: Pt[]) => !others.some((n) => pts.slice(1).some((q, k) => crosses(pts[k], q, n)));
  return clear(across) || !clear(downFirst) ? across : downFirst;
}

const lines = edges.flatMap((e) => {
  const a = byId.get(e.from);
  const b = byId.get(e.to);
  if (!a || !b) return [];
  const pts = route(a, b);
  // the label's stretch: the longest
  let k = 0, best = -1;
  pts.slice(1).forEach((q, i) => {
    const len = Math.abs(q.x - pts[i].x) + Math.abs(q.y - pts[i].y);
    if (len > best) { best = len; k = i; }
  });
  const p = pts[k], q = pts[k + 1];
  return [{ ...e, points: pts.map((pt) => `${pt.x},${pt.y}`).join(" "), mx: (p.x + q.x) / 2, my: (p.y + q.y) / 2, down: p.x === q.x }];
});

const pct = (v: number, of: number) => `${+((v / of) * 100).toFixed(4)}%`;
const place = (n: DiagramNode) => `left:${pct(n.x - n.w / 2, W)};top:${pct(n.y - n.h / 2, H)};width:${pct(n.w, W)};height:${pct(n.h, H)}`;
---
<div class="dg" style={`--w:${W};aspect-ratio:${W} / ${H}`}>
  <div class="dg__plane">
    <svg class="dg__lines" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <defs>
        <marker id={arrow} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
          <path d="M1.5 1.5 8.5 5 1.5 8.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </marker>
      </defs>
      {lines.map((l) => (
        <polyline points={l.points} class:list={["dg__edge", { "is--dashed": l.dashed }]} stroke-linejoin="round" marker-end={l.plain ? undefined : `url(#${arrow})`} marker-start={l.both ? `url(#${arrow})` : undefined} />
      ))}
    </svg>

    {nodes.map((n) => {
      const kind = n.kind ?? "card";
      const p = n.platform ? PLATFORMS[n.platform] : null;
      const name = n.title ?? p?.name ?? "";
      const text = n.text ?? (n.title ? undefined : p?.role);
      return (
        <div class:list={["dg__node", `is--${kind}`, { "is--muted": n.muted, "has--logo": p?.logo }]} style={place(n)}>
          {kind === "card" && p?.logo && (
            <span class="dg__logo" data-initial={p.name.charAt(0)}>
              <img src={p.logo} alt="" decoding="async" onerror="this.parentElement.classList.add('is--fallback');this.remove()" />
            </span>
          )}
          {kind === "step" && n.n !== undefined && <span class="dg__n">{n.n}</span>}
          <span class="dg__body">
            <span class="dg__name">{name}</span>
            {text && <span class="dg__text">{text}</span>}
          </span>
        </div>
      );
    })}

    {lines.filter((l) => l.label).map((l) => (
      <span class:list={["dg__edge-label", { "is--down": l.down }]} style={`left:${pct(l.mx, W)};top:${pct(l.my, H)}`}>{l.label}</span>
    ))}
  </div>
</div>
