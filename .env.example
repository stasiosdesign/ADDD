# The website's environment variables. Never commit real values.
#
# On your machine: copy what you need into .env.development.local (git-ignored),
#   which `npm run dev` reads.
# On Vercel: Project → Settings → Environment Variables, scoped as noted below.
#
# Which deployment a build is for comes from Vercel itself (VERCEL_ENV), not
# from a variable here: see astro.config.mjs.

# A Sanity API token with the Viewer role, for draft mode (drafts on staging).
# SECRET: server-side only, never give it a PUBLIC_ prefix.
# Vercel: Preview, Git branch `staging` only; never Production.
# Locally: lets `npm run dev` show drafts in the local Studio's Visual editor.
SANITY_API_READ_TOKEN=

# A Sanity API token with the Editor role, for /api/publish (Publish Live in
# the Studio writes to the production dataset through it). SECRET: server-side
# only. Vercel: Preview, Git branch `staging` only; never Production.
SANITY_API_WRITE_TOKEN=

# The Vercel deploy hook for the `main` branch (Project → Settings → Git →
# Deploy Hooks). /api/publish calls it after every live publish, unpublish or
# delete, so the static production site is rebuilt with the new content.
# SECRET. Vercel: Preview, Git branch `staging` only.
VERCEL_DEPLOY_HOOK_URL=

# Optional, public: build against another Sanity project or dataset. The
# dataset otherwise follows the deployment: production, or staging.
# PUBLIC_SANITY_PROJECT_ID=xqa8b0u9
# PUBLIC_SANITY_DATASET=production
