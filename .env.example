# The website's environment variables. Never commit real values.
#
# On your machine: copy what you need into .env.development.local (git-ignored),
#   which `npm run dev` reads.
# On Vercel: Project → Settings → Environment Variables, scoped as noted below.
#
# Which deployment a build is for comes from Vercel itself (VERCEL_ENV), not
# from a variable here: see astro.config.mjs.

# A Sanity API token with the Viewer role, for draft mode (drafts on staging).
# SECRET: server-side only, never give it a PUBLIC_ prefix.
# Vercel: Preview, Git branch `staging` only; never Production.
# Locally: lets `npm run dev` show drafts in the local Studio's Visual editor.
SANITY_API_READ_TOKEN=

# A Sanity API token with the Editor role, for /sanity/publish (Publish Live in
# the Studio writes to the production dataset through it). SECRET: server-side
# only. Vercel: Preview, Git branch `staging` only; never Production.
SANITY_API_WRITE_TOKEN=

# The Vercel deploy hook for the `main` branch (Project → Settings → Git →
# Deploy Hooks). /sanity/publish calls it after every live publish, unpublish or
# delete, so the static production site is rebuilt with the new content.
# SECRET. Vercel: Preview, Git branch `staging` only.
VERCEL_DEPLOY_HOOK_URL=

# The newsletter, from beehiiv (src/newsletter/beehiiv.ts; README "Newsletter").
# The pages read either the API (paid beehiiv plans: full control) or the RSS
# feed (every plan); with neither set they keep the template's issues.
# SECRET (the key; the rest kept with it). Vercel: Production and Preview.
# The API key: beehiiv → Settings → API → Create new key.
BEEHIIV_API_KEY=
# The publication's V2 id (pub_…): beehiiv → Settings → API.
BEEHIIV_PUBLICATION_ID=
# Or, without the API: the publication's RSS feed address (beehiiv →
# Settings → RSS Feed, enabled), e.g. https://rss.beehiiv.com/feeds/….xml
BEEHIIV_RSS_URL=

# beehiiv's webhook signing secret (whsec_…), shown when the webhook to
# https://<the live site>/api/beehiiv is created (beehiiv → Settings →
# Webhooks). api/beehiiv.js checks every call with it. SECRET.
# Vercel: Production only.
BEEHIIV_WEBHOOK_SECRET=

# Any long random string: Vercel sends it with its daily cron's call to
# /api/beehiiv (vercel.ts), which refuses a call without it. SECRET.
# Vercel: Production only.
CRON_SECRET=

# (VERCEL_DEPLOY_HOOK_URL, above, is also needed in Production for the
# newsletter: api/beehiiv.js starts the rebuild through it.)

# Optional, public: build against another Sanity project or dataset. The
# dataset otherwise follows the deployment: production, or staging.
# PUBLIC_SANITY_PROJECT_ID=xqa8b0u9
# PUBLIC_SANITY_DATASET=production
